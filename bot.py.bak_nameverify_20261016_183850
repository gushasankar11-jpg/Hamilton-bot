@bot.callback_query_handler(func=lambda c: c.data == "sub_new")
def _cb_sub_new(call):
    uid = call.message.chat.id
    try:
        bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except Exception:
        pass
    _set_pending(uid, "sub_verify_code")
    safe_send(uid,
        "🔑 *New Sub-Admin Setup*\n\n"
        "Please enter the *verification code* provided by the primary admin.",
        parse_mode="Markdown")


@bot.callback_query_handler(func=lambda c: c.data == "sub_reg")
def _cb_sub_reg(call):
    uid = call.message.chat.id
    try:
        bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except Exception:
        pass

    if not auth.is_sub_admin_registered(uid):
        safe_send(uid,
            "❌ This device is *not registered*.\n\n"
            "Please tap *New Device* on the previous step.",
            parse_mode="Markdown")
        return

    _set_pending(uid, "sub_priv")
    safe_send(uid, "Please enter your *privacy code*.", parse_mode="Markdown")


