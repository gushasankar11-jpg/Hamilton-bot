# Entry points
# ----------------------------------------------------------
@bot.message_handler(func=lambda m: m.text and
                     m.text.strip() == config.ADMIN_PANEL_CODE)
def _entry_primary(message):
    uid = message.chat.id
    auth.note_device(uid, "primary")
    session = auth.get_session(uid)

    if session and session["role"] == "primary":
        # already logged in — refresh
        _open_primary_panel(uid)
        return

    locked, mins = auth.is_locked(uid, "primary")
    if locked:
        safe_send(uid, f"🔒 Too many failed attempts. Try again in *{mins} minutes*.",
                  parse_mode="Markdown")
        return

    _set_pending(uid, "primary_priv")
    safe_send(uid,
        f"👑 *Welcome Admin — {config.ADMIN_NAME}*\n\n"
        "Please enter your *privacy code* to open the admin panel.\n\n"
        "_Forgot your code? Type_ `/forgot`",
        parse_mode="Markdown")


@bot.message_handler(func=lambda m: m.text and
                     m.text.strip() == config.SUB_ADMIN_CODE)
def _entry_sub(message):
    uid = message.chat.id
    auth.note_device(uid, "sub")

    session = auth.get_session(uid)
    if session and session["role"] == "sub":
        _open_sub_panel(uid)
        return

    locked, mins = auth.is_locked(uid, "sub")
    if locked:
        safe_send(uid, f"🔒 Too many failed attempts. Try again in *{mins} minutes*.",
                  parse_mode="Markdown")
        return

    if auth.is_sub_admin_registered(uid):
        _set_pending(uid, "sub_priv")
        safe_send(uid,
            "🛡️ *Welcome back, Sub-Admin*\n\n"
            "Please enter your *privacy code*.",
            parse_mode="Markdown")
    else:
        kb = InlineKeyboardMarkup(row_width=2)
        kb.add(
            InlineKeyboardButton("🆕 New Device", callback_data="sub_new"),
            InlineKeyboardButton("✅ Already Registered", callback_data="sub_reg"),
        )
        bot.send_message(uid,
            "🛡️ *Sub-Admin Entry*\n\n"
            "Have you registered on this device before?",
            reply_markup=kb, parse_mode="Markdown")


