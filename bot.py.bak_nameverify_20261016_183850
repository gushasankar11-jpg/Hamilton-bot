# Better page estimate — no upper cap, based on concept density
def _estimate_pages(subtopics_count, concepts_count):
    if concepts_count <= 0:
        return 1
    # ~8 concepts per page for exhaustive notes
    pages = max(3, (concepts_count + 7) // 8)
    return pages


