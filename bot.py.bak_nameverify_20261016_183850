def _looks_like_rich(text):
    if not text:
        return False
    indicators = ["$$", "$", "**", "##", "# ", "\\(", "\\[",
                  "\\frac", "\\tau", "\\int", "\\sum", "\\alpha", "\\beta",
                  "\\vec", "\\sqrt", "\\begin{", "\\end{", "\\sin", "\\cos",
                  "\\theta", "\\mathbf", "\\boldsymbol", "\\times",
                  "\\det", "\\lim", "\\log", "\\pm", "\\infty"]
    return any(ind in text for ind in indicators)


