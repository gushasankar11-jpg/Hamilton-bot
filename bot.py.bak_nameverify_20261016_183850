                    arrowprops=dict(arrowstyle="<->", color="#dc3545", lw=2))
        ax.text(9.2, 4.3, "Δo", color="#dc3545", fontsize=12)
    elif kind == "tetrahedral":
        ax.text(1.5, 8.5, "Free ion", color="white", fontsize=11)
