def load_profile(uid):
    path = os.path.join(PROFILE_DIR, f"{uid}.json")
    if not os.path.exists(path):
        return None
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


def save_profile(uid, profile):
    path = os.path.join(PROFILE_DIR, f"{uid}.json")
    with open(path, "w") as f:
        json.dump(profile, f, indent=2, ensure_ascii=False)


