    bot.answer_callback_query(call.id, "Exam Selected")

@bot.callback_query_handler(func=lambda c: c.data.startswith("c99_sub:"))
def cb_c99_sub(call):
    uid = call.from_user.id
    subj = call.data.split(":")[1]
    _state[uid]["subj"] = subj
    exam = _state[uid].get("exam", "JEE_ADV").lower()
    
    fn = f"data/{exam}_{subj.lower()}.json"
    try:
        with open(fn) as f: chapters = list(json.load(f).keys())
    except: chapters = ["Motion in a Straight Line"]
        
    _state[uid]["chapters"] = chapters
    _state[uid]["page"] = 0
    _show_chapters(uid, call.message.message_id)
    bot.answer_callback_query(call.id, "Subject Selected")

def _show_chapters(uid, msg_id):
    chapters = _state[uid]["chapters"]
    page = _state[uid]["page"]
    per_page = 5
    start, end = page * per_page, (page + 1) * per_page
    
    kb = InlineKeyboardMarkup(row_width=1)
    for ch in chapters[start:end]:
        mark = "✅ " if _state[uid].get("chapter") == ch else ""
        kb.add(InlineKeyboardButton(f"{mark}{ch[:25]}", callback_data=f"c99_ch:{ch}"))
        
    nav = []
    if page > 0: nav.append(InlineKeyboardButton("⬅️ Prev", callback_data="c99_page:-1"))
    if end < len(chapters): nav.append(InlineKeyboardButton("Next ➡️", callback_data="c99_page:1"))
    if nav: kb.row(*nav)
    kb.row(InlineKeyboardButton("▶️ Continue", callback_data="c99_cont"))
    
    try: bot.edit_message_text("📚 Select Chapter:", chat_id=uid, message_id=msg_id, reply_markup=kb)
    except: pass

@bot.callback_query_handler(func=lambda c: c.data.startswith("c99_page:"))
def cb_c99_page(call):
    uid = call.from_user.id
    _state[uid]["page"] += int(call.data.split(":")[1])
    _show_chapters(uid, call.message.message_id)
    bot.answer_callback_query(call.id, "Page Changed")

@bot.callback_query_handler(func=lambda c: c.data.startswith("c99_ch:"))
def cb_c99_ch(call):
    uid = call.from_user.id
    _state[uid]["chapter"] = call.data.split(":", 1)[1]
    _show_chapters(uid, call.message.message_id)
    bot.answer_callback_query(call.id, "Chapter Selected")

@bot.callback_query_handler(func=lambda c: c.data == "c99_cont")
def cb_c99_cont(call):
    uid = call.from_user.id
    if not _state[uid].get("chapter"):
        bot.answer_callback_query(call.id, "Select a chapter first!")
        return
        
    kb = InlineKeyboardMarkup(row_width=3)
    kb.add(
        InlineKeyboardButton("L1 (Easy)", callback_data="c99_lvl:easy"),
        InlineKeyboardButton("L2 (Medium)", callback_data="c99_lvl:medium"),
        InlineKeyboardButton("L3 (Hard)", callback_data="c99_lvl:hard")
    )
    try: bot.edit_message_text("🎯 Select Difficulty:", chat_id=uid, message_id=call.message.message_id, reply_markup=kb)
    except: pass
    bot.answer_callback_query(call.id, "Next: Level")

@bot.callback_query_handler(func=lambda c: c.data.startswith("c99_lvl:"))
def cb_c99_lvl(call):
    uid = call.from_user.id
    lvl = call.data.split(":")[1]
    try: bot.edit_message_text("⏳ Generating question from AI...", chat_id=uid, message_id=call.message.message_id)
    except: pass
    bot.answer_callback_query(call.id, "Generating...")
    
    import exam_engine
    import ai_client
    state = _state[uid]
    
    try:
        with open(f"data/{state['exam'].lower()}_{state['subj'].lower()}.json") as f:
            sub = list(json.load(f)[state['chapter']].keys())[0]
            
        q = exam_engine.generate_question(state['exam'], state['subj'], state['chapter'], sub, q_type="mcq", difficulty=lvl)
        if not q:
            bot.send_message(uid, "❌ AI failed to generate.")
            return
            
        state["q"] = q
        state["selected"] = None
        
        qtext = str(q.get("question", ""))
        if hasattr(ai_client, 'postprocess_ai_output'): qtext = ai_client.postprocess_ai_output(qtext)
            
        body = f"<b>[{state['exam']} | {state['subj']}]</b>\n\n{qtext}\n\n<pre>"
        for i, opt in enumerate(q.get("options", [])[:4]):
            opt_c = str(opt)
            if hasattr(ai_client, 'postprocess_ai_output'): opt_c = ai_client.postprocess_ai_output(opt_c)
            body += f"{chr(65+i)}) {opt_c}\n"
        body += "</pre>"
        
        kb = _build_kb(uid, len(q.get("options", [])))
        bot.send_message(uid, body, parse_mode="HTML", reply_markup=kb)
    except Exception as e:
        bot.send_message(uid, f"❌ Error: {e}")

def _build_kb(uid, n):
    sel = _state.get(uid, {}).get("selected")
    kb = InlineKeyboardMarkup(row_width=4)
    row = [InlineKeyboardButton(f"{'✅' if i == sel else ''}{chr(65+i)}", callback_data=f"c99_ans:{i}") for i in range(min(4, n))]
    kb.row(*row)
    kb.row(InlineKeyboardButton("✔️ Save", callback_data="c99_save"), InlineKeyboardButton("⏭ Skip", callback_data="c99_skip"))
    return kb

@bot.callback_query_handler(func=lambda c: c.data.startswith("c99_ans:"))
def cb_c99_ans(call):
    uid = call.from_user.id
    _state[uid]["selected"] = int(call.data.split(":")[1])
    try: bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=_build_kb(uid, 4))
    except: pass
    bot.answer_callback_query(call.id, "Selected")

@bot.callback_query_handler(func=lambda c: c.data == "c99_save")
def cb_c99_save(call):
    uid = call.from_user.id
    state = _state.get(uid, {})
    if state.get("selected") is None:
        bot.answer_callback_query(call.id, "Select an option!")
        return
        
    import ai_client
    is_correct = state["selected"] == state["q"].get("correct_index", 0)
    bot.answer_callback_query(call.id, "✅ Correct!" if is_correct else "❌ Wrong!")
    
    msg = "✅ *Correct!*\n\n" if is_correct else "❌ *Wrong.*\n\n"
    exp = str(state["q"].get("explanation", ""))
    if exp and hasattr(ai_client, 'postprocess_ai_output'): exp = ai_client.postprocess_ai_output(exp)
    bot.send_message(uid, msg + exp, parse_mode="Markdown")
    try: bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except: pass

@bot.callback_query_handler(func=lambda c: c.data == "c99_skip")
def cb_c99_skip(call):
    bot.answer_callback_query(call.id, "Skipped")
    try: bot.edit_message_reply_markup(call.from_user.id, call.message.message_id, reply_markup=None)
    except: pass

