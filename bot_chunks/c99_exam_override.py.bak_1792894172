import json
from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton

_state = {}

# DEAD_EXAM
def cmd_exam_final(message):
    uid = message.chat.id
    _state[uid] = {}
    kb = InlineKeyboardMarkup(row_width=2)
    kb.add(
        InlineKeyboardButton("📖 Practice", callback_data="c99_mode:practice"),
        InlineKeyboardButton("📝 Test", callback_data="c99_mode:test")
    )
    kb.add(
        InlineKeyboardButton("💡 Conceptual", callback_data="c99_mode:conceptual"),
        InlineKeyboardButton("⚠️ Exceptional", callback_data="c99_mode:exceptional")
    )
    bot.send_message(uid, "🎓 *Select Mode:*", parse_mode="Markdown", reply_markup=kb)

@bot.callback_query_handler(func=lambda c: c.data.startswith("c99_mode:"))
def cb_c99_mode(call):
    uid = call.from_user.id
    _state[uid]["mode"] = call.data.split(":")[1]
    kb = InlineKeyboardMarkup(row_width=1)
    kb.add(
        InlineKeyboardButton("JEE Advanced", callback_data="c99_exam:JEE_ADV"),
        InlineKeyboardButton("JEE Mains", callback_data="c99_exam:JEE_MAIN")
    )
    try: bot.edit_message_text("Select Exam:", chat_id=uid, message_id=call.message.message_id, reply_markup=kb)
    except: pass
    bot.answer_callback_query(call.id, "Mode Selected")

@bot.callback_query_handler(func=lambda c: c.data.startswith("c99_exam:"))
def cb_c99_exam(call):
    uid = call.from_user.id
    _state[uid]["exam"] = call.data.split(":")[1]
    kb = InlineKeyboardMarkup(row_width=3)
    kb.add(
        InlineKeyboardButton("Maths", callback_data="c99_sub:Maths"),
        InlineKeyboardButton("Physics", callback_data="c99_sub:Physics"),
        InlineKeyboardButton("Chemistry", callback_data="c99_sub:Chemistry")
    )
    try: bot.edit_message_text("Select Subject:", chat_id=uid, message_id=call.message.message_id, reply_markup=kb)
