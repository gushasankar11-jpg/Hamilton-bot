def _gen_c_q(uid):
    state = _state[uid]
    import ai_client
    state["q_count"] += 1
    
    covered_str = ", ".join(state["covered"][-10:])
    prompt = f"You are an elite JEE teacher creating a CONCEPTUAL DRILL for '{state['chapter']}' (Subject: {state['subj']}).\n"
    prompt += "Your goal is to test EVERY formula, condition, and edge case. Do not stop.\n"
    prompt += "Format: Randomly choose between Assertion-Reason, Statement-1/2, Multi-correct, Matching, or Direct Formula.\n"
    prompt += "Timers: 15s for direct formulas, 45s for deep reasoning.\n"
    prompt += f"DO NOT REPEAT THESE ALREADY COVERED CONCEPTS: {covered_str}\n"
    prompt += "Output strictly as JSON: {\"question\":\"...\", \"type\":\"...\", \"options\":[\"A\",\"B\",\"C\",\"D\"], \"correct_index\":0, \"explanation\":\"...\", \"timer\":15}"
    
    raw = ai_client._call_groq(0, "Output ONLY valid JSON.", prompt, max_tokens=1000, temperature=0.7)
    
    try:
        import re
        txt = raw.strip()
        if txt.startswith("```"): txt = re.sub(r"^```(?:json)?\s*", "", txt); txt = re.sub(r"\s*```\s*$", "", txt)
        first, last = txt.find("{"), txt.rfind("}")
        q = json.loads(txt[first:last+1])
        
        state["covered"].append(f"[{q.get('type')}] {q.get('question','')[:40]}")
        state["q"] = q
        state["selected"] = None
        
        qtext = str(q.get("question", ""))
        if hasattr(ai_client, 'postprocess_ai_output'): qtext = ai_client.postprocess_ai_output(qtext)
            
        body = f"<b>[Concept {state['q_count']} | {q.get('type', 'Concept')}]</b>\n⏱️ <i>Ideal Time: {q.get('timer', 15)}s</i>\n\n{qtext}\n\n<pre>"
        for i, opt in enumerate(q.get("options", [])[:4]):
            opt_c = str(opt)
            if hasattr(ai_client, 'postprocess_ai_output'): opt_c = ai_client.postprocess_ai_output(opt_c)
            body += f"{chr(65+i)}) {opt_c}\n"
        body += "</pre>"
        
        bot.send_message(uid, body, parse_mode="HTML", reply_markup=_build_kb(uid, "c"))
        
    except Exception as e:
        bot.send_message(uid, f"❌ Generation error: {e}")

# ==========================================
# 3. SHARED BUTTON HANDLERS
# ==========================================
def _build_kb(uid, prefix):
    sel = _state.get(uid, {}).get("selected")
    kb = InlineKeyboardMarkup(row_width=4)
    row = [InlineKeyboardButton(f"{'✅' if i == sel else ''}{chr(65+i)}", callback_data=f"{prefix}_ans:{i}") for i in range(4)]
    kb.row(*row)
    kb.row(InlineKeyboardButton("✔️ Save", callback_data=f"{prefix}_save"), InlineKeyboardButton("⏭ Skip", callback_data=f"{prefix}_skip"))
    return kb

@bot.callback_query_handler(func=lambda c: c.data.startswith("x_ans:") or c.data.startswith("c_ans:"))
def cb_any_ans(call):
    uid = call.from_user.id
    prefix = call.data.split("_")[0]
    _state[uid]["selected"] = int(call.data.split(":")[1])
    try: bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=_build_kb(uid, prefix))
    except: pass
    bot.answer_callback_query(call.id, "Selected")

@bot.callback_query_handler(func=lambda c: c.data.startswith("x_save") or c.data.startswith("c_save"))
def cb_any_save(call):
    uid = call.from_user.id
    prefix = call.data.split("_")[0]
    state = _state.get(uid, {})
    
    if state.get("selected") is None:
        bot.answer_callback_query(call.id, "Select an option!")
        return
        
    import ai_client
    is_correct = state["selected"] == state["q"].get("correct_index", 0)
    bot.answer_callback_query(call.id, "✅ Correct!" if is_correct else "❌ Wrong!")
    
    msg = "✅ *Correct!*\n\n" if is_correct else "❌ *Wrong.*\n\n"
    exp = str(state["q"].get("explanation", ""))
    if exp and hasattr(ai_client, 'postprocess_ai_output'): exp = ai_client.postprocess_ai_output(exp)
    bot.send_message(uid, msg + exp, parse_mode="Markdown")
    try: bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except: pass
    
    # Auto-generate next concept
    if prefix == "c":
        _gen_c_q(uid)

@bot.callback_query_handler(func=lambda c: c.data.startswith("x_skip") or c.data.startswith("c_skip"))
def cb_any_skip(call):
    uid = call.from_user.id
    prefix = call.data.split("_")[0]
    bot.answer_callback_query(call.id, "Skipped")
    try: bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except: pass
    if prefix == "c":
        _gen_c_q(uid)

