def _show_chapters(uid, msg_id, prefix):
    chapters = _state[uid]["chapters"]
    page = _state[uid]["page"]
    start, end = page * 5, (page + 1) * 5
    
    kb = InlineKeyboardMarkup(row_width=1)
    for ch in chapters[start:end]:
        kb.add(InlineKeyboardButton(ch[:25], callback_data=f"{prefix}_ch:{ch}"))
        
    nav = []
    if page > 0: nav.append(InlineKeyboardButton("⬅️ Prev", callback_data=f"{prefix}_page:-1"))
    if end < len(chapters): nav.append(InlineKeyboardButton("Next ➡️", callback_data=f"{prefix}_page:1"))
    if nav: kb.row(*nav)
    
    try: bot.edit_message_text("📚 Select Chapter:", chat_id=uid, message_id=msg_id, reply_markup=kb)
    except: pass

@bot.callback_query_handler(func=lambda c: c.data.startswith("x_page:"))
def cb_x_page(call):
    uid = call.from_user.id
    _state[uid]["page"] += int(call.data.split(":")[1])
    _show_chapters(uid, call.message.message_id, "x")
    bot.answer_callback_query(call.id)

