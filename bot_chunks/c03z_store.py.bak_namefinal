def generate_qr(uid, total):
    import urllib.parse, requests, qrcode
    from io import BytesIO
    
    order_id = "ORD-" + "".join(random.choices(string.ascii_uppercase + string.digits, k=6))
    upi_str = f"upi://pay?pa={UPI_ID}&pn=HK_Publications&am={total:.2f}&cu=INR&tn={order_id}"
    
    STORE_STATE[uid]["order_id"] = order_id
    STORE_STATE[uid]["total_amount"] = total
    # WE DO NOT SET THE EXPIRY TIMER HERE ANYMORE! We set it only AFTER success.
    
    exp_time = (datetime.datetime.now() + datetime.timedelta(minutes=5)).strftime("%I:%M %p")
    caption = f"🏷 <b>Order ID: {order_id}</b>\n💰 <b>Amount: ₹{total:.2f}</b>\n\nScan this QR with GPay/PhonePe to pay.\n⏳ <i>Valid till {exp_time}. Auto-renews if expired.</i>\n\nOnce paid, click below."
    
    kb = InlineKeyboardMarkup()
    kb.add(InlineKeyboardButton("✅ I Have Paid", callback_data="verify_manual"))
    kb.add(InlineKeyboardButton("❌ Cancel", callback_data="cancel_order"))
    
    bio = None
    # Method 1: Local generation
    try:
        qr = qrcode.make(upi_str)
        bio = BytesIO()
        qr.save(bio, "PNG")
        bio.seek(0)
    except Exception:
        # Method 2: External API 1
        try:
            encoded = urllib.parse.quote(upi_str)
            resp = requests.get(f"https://api.qrserver.com/v1/create-qr-code/?size=500x500&data={encoded}", timeout=10)
            if resp.status_code == 200:
                bio = BytesIO(resp.content)
                bio.name = 'qr.png'
        except: pass
        
        # Method 3: External API 2
        if not bio:
            try:
                encoded = urllib.parse.quote(upi_str)
                resp = requests.get(f"https://chart.googleapis.com/chart?chs=500x500&cht=qr&chl={encoded}", timeout=10)
                if resp.status_code == 200:
                    bio = BytesIO(resp.content)
                    bio.name = 'qr.png'
            except: pass
    
    if bio:
        try:
            bot.send_photo(uid, bio, caption=caption, parse_mode="HTML", reply_markup=kb)
            # ONLY SET EXPIRY IF PHOTO SENT SUCCESSFULLY
            STORE_STATE[uid]["qr_expiry"] = time.time() + 300
        except Exception as e:
            bot.send_message(uid, f"⚠️ Failed to send photo: {e}")
    else:
        bot.send_message(uid, caption + f"\n\n<a href='{upi_str}'>Click Here to Pay via UPI App</a>", parse_mode="HTML", reply_markup=kb)
        # Set expiry even for text fallback
        STORE_STATE[uid]["qr_expiry"] = time.time() + 300


