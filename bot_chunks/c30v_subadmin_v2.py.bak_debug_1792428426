# NEW DEVICE — full registration 5 steps
# ==========================================================
@bot.callback_query_handler(func=lambda c: c.data == "sub_new")
def _v3_cb_new(call):
    uid = call.from_user.id
    try:
        bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except Exception:
        pass
    # If sub-admin already registered with this chat_id, tell them to use Already Registered
    if _v2_auth.is_sub_admin_registered(uid):
        safe_send(uid,
            "⚠️ This account is already registered as sub-admin.\n\n"
            "Use *Already Registered* to login, or ask admin to delete your registration first.",
