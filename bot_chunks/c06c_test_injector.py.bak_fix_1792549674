@bot.message_handler(commands=['test_ui'])
def cmd_test_ui(message):
    uid = message.chat.id
    from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
    kb = InlineKeyboardMarkup(row_width=3)
    btns = []
    for k in sorted(_DUMMY_QUESTIONS.keys()):
        btns.append(InlineKeyboardButton(f"Q{k}", callback_data=f"ui_test:{k}"))
    kb.add(*btns)
    safe_send(uid, "🧪 *Test UI — Pick a question type:*\n\n1. MCQ\n2. Multi-Correct\n3. Numerical (Int)\n4. Numerical (Decimal)\n5. Matching\n6. Integer (Blank)\n7. Passage", parse_mode="Markdown", reply_markup=kb)

@bot.callback_query_handler(func=lambda c: c.data.startswith("ui_test:"))
def cb_test_ui(call):
    uid = call.from_user.id
    q_id = call.data.split(":")[1]
    q = dict(_DUMMY_QUESTIONS.get(q_id, {}))
    if not q:
        return
    q["_plan_type"] = q["type"]
    
    # Cleanup previous state
    try: bot.delete_message(uid, call.message.message_id)
    except: pass
    
    # Simulate session
    p = load_profile(uid)
    if not hasattr(bot, "_fake_sess"): bot._fake_sess = {}
    bot._fake_sess[uid] = {"exam": p.get("priority", "JEE_ADV"), "plan_index": 0, "plan": [1]}
    
    import bot_chunks.c06b_test_ui as ui
    ui.send_test_question(uid, q, p.get("priority", "JEE_ADV"), 1, 1)

