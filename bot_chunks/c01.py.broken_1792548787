def difficulty_str(d):
    if not isinstance(d, str):
        return str(d)
    return {"easy": "Easy", "medium": "Medium", "hard": "Hard"}.get(d, d.capitalize())


def _is_guess(q, time_taken):
    if q.get("logic_type") != "calc":
        return False
    return time_taken < q.get("min_realistic_sec", 20)


