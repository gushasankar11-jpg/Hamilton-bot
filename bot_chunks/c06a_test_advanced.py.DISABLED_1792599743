# NUMERICAL HANDLER (Invoked by test engine when numerical q sent)
# ==========================================================
def handle_test_numerical(uid, text):
    """Called from c09 free_text if PENDING_NUMERICAL with is_test=True"""
    pending = globals().get("PENDING_NUMERICAL", {}).get(uid)
    if not pending:
        return False
        
    q = pending["q"]
    exam = load_profile(uid).get("_test_exam", "JEE_MAIN")
    
    correct_val = q.get("correct_value")
    is_correct = _check_numerical_answer(text, correct_val, exam)
    
    # Rounding info for JEE Adv
    if exam == "JEE_ADV":
        ans_msg = f"Answer: {round(float(correct_val), 2)}"
    else:
        ans_msg = f"Answer: {round(float(correct_val))}"
        
    safe_send(uid, f"📝 Recorded: *{text}* ({ans_msg})", parse_mode="Markdown")
    globals().get("PENDING_NUMERICAL", {}).pop(uid, None)
    
    # Advance test
    sess = exam_engine.get_session(uid)
    if sess:
        sess["plan_index"] += 1
        
    _send_next_test_q(uid)
    return True

