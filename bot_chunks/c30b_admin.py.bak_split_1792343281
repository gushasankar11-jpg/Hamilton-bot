@bot.callback_query_handler(func=lambda c: c.data == "admin_devices")
def _cb_devices(call):
    uid = call.message.chat.id
    session = auth.get_session(uid)
    if not session or session["role"] != "primary":
        bot.answer_callback_query(call.id, "Primary only")
        return
    entries = auth.list_admin_devices(40)
    text = "📱 *DEVICES & ACTIVITY*\n\n"
    text += "*Admin Login History (last 40):*\n"
    if not entries:
        text += "_No admin logins recorded._\n"
    else:
        for e in entries[-15:]:
            ts = e.get("ts", "")[:16].replace("T", " ")
            role = e.get("role", "?")
            cid = e.get("chat_id", "?")
            text += f"• `{cid}` · {role} · {ts}\n"

    text += "\n*Recent User Activity:*\n"
    active_users = []
    for u_id, p in _list_all_users():
        last = p.get("last_seen")
        if last:
            active_users.append((last, u_id, p))
    active_users.sort(reverse=True)
    for last, u_id, p in active_users[:15]:
        ts = last[:16].replace("T", " ")
        name = (p.get("name") or "?")[:15]
        text += f"• {name} · {ts}\n"

    kb = InlineKeyboardMarkup()
    kb.add(InlineKeyboardButton("🔙 Back", callback_data="admin_back"))
    try:
        bot.edit_message_text(text[:4000], chat_id=uid, message_id=call.message.message_id,
                               reply_markup=kb, parse_mode="Markdown")
    except Exception:
        bot.send_message(uid, text[:4000], reply_markup=kb, parse_mode="Markdown")


