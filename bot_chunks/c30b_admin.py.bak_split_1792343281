def _list_all_users():
    users = []
    if not os.path.isdir(PROFILE_DIR):
        return users
    for fname in os.listdir(PROFILE_DIR):
        if not fname.endswith(".json"):
            continue
        try:
            uid = int(fname.replace(".json", ""))
        except ValueError:
            continue
        try:
            with open(os.path.join(PROFILE_DIR, fname)) as f:
                p = json.load(f)
        except Exception:
            continue
        if not p.get("secured"):
            continue
        users.append((uid, p))
    users.sort(key=lambda x: x[1].get("created_at", ""), reverse=True)
    return users


def _days_since(iso_str):
    try:
        return (datetime.now() - datetime.fromisoformat(iso_str)).days
    except Exception:
        return "?"


def _snapshot_counters():
    """Compute today / week / total counters + online now."""
    today = datetime.now().date()
    week_ago = datetime.now() - timedelta(days=7)

    today_users = 0
    today_calls = 0
    week_calls = 0
    week_users_set = set()
    total_users = 0
    total_calls = 0
    try:
        with open("data/lifetime_stats.json") as _tcf:
            _tcs = json.load(_tcf)
            today_calls = _tcs.get("daily_calls", {}).get(today.isoformat(), 0)
            total_calls = _tcs.get("total_calls", 0)
    except Exception:
        pass

    online_count = 0
    online_uids = []

    now = datetime.now()
    for uid, p in _list_all_users():
        total_users += 1
        # PATCH 3B: no per-loop sum (lifetime file is source)

        # last activity
        last_seen = p.get("last_seen")
        if last_seen:
            try:
                dt = datetime.fromisoformat(last_seen)
                if dt.date() == today:
                    today_calls += 1
                    today_users += 1
                if dt >= week_ago:
                    week_calls += 1
                    week_users_set.add(uid)
                if (now - dt) < timedelta(minutes=5):
                    online_count += 1
                    online_uids.append((uid, p))
            except Exception:
                pass

    return {
        "today_calls": today_calls,
        "today_users": today_users,
        "week_calls": week_calls,
        "week_users": len(week_users_set) if isinstance(week_users_set, set) else week_users_set,
        "total_calls": total_calls,
        "total_users": total_users,
        "online_count": online_count,
        "online_uids": online_uids,
    }


