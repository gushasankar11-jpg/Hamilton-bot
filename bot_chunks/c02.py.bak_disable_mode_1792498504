@bot.message_handler(commands=['start'])
def cmd_start(message):
    uid = message.chat.id
    p = get_or_create_profile(uid)
    
    # If not yet activated (no key provided)
    if not p.get("secured"):
        save_profile(uid, p)
        
        greeting = (
            "🙏 *Namaskaram, Aspirant!*\n\n"
            "Welcome to the *Hamilton Study AI* platform. You are here to dedicate your upcoming days to participate in the race of competitive exams and emerge victorious.\n\n"
            "You stand in the final stretch of your Intermediate journey — balancing board studies with deep, focused preparation. "
            "I am your personal exam mentor, built by *Hemanth and Krishna Publications*, to walk beside you every single day until your rank is sealed.\n\n"
            "Your goal is not just to pass. Your goal is to *rise above the noise* and claim the rank you were born for.\n\n"
            "🔒 *Send your activation key to begin your journey.*"
        )
        bot.reply_to(message, greeting, parse_mode="Markdown")
        return
        
    # If activated but still in the middle of onboarding
    if p.get("onboarding_step") and p["onboarding_step"] != "done":
        _run_onboarding(uid)
        return
        
    # If fully registered
    bot.reply_to(message, 
        f"🙏 *Welcome back, {p.get('name', 'Aspirant')}!*\n\n"
        "Type /mode to continue your preparation.\n"
        "Type /clear_data if you want to wipe your profile and start over.", 
        parse_mode="Markdown")

@bot.message_handler(commands=['mode'])
def cmd_mode(message):
    uid = message.chat.id
    try:
        ready, reason = _profile_ready(uid)
        if not ready:
            _send_setup_prompt(uid, reason)
            return
    except Exception as _e:
        print(f"[mode] profile err: {_e}")
    # Step 1: Ask which exam FIRST
    p = load_profile(uid)
    exams = p.get("exams") or []
    if not exams:
        bot.send_message(uid, "\u26a0\ufe0f No exams set. Use /start to configure.")
        return
    if len(exams) == 1:
        # Only one exam — set it and go straight to mode
        p["_exam_chosen"] = exams[0]
        save_profile(uid, p)
        _ask_mode_after_exam(uid)
        return
    # Multiple exams — ask which
    from telebot.types import ReplyKeyboardMarkup
    kb = ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    for e in exams:
        try:
            kb.add(EXAM_NAMES[e])
        except Exception:
            kb.add(e)
    msg = bot.send_message(
        uid,
        "\U0001f4da *Step 1/2 \u2014 Which exam?*\n\n"
        "_You can change priority anytime with /select_",
        reply_markup=kb, parse_mode="Markdown"
    )
    bot.register_next_step_handler(msg, _mode_choose_exam)


def _mode_choose_exam(message):
    """User picked an exam. Save it, then ask mode."""
    uid = message.chat.id
    t = (message.text or "").strip()
    p = load_profile(uid)
    exams = p.get("exams") or []
    # Match user's choice to exam key
    chosen = None
    for e in exams:
        try:
            if EXAM_NAMES[e].lower() == t.lower():
                chosen = e
                break
        except Exception:
            if e.lower() == t.lower():
                chosen = e
                break
    if not chosen:
        bot.reply_to(message, "Tap one of the exams shown above.")
        return
    p["_exam_chosen"] = chosen
    save_profile(uid, p)
    _ask_mode_after_exam(uid)


def _ask_mode_after_exam(uid):
    """After exam chosen, ask Practice/Test/Conceptual."""
    from telebot.types import ReplyKeyboardMarkup
    p = load_profile(uid)
    exam_key = p.get("_exam_chosen", "")
    exam_name = exam_key
    try:
        exam_name = EXAM_NAMES.get(exam_key, exam_key)
    except Exception:
        pass
    kb = ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    kb.add("Practice", "Test", "Conceptual")
    msg = bot.send_message(
        uid,
        f"\U0001f4da *Step 2/2 \u2014 Mode for {exam_name}*\n\n"
        "\u2022 *Practice* \u2014 casual learning\n"
        "\u2022 *Test* \u2014 full exam simulation\n"
        "\u2022 *Conceptual* \u2014 theory & exceptions focus",
        reply_markup=kb, parse_mode="Markdown"
    )
    # _exam_mode expects Practice/Test/Conceptual text
    handler = globals().get("_exam_mode")
    if handler:
        bot.register_next_step_handler(msg, handler)




