# ==========================================================
# c06b_test_ui.py — Button-based test engine (no polls)
# MCQ, Multi-correct, Numerical, Matching
# ==========================================================
from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton

def _get_bot():
    """Lazy get bot from global namespace (avoids NameError at module load)."""
    import sys
    for name in ("bot", "_bot"):
        for mod_name, mod in sys.modules.items():
            if hasattr(mod, name):
                return getattr(mod, name)
    # Fallback — assume current file's global bot exists
    return globals().get("bot")

import time


# ═══════════════════════════════════════════════════════════
# SENDERS
# ═══════════════════════════════════════════════════════════

def send_test_question(uid, q, exam, q_num, q_total):
    """Main dispatcher — reads q_type from question and routes."""
    q_type = (q.get("_plan_type") or q.get("type") or "mcq").lower()
    meta = q.get("_meta") or {}
    
    if q_type == "numerical" or q.get("correct_value") is not None:
        return _send_numerical(uid, q, exam, q_num, q_total)
    elif q_type == "matching":
        return _send_matching(uid, q, exam, q_num, q_total)
    elif q_type == "multi":
        return _send_multi(uid, q, exam, q_num, q_total)
    else:
        return _send_mcq(uid, q, exam, q_num, q_total)


def _header(q, exam, q_num, q_total):
    meta = q.get("_meta") or {}
    subj = meta.get("subject", "?")
    chap = meta.get("chapter", "?")
    sub = meta.get("subtopic", "?")
    ideal = q.get("ideal_time_sec", 60)
    st = q.get("source_type", "AI")
    sd = q.get("source_detail", "")
    src = f"{st} · {sd}" if sd else st
    from config import EXAM_NAMES
    ename = EXAM_NAMES.get(exam, exam)
    return (
        f"*[{ename} | {subj} | Q{q_num}/{q_total}]*\n"
        f"📌 {src}  ·  ⏱️ Ideal: {ideal}s\n"
        f"📖 {chap} → {sub}"
    )


def _clean_text(s):
    """Strip leaked HTML/markdown."""
    import re as _re
    s = _re.sub(r"</?pre>", "", s or "")
    s = _re.sub(r"</?math>", "", s)
    s = _re.sub(r"</?code>", "", s)
    s = _re.sub(r"&lt;", "<", s)
    s = _re.sub(r"&gt;", ">", s)
    return s


# ═══════════════════════════════════════════════════════════
# MCQ — single correct
# ═══════════════════════════════════════════════════════════
def _send_mcq(uid, q, exam, q_num, q_total):
    qtext = _clean_text(q.get("question"))
    header = _header(q, exam, q_num, q_total)
    options = q.get("options") or []
    if len(options) < 2:
        return False
    
    body = f"{header}\n\n{qtext}"
    # Options in pre block for alignment
    opt_lines = []
    for i, opt in enumerate(options[:4]):
        opt_lines.append(f"{chr(65+i)}) {opt}")
    body += "\n\n<pre>" + "\n".join(opt_lines) + "</pre>"
    
    try:
        _get_bot()._test_multi_state[uid] = {
            "type": "mcq",
            "q": q,
            "exam": exam,
            "selected": set(),
            "q_num": q_num,
            "q_total": q_total,
        }
        kb = _build_answer_kb(uid, "mcq", len(options[:4]))
        safe_send(uid, body, parse_mode="HTML", reply_markup=kb)
        return True
    except Exception as e:
        print(f"[mcq-send] {e}")
        import traceback; traceback.print_exc()
        safe_send(uid, f"❌ MCQ render error: {str(e)[:150]}")
        return False


# ═══════════════════════════════════════════════════════════
# MULTI — multiple correct
# ═══════════════════════════════════════════════════════════
def _send_multi(uid, q, exam, q_num, q_total):
    qtext = _clean_text(q.get("question"))
    header = _header(q, exam, q_num, q_total)
    options = q.get("options") or []
    if len(options) < 2:
        return False
    
    body = f"{header}\n\n{qtext}"
    body += "\n\n_Select one or more, then tap ✅ Save_"
    opt_lines = []
    for i, opt in enumerate(options[:4]):
        opt_lines.append(f"{chr(65+i)}) {opt}")
    body += "\n\n<pre>" + "\n".join(opt_lines) + "</pre>"
    
    try:
        _get_bot()._test_multi_state[uid] = {
            "type": "multi",
            "q": q,
            "exam": exam,
            "selected": set(),
            "q_num": q_num,
            "q_total": q_total,
        }
        kb = _build_answer_kb(uid, "multi", len(options[:4]))
        safe_send(uid, body, parse_mode="HTML", reply_markup=kb)
        return True
    except Exception as e:
        print(f"[multi-send] {e}")
        safe_send(uid, f"❌ Multi render error: {str(e)[:150]}")
        return False


# ═══════════════════════════════════════════════════════════
# NUMERICAL — calculator style
# ═══════════════════════════════════════════════════════════
def _send_numerical(uid, q, exam, q_num, q_total):
    qtext = _clean_text(q.get("question"))
    header = _header(q, exam, q_num, q_total)
    body = f"{header}\n\n{qtext}\n\n*Answer:* ` `"
    
    try:
        _get_bot()._test_multi_state[uid] = {
            "type": "numerical",
            "q": q,
            "exam": exam,
            "input": "",
            "q_num": q_num,
            "q_total": q_total,
        }
        kb = _build_numpad_kb(uid, "")
        safe_send(uid, body, parse_mode="Markdown", reply_markup=kb)
        return True
    except Exception as e:
        print(f"[num-send] {e}")
        safe_send(uid, f"❌ Numerical render error: {str(e)[:150]}")
        return False


# ═══════════════════════════════════════════════════════════
# MATCHING — side-by-side pre block
# ═══════════════════════════════════════════════════════════
def _send_matching(uid, q, exam, q_num, q_total):
    qtext = _clean_text(q.get("question"))
    header = _header(q, exam, q_num, q_total)
    col_a = q.get("match_a") or []
    col_b = q.get("match_b") or []
    if not col_a or not col_b:
        # Fallback — treat as MCQ
        return _send_mcq(uid, q, exam, q_num, q_total)
    
    # Build padded columns
    max_a = max((len(str(x)) for x in col_a), default=0)
    max_b = max((len(str(x)) for x in col_b), default=0)
    w = max_a + 4
    
    table = "Col I" + " " * (w - 5) + "Col II\n"
    table += "─" * (w + max_b + 8) + "\n"
    rows = max(len(col_a), len(col_b))
    for i in range(rows):
        a_line = f"{chr(65+i)}. {col_a[i]}" if i < len(col_a) else ""
        b_line = f"{chr(80+i)}. {col_b[i]}" if i < len(col_b) else ""
        table += a_line.ljust(w) + "  " + b_line + "\n"
    
    body = f"{header}\n\n{qtext}\n\n<pre>{table}</pre>\n\n_Tap A–P / A–Q etc. to pair_"
    
    try:
        _get_bot()._test_multi_state[uid] = {
            "type": "matching",
            "q": q,
            "exam": exam,
            "pairs": {},
            "col_a_count": len(col_a),
            "col_b_count": len(col_b),
            "q_num": q_num,
            "q_total": q_total,
        }
        kb = _build_match_kb(uid)
        safe_send(uid, body, parse_mode="HTML", reply_markup=kb)
        return True
    except Exception as e:
        print(f"[match-send] {e}")
        safe_send(uid, f"❌ Matching render error: {str(e)[:150]}")
        return False


# ═══════════════════════════════════════════════════════════
# KEYBOARD BUILDERS
# ═══════════════════════════════════════════════════════════
def _build_answer_kb(uid, q_type, n_opts):
    kb = InlineKeyboardMarkup(row_width=n_opts)
    state = _get_bot()._test_multi_state.get(uid) or {}
    selected = state.get("selected") or set()
    row = []
    for i in range(n_opts):
        letter = chr(65 + i)
        mark = "✅" if letter in selected else ""
        row.append(InlineKeyboardButton(f"{mark}{letter}", callback_data=f"tq_tog:{letter}"))
    kb.row(*row)
    kb.row(
        InlineKeyboardButton("✔️ Save", callback_data="tq_save"),
        InlineKeyboardButton("✖️ Clear", callback_data="tq_clear"),
        InlineKeyboardButton("⏭ Skip", callback_data="tq_skip"),
    )
    return kb


def _build_numpad_kb(uid, current):
    state = _get_bot()._test_multi_state.get(uid) or {}
    display = current or state.get("input", "") or "_"
    kb = InlineKeyboardMarkup(row_width=4)
    kb.row(InlineKeyboardButton(f"Answer: {display}", callback_data="tq_noop"))
    kb.row(
        InlineKeyboardButton("7", callback_data="tq_num:7"),
        InlineKeyboardButton("8", callback_data="tq_num:8"),
        InlineKeyboardButton("9", callback_data="tq_num:9"),
        InlineKeyboardButton("⌫", callback_data="tq_back"),
    )
    kb.row(
        InlineKeyboardButton("4", callback_data="tq_num:4"),
        InlineKeyboardButton("5", callback_data="tq_num:5"),
        InlineKeyboardButton("6", callback_data="tq_num:6"),
        InlineKeyboardButton(".", callback_data="tq_num:."),
    )
    kb.row(
        InlineKeyboardButton("1", callback_data="tq_num:1"),
        InlineKeyboardButton("2", callback_data="tq_num:2"),
        InlineKeyboardButton("3", callback_data="tq_num:3"),
        InlineKeyboardButton("-", callback_data="tq_num:-"),
    )
    kb.row(
        InlineKeyboardButton("0", callback_data="tq_num:0"),
        InlineKeyboardButton("/", callback_data="tq_num:/"),
    )
    kb.row(
        InlineKeyboardButton("✔️ Save", callback_data="tq_save"),
        InlineKeyboardButton("✖️ Clear", callback_data="tq_clear"),
        InlineKeyboardButton("⏭ Skip", callback_data="tq_skip"),
    )
    return kb


def _build_match_kb(uid):
    state = _get_bot()._test_multi_state.get(uid) or {}
    pairs = state.get("pairs") or {}
    n_a = state.get("col_a_count", 0)
    n_b = state.get("col_b_count", 0)
    kb = InlineKeyboardMarkup(row_width=n_b)
    
    # Row per Column A item
    for i in range(n_a):
        letter_a = chr(65 + i)
        current = pairs.get(letter_a)
        row = []
        for j in range(n_b):
            letter_b = chr(80 + j)
            is_selected = (current == letter_b)
            label = f"✅{letter_a}-{letter_b}" if is_selected else f"{letter_a}-{letter_b}"
            row.append(InlineKeyboardButton(label, callback_data=f"tq_pair:{letter_a}:{letter_b}"))
        kb.row(*row)
    
    kb.row(
        InlineKeyboardButton("✔️ Save", callback_data="tq_save"),
        InlineKeyboardButton("✖️ Clear", callback_data="tq_clear"),
        InlineKeyboardButton("⏭ Skip", callback_data="tq_skip"),
    )
    return kb


# ═══════════════════════════════════════════════════════════
# CALLBACK HANDLERS
# ═══════════════════════════════════════════════════════════
@bot.callback_query_handler(func=lambda c: c.data == "tq_noop")
def _tq_noop(call):
    _get_bot().answer_callback_query(call.id)


@bot.callback_query_handler(func=lambda c: c.data.startswith("tq_tog:"))
def _tq_toggle(call):
    uid = call.from_user.id
    state = _get_bot()._test_multi_state.get(uid)
    if not state:
        return
    letter = call.data.split(":")[1]
    selected = state.get("selected") or set()
    if state["type"] == "mcq":
        # MCQ — only one selected
        state["selected"] = {letter}
    else:
        # Multi — toggle
        if letter in selected:
            selected.remove(letter)
        else:
            selected.add(letter)
        state["selected"] = selected
    try:
        _get_bot().edit_message_reply_markup(
            uid, call.message.message_id,
            reply_markup=_build_answer_kb(uid, state["type"], 4)
        )
    except Exception:
        pass
    _get_bot().answer_callback_query(call.id)


@bot.callback_query_handler(func=lambda c: c.data.startswith("tq_pair:"))
def _tq_pair(call):
    uid = call.from_user.id
    state = _get_bot()._test_multi_state.get(uid)
    if not state or state["type"] != "matching":
        return
    try:
        _, a, b = call.data.split(":")
    except Exception:
        return
    pairs = state.get("pairs") or {}
    # Toggle: if A already = B, clear; else set
    if pairs.get(a) == b:
        pairs.pop(a, None)
    else:
        pairs[a] = b
    state["pairs"] = pairs
    try:
        _get_bot().edit_message_reply_markup(
            uid, call.message.message_id,
            reply_markup=_build_match_kb(uid)
        )
    except Exception:
        pass
    _get_bot().answer_callback_query(call.id, f"{a}→{b}" if a in pairs else "Cleared")


@bot.callback_query_handler(func=lambda c: c.data.startswith("tq_num:"))
def _tq_num(call):
    uid = call.from_user.id
    state = _get_bot()._test_multi_state.get(uid)
    if not state or state["type"] != "numerical":
        return
    ch = call.data.split(":", 1)[1]
    cur = state.get("input", "")
    if len(cur) >= 12:
        _get_bot().answer_callback_query(call.id, "Max length")
        return
    state["input"] = cur + ch
    try:
        _get_bot().edit_message_reply_markup(
            uid, call.message.message_id,
            reply_markup=_build_numpad_kb(uid, state["input"])
        )
    except Exception:
        pass
    _get_bot().answer_callback_query(call.id, state["input"])


@bot.callback_query_handler(func=lambda c: c.data == "tq_back")
def _tq_back(call):
    uid = call.from_user.id
    state = _get_bot()._test_multi_state.get(uid)
    if not state or state["type"] != "numerical":
        return
    state["input"] = state.get("input", "")[:-1]
    try:
        _get_bot().edit_message_reply_markup(
            uid, call.message.message_id,
            reply_markup=_build_numpad_kb(uid, state["input"])
        )
    except Exception:
        pass
    _get_bot().answer_callback_query(call.id)


@bot.callback_query_handler(func=lambda c: c.data == "tq_clear")
def _tq_clear(call):
    uid = call.from_user.id
    state = _get_bot()._test_multi_state.get(uid)
    if not state:
        return
    if state["type"] == "numerical":
        state["input"] = ""
        try:
            _get_bot().edit_message_reply_markup(
                uid, call.message.message_id,
                reply_markup=_build_numpad_kb(uid, "")
            )
        except Exception:
            pass
    elif state["type"] == "matching":
        state["pairs"] = {}
        try:
            _get_bot().edit_message_reply_markup(
                uid, call.message.message_id,
                reply_markup=_build_match_kb(uid)
            )
        except Exception:
            pass
    else:
        state["selected"] = set()
        try:
            _get_bot().edit_message_reply_markup(
                uid, call.message.message_id,
                reply_markup=_build_answer_kb(uid, state["type"], 4)
            )
        except Exception:
            pass
    _get_bot().answer_callback_query(call.id, "Cleared")


@bot.callback_query_handler(func=lambda c: c.data == "tq_save")
def _tq_save(call):
    uid = call.from_user.id
    state = _get_bot()._test_multi_state.get(uid)
    if not state:
        _get_bot().answer_callback_query(call.id, "Session expired")
        return
    _get_bot().answer_callback_query(call.id, "Saving...")
    _finalize_test_answer(uid, call.message.message_id, state, "save")


@bot.callback_query_handler(func=lambda c: c.data == "tq_skip")
def _tq_skip(call):
    uid = call.from_user.id
    state = _get_bot()._test_multi_state.get(uid)
    if not state:
        _get_bot().answer_callback_query(call.id, "Session expired")
        return
    _get_bot().answer_callback_query(call.id, "Skipped")
    _finalize_test_answer(uid, call.message.message_id, state, "skip")


def _finalize_test_answer(uid, msg_id, state, action):
    """Verify answer, log it, advance."""
    q = state["q"]
    exam = state["exam"]
    q_type = state["type"]
    
    is_correct = None
    user_answer = None
    
    if action == "skip":
        is_correct = False
        user_answer = "SKIP"
    elif q_type == "mcq":
        selected = state["selected"]
        if not selected:
            _get_bot().answer_callback_query(uid, "Select an option first")
            return
        letter = list(selected)[0]
        user_answer = letter
        correct = q.get("correct_index", 0)
        is_correct = (ord(letter) - 65) == correct
    elif q_type == "multi":
        selected = state["selected"]
        if not selected:
            _get_bot().answer_callback_query(uid, "Select at least one option")
            return
        user_set = set(ord(x) - 65 for x in selected)
        correct_list = q.get("correct_indices") or [q.get("correct_index", 0)]
        correct_set = set(correct_list)
        is_correct = (user_set == correct_set)
        user_answer = ",".join(sorted(selected))
    elif q_type == "numerical":
        raw = state.get("input", "")
        user_answer = raw
        try:
            if '/' in raw:
                n, d = raw.split('/')
                val = float(n) / float(d)
            else:
                val = float(raw)
            correct_val = float(q.get("correct_value", 0))
            if exam == "JEE_ADV":
                is_correct = round(val, 2) == round(correct_val, 2)
            else:
                is_correct = round(val) == round(correct_val)
        except Exception:
            is_correct = False
    elif q_type == "matching":
        pairs = state.get("pairs") or {}
        correct_map = q.get("correct_match") or {}
        if not pairs:
            _get_bot().answer_callback_query(uid, "Match at least one pair")
            return
        user_answer = str(pairs)
        total = len(correct_map)
        score = sum(1 for k, v in pairs.items() if correct_map.get(k) == v)
        is_correct = (score == total)
    
    # Record
    try:
        sess = exam_engine.get_session(uid)
        if sess:
            sess["plan_index"] = sess.get("plan_index", 0) + 1
            if is_correct:
                sess["correct"] = sess.get("correct", 0) + 1
            elif action != "skip":
                sess["wrong"] = sess.get("wrong", 0) + 1
            else:
                sess["skipped"] = sess.get("skipped", 0) + 1
    except Exception as e:
        print(f"[finalize] {e}")
    
    _get_bot()._test_multi_state.pop(uid, None)
    
    # Delete question message
    try:
        _get_bot().delete_message(uid, msg_id)
    except Exception:
        pass
    
    # Brief confirmation
    if action == "skip":
        icon = "⏭"
    elif is_correct:
        icon = "✅"
    else:
        icon = "❌"
    safe_send(uid, f"{icon} *Recorded:* {user_answer}", parse_mode="Markdown")
    
    # Next question
    try:
        _send_next_test_q(uid)
    except Exception as e:
        print(f"[finalize-next] {e}")

print("c06b_test_ui: loaded.")
