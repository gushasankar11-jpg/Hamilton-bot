    except Exception as e:
        bot.send_message(message.chat.id, f"⚠️ Error: {e}")


@bot.message_handler(commands=['classify'])
def cmd_classify(message):
    uid = message.chat.id
    bot.send_message(uid, "⚡ Running Fast Classifier...")
    
    try:
        import json, re
        from collections import defaultdict
        
        db = json.load(open("data/pyq_master.json"))
        stats = defaultdict(lambda: defaultdict(lambda: {"MCQ": 0, "Num": 0, "Match": 0, "Years": set()}))
        
        # Scan Papers
        for p_name, p_data in db.get("papers", {}).items():
            subj = str(p_data.get("subject", "Physics")).capitalize()
            ch = str(p_data.get("chapter", "Mixed"))
            for q in p_data.get("questions", []):
                q_t = str(q.get("type", "")).lower()
                has_opts = bool(q.get("options"))
                if "mcq" in q_t or "single" in q_t or has_opts: stats[subj][ch]["MCQ"] += 1
                elif "num" in q_t: stats[subj][ch]["Num"] += 1
                elif "match" in q_t: stats[subj][ch]["Match"] += 1
                
                yr = str(q.get("year") or q.get("source", ""))
                m = re.search(r'(20\d\d)', yr)
                if m: stats[subj][ch]["Years"].add(m.group(1))
                
        # Scan Practice
        for main_adv in ["practice", "practice_adv"]:
            for subj, chapters in db.get(main_adv, {}).items():
                for ch, q_data in chapters.items():
                    for q in q_data.get("priority", []) + q_data.get("normal", []):
                        q_t = str(q.get("type", "")).lower()
                        has_opts = bool(q.get("options"))
                        if "mcq" in q_t or "single" in q_t or has_opts: stats[subj][ch]["MCQ"] += 1
                        elif "num" in q_t: stats[subj][ch]["Num"] += 1
                        elif "match" in q_t: stats[subj][ch]["Match"] += 1
                        
                        yr = str(q.get("year") or q.get("source", ""))
                        m = re.search(r'(20\d\d)', yr)
                        if m: stats[subj][ch]["Years"].add(m.group(1))

        # Save to file
        final_stats = {}
        for subj, chapters in stats.items():
            final_stats[subj] = {}
            for ch, counts in chapters.items():
                final_stats[subj][ch] = {
                    "MCQ": counts["MCQ"], "Num": counts["Num"], "Match": counts["Match"],
                    "Years": sorted(list(counts["Years"]), reverse=True)
                }
        json.dump(final_stats, open("data/chapter_stats.json", "w"), indent=2)
        
        # Reply with summary
        txt = "📊 <b>CLASSIFIER RESULT</b>\n\n"
        total_q = 0
        for subj, chapters in final_stats.items():
            txt += f"📚 <b>{subj}:</b>\n"
            for ch, counts in chapters.items():
                tot = counts['MCQ'] + counts['Num'] + counts['Match']
                total_q += tot
                if tot > 0:
                    txt += f"  • {ch[:25]}: {tot} Qs (MCQ:{counts['MCQ']}, Num:{counts['Num']}, Match:{counts['Match']})\n"
            txt += "\n"
            
        txt += f"✅ <b>Total Questions Classified: {total_q}</b>"
        bot.send_message(uid, txt, parse_mode="HTML")
    except Exception as e:
        bot.send_message(uid, f"❌ Classify Error: {e}")


@bot.callback_query_handler(func=lambda c: c.data and (c.data.startswith("shop_") or c.data.startswith("add_prod:") or c.data.startswith("rem_prod:") or c.data.startswith("det_prod:") or c.data.startswith("loc:") or c.data.startswith("ai_for:") or c.data.startswith("contact_admin:") or c.data.startswith("admin_approve:") or c.data.startswith("admin_reject:") or c.data in ["checkout", "ignore", "ai_confirm:yes", "cancel_order", "verify_manual", "shop_exit", "shop_continue", "confirm_pay"]))
def handle_store_callback(call):
    # 1. INSTANTLY STOP THE LOADING SPINNER
    try: bot.answer_callback_query(call.id)
    except: pass
    
    data = call.data
    uid = call.message.chat.id
    
    # 2. FILTER ONLY STORE CALLBACKS
    if not (data.startswith("shop_") or data.startswith("add_prod:") or data.startswith("rem_prod:") or data.startswith("det_prod:") or data.startswith("loc:") or data.startswith("ai_for:") or data.startswith("contact_admin:") or data.startswith("admin_approve:") or data.startswith("admin_reject:") or data in ["checkout", "ignore", "ai_confirm:yes", "cancel_order", "verify_manual", "shop_exit", "shop_continue", "confirm_pay"]):
        return

    try:
        if data == "shop_buy":
            render_shop_menu(uid, call.message.message_id)

        elif data == "shop_details":
            kb = InlineKeyboardMarkup(row_width=1)
            for pid, p in PRODUCTS.items():
                kb.add(InlineKeyboardButton(f"{p['name']}", callback_data=f"det_prod:{pid}"))
            kb.add(InlineKeyboardButton("🔙 Back to Menu", callback_data="shop_main"))
            try: bot.edit_message_text("📄 <b>Product Details</b>\nSelect a product to view reviews on WhatsApp:", chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb)
            except: pass

        elif data.startswith("det_prod:"):
            pid = data.split(":")[1]
            p = PRODUCTS[pid]
            txt = f"📦 <b>{p['name']}</b>\n💰 Price: ₹{p['price']}\n\n👇 <b>Tap the button below to view this product on WhatsApp:</b>"
            kb = InlineKeyboardMarkup()
            kb.add(InlineKeyboardButton("🔗 Open WhatsApp Link", url=p['link']))
            kb.add(InlineKeyboardButton("🔙 Back to Details", callback_data="shop_details"))
            try: bot.edit_message_text(txt, chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb, disable_web_page_preview=True)
            except: pass

        elif data == "shop_ai_limit":
            avail, sold = _get_ai_slots()
            msg = f"🤖 <b>Hamilton AI Premium - Availability</b>\n\n🔒 <b>Total Seats:</b> 90\n👥 <b>Registered:</b> {sold}\n✅ <b>Remaining:</b> {avail}\n\n"
            if avail > 0:
                msg += "Hurry up and secure your seat before they run out! 🏃‍♂️💨"
                kb = InlineKeyboardMarkup().add(InlineKeyboardButton("🛒 Buy Now", callback_data="shop_buy"))
            else:
                msg += "❌ <b>SOLD OUT!</b> All 90 seats have been claimed."
                kb = InlineKeyboardMarkup().add(InlineKeyboardButton("🔙 Back", callback_data="shop_main"))
            try: bot.edit_message_text(msg, chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb)
            except: pass

        elif data == "shop_orders":
            orders_data = _load_orders()
            user_orders = orders_data.get(str(uid), [])
            if not user_orders:
                try: bot.edit_message_text("📦 You have no pending book orders.", chat_id=uid, message_id=call.message.message_id, reply_markup=InlineKeyboardMarkup().add(InlineKeyboardButton("🔙 Back", callback_data="shop_main")))
                except: pass
                return
                
            kb = InlineKeyboardMarkup()
            msg = "📦 <b>Your Book Orders:</b>\n\n"
            for idx, o in enumerate(user_orders):
                msg += f"🛒 <b>Order {idx+1}:</b>\n📅 Delivery: {o.get('delivery')}\n💰 Total: ₹{o.get('total')}\n"
                if not o.get("contacted_admin"):
                    msg += "⚠️ <b>You have not contacted admin yet!</b>\n"
                    kb.add(InlineKeyboardButton(f"Contact Admin (Order {idx+1})", callback_data=f"contact_admin:{idx}"))
                else:
                    msg += "✅ Contacted admin.\n"
                msg += "---\n"
                
            kb.add(InlineKeyboardButton("🔙 Back to Menu", callback_data="shop_main"))
            try: bot.edit_message_text(msg, chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb)
            except: pass

        elif data.startswith("contact_admin:"):
            idx = data.split(":")[1]
            orders_data = _load_orders()
            uid_str = str(uid)
            if uid_str in orders_data and int(idx) < len(orders_data[uid_str]):
                orders_data[uid_str][int(idx)]["contacted_admin"] = True
                _save_orders(orders_data)
                bot.send_message(uid, "👉 <a href='https://wa.me/918074231426'>Click here to message Admin on WhatsApp</a>", parse_mode="HTML", disable_web_page_preview=True)
                handle_store_callback(type('obj', (object,), {'id': call.id, 'message': call.message, 'data': 'shop_orders'})())
            return

        elif data == "shop_main":
            try: bot.delete_message(uid, call.message.message_id)
            except: pass
            cmd_shop(call.message)

        elif data.startswith("add_prod:"):
            pid = data.split(":")[1]
            p = PRODUCTS[pid]
            
            if p.get("is_ai"):
                avail, _ = _get_ai_slots()
                if avail <= 0:
                    bot.send_message(uid, "❌ Sold Out! All 90 Hamilton AI keys are claimed.")
                    return
                _get_cart(uid)["pending_ai"] = pid
                kb = InlineKeyboardMarkup()
                kb.add(InlineKeyboardButton("👤 For Me", callback_data="ai_for:me"))
                kb.add(InlineKeyboardButton("🎁 For Someone Else", callback_data="ai_for:other"))
                kb.add(InlineKeyboardButton("🔙 Cancel", callback_data="shop_buy"))
                try: bot.edit_message_text(f"🤖 <b>{p['name']}</b>\n\nWho are you purchasing this for?", chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb)
                except: pass
                return

            cart = _get_cart(uid)["cart"]
            cart[pid] = cart.get(pid, 0) + 1
            render_shop_menu(uid, call.message.message_id)

        elif data.startswith("rem_prod:"):
            pid = data.split(":")[1]
            cart = _get_cart(uid)["cart"]
            if pid in cart:
                cart[pid] -= 1
                if cart[pid] <= 0: del cart[pid]
            render_shop_menu(uid, call.message.message_id)

        elif data.startswith("ai_for:"):
            target = data.split(":")[1]
            state = _get_cart(uid)
            pid = state["pending_ai"]
            
            if target == "me":
                p = load_profile(uid)
                if p.get("secured") and p.get("is_paid"):
                    state["ai_recipient"] = p.get("name", "Me")
                    kb = InlineKeyboardMarkup()
                    kb.add(InlineKeyboardButton("✅ Yes, Buy Another", callback_data="ai_confirm:yes"))
                    kb.add(InlineKeyboardButton("❌ Cancel", callback_data="shop_buy"))
                    try: bot.edit_message_text(f"⚠️ You already have an active Hamilton AI plan.\nAre you sure you want to buy another for yourself?", chat_id=uid, message_id=call.message.message_id, reply_markup=kb)
                    except: pass
                else:
                    state["ai_recipient"] = p.get("name", "Me")
                    _add_ai_to_cart(uid, pid, call)
                    
            elif target == "other":
                msg = bot.send_message(uid, "🎁 Please enter the name of the person you are buying this for:")
                bot.register_next_step_handler(msg, process_ai_recipient_name)

        elif data == "ai_confirm:yes":
            pid = _get_cart(uid)["pending_ai"]
            _add_ai_to_cart(uid, pid, call)

        elif data == "checkout":
            state = _get_cart(uid)
            if not state["cart"]:
                bot.send_message(uid, "Your cart is empty!")
                return
            
            state["waiting_for_name"] = True
            bot.send_message(uid, "📝 <b>Please enter your Full Name for the order delivery:</b>", parse_mode="HTML")
            return

        elif data.startswith("loc:"):
            loc = data.split(":")[1]
            state = _get_cart(uid)
            state["location"] = loc
            
            total_qty = sum(qty for qty in state["cart"].values())
            discount = total_qty * 30
            base_total = sum(PRODUCTS[pid]["price"] * qty for pid, qty in state["cart"].items())
            final_total = max(0, base_total - discount) + (50 if loc == "Nellore" else 0)
            
            state["final_amount"] = final_total
            
            kb = InlineKeyboardMarkup()
            kb.add(InlineKeyboardButton("✅ Confirm & Pay", callback_data="confirm_pay"))
            kb.add(InlineKeyboardButton("❌ Cancel", callback_data="shop_buy"))
            
            msg = f"📦 Base Total: ₹{base_total}\n🎉 <b>Discount: -₹{discount}</b>\n💵 Delivery: {'₹50' if loc == 'Nellore' else 'Contact Admin'}\n💰 <b>Final Amount: ₹{final_total}</b>\n\nAre you sure you want to proceed to payment?"
            try: bot.edit_message_text(msg, chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb)
            except: pass

        elif data == "confirm_pay":
            state = _get_cart(uid)
            
            if state.get("qr_expiry") and time.time() < state["qr_expiry"]:
                bot.send_message(uid, "⚠️ <b>Scanner already sent!</b>\nPlease complete the payment using the previous QR code. It is valid for 5 minutes.")
                return

            try: bot.delete_message(uid, call.message.message_id)
            except: pass
            
            if state.get("location") == "Outside":
                bot.send_message(uid, "⚠️ <b>Note:</b> External delivery charges will be applied. You must contact Admin after payment to discuss delivery details:\n👉 <a href='https://wa.me/918074231426'>WhatsApp Admin</a>", parse_mode="HTML")
                
            generate_qr(uid, state["final_amount"])

        elif data == "ignore":
            pass
        
        elif data == "cancel_order":
            try: bot.delete_message(uid, call.message.message_id)
            except: pass
            bot.send_message(uid, "❌ Order Cancelled.")
            STORE_STATE[uid]["qr_expiry"] = None
            
        elif data == "verify_manual":
            state = _get_cart(uid)
            order_id = state.get("order_id")
            
            if not order_id:
                bot.send_message(uid, "❌ Order expired or not found. Please checkout again.")
                return
                
            # Rebuild the keyboard so it doesn't disappear
            kb_verify = InlineKeyboardMarkup()
            kb_verify.add(InlineKeyboardButton("✅ Verify Payment", callback_data="verify_manual"))
            kb_verify.add(InlineKeyboardButton("❌ Cancel", callback_data="cancel_order"))
            
            # Generic message (No FamGateway name)
            try: bot.edit_message_caption("🔄 <b>Verifying your payment...</b>", chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb_verify)
            except: pass
            
            is_paid = False
            utr = "MANUAL"
            
            if state.get("fam_api_active"):
                api_res = check_fam_status(order_id)
                if api_res:
                    status_str = str(api_res.get("status", "")).upper()
                    if status_str in ["SUCCESS", "PAID", "COMPLETED"]:
                        is_paid = True
                        utr = str(api_res.get("utr", api_res.get("txn_id", "UTR_AUTO")))
            
            if is_paid:
                try: bot.edit_message_caption("🎉 <b>Payment Verified Automatically!</b>", chat_id=uid, message_id=call.message.message_id, parse_mode="HTML")
                except: pass
                
                fake_call = type('obj', (object,), {'id': call.id, 'message': call.message, 'data': f'admin_approve:{uid}', 'from_user': call.from_user})
                bot.answer_callback_query(call.id, "✅ Auto-Verified!")
                admin_verify(fake_call)
                
            else:
                # Show error but KEEP the verify button
                msg = "⏳ <b>Payment Not Detected Yet.</b>\n\nPlease wait 10 seconds for the banking network to settle, then tap <b>Verify Payment</b> again."
                try: bot.edit_message_caption(msg, chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb_verify)
                except: pass
                
                # Send manual fallback to Admin
                kb_admin = InlineKeyboardMarkup()
                kb_admin.add(InlineKeyboardButton("✅ Admin Approve", callback_data=f"admin_approve:{uid}"))
                kb_admin.add(InlineKeyboardButton("❌ Reject", callback_data=f"admin_reject:{uid}"))
                admin_msg = f"🚨 <b>PAYMENT PENDING</b>\n👤 User: {state.get('order_name')}\n🏷 ID: {order_id}\n💰 Amt: ₹{state['total_amount']}\n\n<i>User tried to verify, but API says PENDING. Click Approve to gift/force approve.</i>"
                try: bot.send_message(ADMIN_GROUP_ID, admin_msg, parse_mode="HTML", reply_markup=kb_admin)
                except: pass

        elif data.startswith("admin_approve:") or data.startswith("admin_reject:"):
            action, target_uid = data.split(":")
            target_uid = int(target_uid)
            state = STORE_STATE.get(target_uid)
            if not state: return
            
            if action == "admin_approve":
                try: bot.edit_message_text("✅ Payment Approved!", chat_id=call.message.chat.id, message_id=call.message.message_id)
                except: pass
                
                cart = state.get("cart", {})
                ai_items = {pid: qty for pid, qty in cart.items() if PRODUCTS[pid].get("is_ai")}
                book_items = {pid: qty for pid, qty in cart.items() if not PRODUCTS[pid].get("is_ai")}
                
                prof_data = {}
                if os.path.exists(f"profiles/{target_uid}.json"):
                    try: 
                        prof_data = json.load(open(f"profiles/{target_uid}.json"))
                    except: pass
                user_name = state.get("ai_recipient") if ai_items else state.get("order_name", "User")
        
                if ai_items:
                    years = 1
                    safe_name = "".join(ch for ch in user_name if ch.isalnum())[:10].capitalize()
                    key = f"HK-AI-{safe_name}-{years}Y-" + "".join(random.choices(string.ascii_uppercase + string.digits, k=6))
                    exp_date = _dt.datetime.now() + _dt.timedelta(days=365 * int(years))
                    expires_iso = exp_date.isoformat()
                    
                    if not os.path.exists("data/paid_keys.json"): json.dump({}, open("data/paid_keys.json", "w"))
                    try: pk = json.load(open("data/paid_keys.json"))
                    except: pk = {}
                    pk[key] = {"user_id": target_uid, "name": user_name, "years": years, "order_id": state.get("order_id"), "purchase_date": _dt.datetime.now().isoformat(), "expires_at": expires_iso, "status": "ACTIVE"}
                    json.dump(pk, open("data/paid_keys.json", "w"), indent=2)
                    
                    if prof_data and user_name == prof_data.get("name"):
                        prof_data["activation_key"] = key
                        prof_data["secured"] = True
                        prof_data["is_trial"] = False
                        prof_data["is_paid"] = True
                        prof_data["paid_expiry"] = expires_iso
                        json.dump(prof_data, open(f"profiles/{target_uid}.json", "w"), indent=2)
                    
                    success_msg = f"🎉 <b>Payment Verified for Hamilton AI!</b>\n\n🔑 <b>Your Permanent Access Key:</b>\n<code>{key}</code>\n\n⚠️ <b>Important:</b> Contact the admin and share your payment screenshot for full guarantee.\n👉 <a href='https://wa.me/918074231426'>WhatsApp Admin</a>\n\n📢 <b>You can see your order proof here:</b>\n👉 <a href='https://t.me/HKonlinepurchasingproof'>HK Purchasing Proof</a>"
                    bot.send_message(target_uid, success_msg, parse_mode="HTML")
                    
                if book_items:
                    orders_data = _load_orders()
                    uid_str = str(target_uid)
                    if uid_str not in orders_data: orders_data[uid_str] = []
                    items_txt = ""
                    for pid, qty in book_items.items():
                        p = PRODUCTS[pid]
                        items_txt += f"- {p['name']} x{qty}\n"
                    
                    orders_data[uid_str].append({
                        "name": user_name,
                        "items": items_txt,
                        "total": state["total_amount"],
                        "delivery_date": state.get('delivery_date'),
                        "location": state.get('location'),
                        "status": "PENDING",
                        "contacted_admin": False,
                        "review": None,
                        "date": _dt.datetime.now().isoformat()
                    })
                    _save_orders(orders_data)
                    
                    receipt = f"🎉 <b>Payment Approved!</b>\n\n📦 <b>Items:</b>\n{items_txt}\n📅 <b>Expected Delivery:</b> {state.get('delivery_date')}\n📍 <b>Location:</b> {state.get('location')}\n\n📢 <b>You can see your order proof here:</b>\n👉 <a href='https://t.me/HKonlinepurchasingproof'>HK Purchasing Proof</a>"
                    bot.send_message(target_uid, receipt, parse_mode="HTML")
                try:
                    items_list = ""
                    for pid, qty in cart.items():
                        p = PRODUCTS[pid]
                        items_list += f"• {p['name']} (x{qty})\n"
                    proof_msg = (
                        f"✅ <b>PAYMENT VERIFIED & ORDER CONFIRMED</b>\n"
                        f"➖➖➖➖➖➖➖➖➖➖\n"
                        f"👤 <b>Customer:</b> {user_name}\n"
                        f"🏷 <b>Order ID:</b> <code>{state.get('order_id')}</code>\n"
                        f"💰 <b>Amount:</b> ₹{state.get('total_amount')}\n"
                        f"📦 <b>Items:</b>\n{items_list}"
                        f"➖➖➖➖➖➖➖➖➖➖\n"
                        f"📅 <b>Date:</b> {_dt.datetime.now().strftime('%d-%b-%Y %I:%M %p')}\n"
                        f"✅ <b>Status:</b> Verified & Processing"
                    )
                    bot.send_message(PROOF_CHANNEL, proof_msg, parse_mode="HTML")
                except Exception as e:
                    print(f"⚠️ Failed to post to Proof Channel: {e}")
                    
                STORE_STATE.pop(target_uid, None)
                
            elif action == "admin_reject":
                try: bot.edit_message_text("❌ Payment Rejected.", chat_id=call.message.chat.id, message_id=call.message.message_id)
                except: pass
                bot.send_message(target_uid, "❌ Your payment was rejected. Please contact admin.")

    except Exception as e:
        # SAFETY NET: If anything fails, tell the user!
        print(f"Shop error: {e}")
        bot.send_message(uid, f"⚠️ <b>System Error:</b> {e}")

@bot.message_handler(func=lambda m: m.chat.id in STORE_STATE and STORE_STATE[m.chat.id].get("waiting_for_name"), content_types=['text'])
def catch_store_name(message):
    uid = message.chat.id
    name = message.text.strip()[:40] if message.text else "Unknown"
    
    if not name:
        bot.send_message(uid, "❌ Name cannot be empty. Please enter again:")
        return
        
    state = _get_cart(uid)
    state["order_name"] = name
    state["waiting_for_name"] = False
    
    kb = InlineKeyboardMarkup(row_width=1)
    kb.add(InlineKeyboardButton("📍 Nellore (₹50)", callback_data="loc:Nellore"))
    kb.add(InlineKeyboardButton("🌍 Outside Nellore", callback_data="loc:Outside"))
    kb.add(InlineKeyboardButton("🔙 Cancel", callback_data="shop_buy"))
    
    msg = "✅ Name saved: <b>" + name + "</b>"
    msg += "\n\n📍 <b>Where do you want your order delivered?</b>"
    bot.send_message(uid, msg, parse_mode="HTML", reply_markup=kb)

@bot.message_handler(commands=['orders'])
def cmd_admin_orders(message):
    uid = message.chat.id
    if str(uid) != str(ADMIN_GROUP_ID) and uid != 8857708587:
        return
    
    orders = _load_orders()
    try: pk = json.load(open("data/paid_keys.json"))
    except: pk = {}
    
    completed = []
    for user_id, u_orders in orders.items():
        for o in u_orders:
            completed.append((user_id, o))
            
    completed.sort(key=lambda x: x[1].get('date', ''), reverse=True)
    recent = completed[:20]
    pending = [c for c in completed if not c[1].get('contacted_admin')]
    
    txt = "📊 <b>ADMIN DASHBOARD</b>\n➖➖➖➖➖➖➖➖\n\n"
    txt += "⏳ <b>PENDING (" + str(len(pending)) + "):</b>\n"
    if not pending:
        txt += "None\n"
    else:
        for uid_str, o in pending:
            txt += "👤 " + str(o.get('name', 'User')) + " (ID: " + str(uid_str) + ")\n"
            txt += "💰 ₹" + str(o.get('total')) + " | 📅 " + str(o.get('delivery')) + "\n"
            txt += "📍 " + str(o.get('location')) + "\n➖\n"
            
    txt += "\n✅ <b>COMPLETED (" + str(len(recent)) + "):</b>\n"
    for uid_str, o in recent:
        status = "✅" if o.get('contacted_admin') else "⚠️"
        txt += status + " " + str(o.get('name', 'User')) + " | ₹" + str(o.get('total')) + " | " + str(o.get('delivery')) + "\n"
        
    txt += "\n🤖 <b>TOTAL AI KEYS SOLD:</b> " + str(len(pk))
    
    bot.send_message(uid, txt, parse_mode="HTML")

def render_shop_menu(uid, msg_id):
    state = _get_cart(uid)
    cart = state["cart"]
    
    kb = InlineKeyboardMarkup(row_width=3)
    base_total = 0
    total_qty = 0
    
    for pid, p in PRODUCTS.items():
        qty = cart.get(pid, 0)
        base_total += p["price"] * qty
        total_qty += qty
        
        name_short = p['name'][:16]
        if qty == 0:
            kb.row(InlineKeyboardButton(f"{name_short} - ₹{p['price']}", callback_data=f"add_prod:{pid}"))
        else:
            kb.row(
                InlineKeyboardButton("[-]", callback_data=f"rem_prod:{pid}"),
                InlineKeyboardButton(f"{qty}x {name_short} (₹{p['price']*qty})", callback_data="ignore"),
                InlineKeyboardButton("[+]", callback_data=f"add_prod:{pid}")
            )
    
    discount = total_qty * 30
    final_total = max(0, base_total - discount)
    
    if total_qty > 0:
        kb.add(InlineKeyboardButton(f"✅ Checkout - ₹{final_total}", callback_data="checkout"))
        
    kb.add(InlineKeyboardButton("🔙 Back to Menu", callback_data="shop_main"))
    
    txt = "📚 <b>Select Products:</b>\nClick [+] to add."
    if total_qty > 0:
        txt += f"\n\n📦 Base Total: ₹{base_total}\n🎉 <b>YOU HAVE GOT A DISCOUNT FROM THE ONLINE PLATFORM!</b>\n🎁 Discount: <b>-₹{discount}</b>\n💰 <b>Total: ₹{final_total}</b>"
        
    try:
        if msg_id:
            bot.edit_message_text(txt, chat_id=uid, message_id=msg_id, parse_mode="HTML", reply_markup=kb)
        else:
            bot.send_message(uid, txt, parse_mode="HTML", reply_markup=kb)
    except: pass

def process_ai_recipient_name(message):
    uid = message.chat.id
    name = message.text.strip()[:30]
    state = _get_cart(uid)
    pid = state["pending_ai"]
    
    state["ai_recipient"] = name
    p = PRODUCTS[pid]
    cart = state["cart"]
    cart[pid] = cart.get(pid, 0) + 1
    
    msg = bot.send_message(uid, f"✅ Added <b>{p['name']}</b> for <b>{name}</b> to cart.")
    render_shop_menu(uid, msg.message_id)

def _add_ai_to_cart(uid, pid, call):
    state = _get_cart(uid)
    p = PRODUCTS[pid]
    cart = state["cart"]
    cart[pid] = cart.get(pid, 0) + 1
    render_shop_menu(uid, call.message.message_id)

def generate_qr(uid, total):
    import urllib.parse, requests, qrcode
    from io import BytesIO
    
    state = _get_cart(uid)
    order_id = f"HK_{uid}_{int(time.time())}"
    
    name = state.get("order_name", "Customer")
    api_res = create_fam_order(order_id, total, name)
    
    pay_url = None
    if api_res:
        # FamGateway returns different keys depending on the account setup
        pay_url = api_res.get("payment_url") or api_res.get("qr_url") or api_res.get("upi_link") or api_res.get("url")
        
    if not pay_url:
        # If API fails, we DO NOT use the old bank account. We show an error to admin.
        print("❌ [CRITICAL] FamGateway API did not return a payment URL.")
        bot.send_message(uid, "⚠️ <b>Payment Gateway is temporarily down.</b>\nPlease contact Admin to complete your order.")
        try:
            bot.send_message(ADMIN_GROUP_ID, f"🚨 <b>FAMGATEWAY API FAILED</b>\nCould not generate QR for Order {order_id}.\nCheck your API key or merchant account status.")
        except: pass
        return

    state["order_id"] = order_id
    state["total_amount"] = total
    state["qr_expiry"] = time.time() + 300 
    state["fam_api_active"] = True
    
    exp_time = (_dt.datetime.now() + _dt.timedelta(minutes=5)).strftime("%I:%M %p")
    
    cart_txt = ""
    for pid, qty in state["cart"].items():
        p = PRODUCTS[pid]
        cart_txt += f"  • {p['name']} (x{qty}) - ₹{p['price'] * qty}\n"
        
    caption = f"🧾 <b>OFFICIAL PAYMENT RECEIPT</b>\n"
    caption += f"➖➖➖➖➖➖➖➖➖➖➖➖\n"
    caption += f"👤 <b>Customer:</b> {name}\n"
    caption += f"🏷 <b>Order ID:</b> <code>{order_id}</code>\n"
    caption += f"📍 <b>Location:</b> {state.get('location', 'Nellore')}\n\n"
    caption += f"🛒 <b>Cart Details:</b>\n{cart_txt}\n"
    caption += f"💰 <b>Total Payable: ₹{total:.2f}</b>\n"
    caption += f"➖➖➖➖➖➖➖➖➖➖➖➖\n"
    caption += f"⏳ <b>Timer:</b> Valid till <b>{exp_time}</b> (5 mins)\n\n"
    caption += f"👇 <b>Scan the QR below to pay.</b>\nAfter payment, click <b>Verify Payment</b>."
    
    kb = InlineKeyboardMarkup()
    kb.add(InlineKeyboardButton("✅ Verify Payment", callback_data="verify_manual"))
    kb.add(InlineKeyboardButton("❌ Cancel", callback_data="cancel_order"))
    
    bio = None
    try:
        qr = qrcode.make(pay_url)
        bio = BytesIO()
        qr.save(bio, "PNG")
        bio.seek(0)
    except Exception:
        pass
            
    if bio:
        bot.send_photo(uid, bio, caption=caption, parse_mode="HTML", reply_markup=kb)
    else:
        bot.send_message(uid, caption + f"\n\n<a href='{pay_url}'>Click Here to Pay</a>", parse_mode="HTML", reply_markup=kb)

@bot.message_handler(content_types=['photo'], func=lambda m: m.chat.id in STORE_STATE)
def handle_payment_screenshot(message):
    uid = message.chat.id
    state = STORE_STATE.get(uid)
    if not state: return
    
    # Forward to Admin
    try:
        caption = f"🧾 <b>Payment Screenshot Received</b>\n👤 User: {state.get('order_name')}\n🏷 Order: {state.get('order_id')}\n💰 Amount: ₹{state.get('total_amount')}"
        kb = InlineKeyboardMarkup()
        kb.add(InlineKeyboardButton("✅ Approve Payment", callback_data=f"admin_approve:{uid}"))
        kb.add(InlineKeyboardButton("❌ Reject", callback_data=f"admin_reject:{uid}"))
        
        bot.send_photo(ADMIN_GROUP_ID, message.photo[-1].file_id, caption=caption, parse_mode="HTML", reply_markup=kb)
        bot.send_message(uid, "✅ Screenshot sent to Admin! Please wait for approval.")
    except Exception as e:
        bot.send_message(uid, f"⚠️ Error sending screenshot: {e}")



def delivery_update_worker():
    while True:
        time.sleep(3600) # Check every hour
        try:
            orders_data = _load_orders()
            today = _dt.date.today().isoformat()
            updated = False
            for uid_str, u_orders in orders_data.items():
                for o in u_orders:
                    if o.get("status") == "PENDING" and o.get("delivery_date") and o["delivery_date"] <= today:
                        o["status"] = "DELIVERED"
                        updated = True
                        try:
                            kb = InlineKeyboardMarkup()
                            kb.add(InlineKeyboardButton("⭐ Leave a Review", callback_data=f"review_start:{o['order_id']}"))
                            bot.send_message(int(uid_str), f"📦 <b>Your order {o.get('order_id', '')} has been delivered!</b>\n\nWe would love to hear your feedback.", reply_markup=kb, parse_mode="HTML")
                        except: pass
            if updated: _save_orders(orders_data)
        except: pass

try:
    threading.Thread(target=delivery_update_worker, daemon=True).start()
    print("✅ Delivery Auto-Update Worker Started")
except: pass

@bot.callback_query_handler(func=lambda c: c.data.startswith("review_start:"))
def start_review(call):
    uid = call.message.chat.id
    order_id = call.data.split(":")[1]
    try: bot.answer_callback_query(call.id)
    except: pass
    
    msg = bot.send_message(uid, "✍️ <b>Please type your review for this order:</b>", parse_mode="HTML")
    bot.register_next_step_handler(msg, save_review, order_id)

def save_review(message, order_id):
    uid = message.chat.id
    review_text = message.text.strip()
    
    orders_data = _load_orders()
    for o in orders_data.get(str(uid), []):
        if o.get("order_id") == order_id:
            o["review"] = review_text
            break
    _save_orders(orders_data)
    
    bot.send_message(uid, "✅ Thank you! Your review has been saved.")
    try:
        bot.send_message(ADMIN_GROUP_ID, f"⭐ <b>NEW REVIEW</b>\n👤 User: {uid}\n🏷 Order: {order_id}\n💬 {review_text}", parse_mode="HTML")
    except: pass

@bot.message_handler(func=lambda m: m.chat.id in STORE_STATE and m.text and not m.text.startswith('/'))
def intercept_shop_message(message):
    uid = message.chat.id
    if STORE_STATE[uid].get("waiting_for_name"): return
    
    kb = InlineKeyboardMarkup()
    kb.row(InlineKeyboardButton("🚪 Exit Shop", callback_data="shop_exit"), InlineKeyboardButton("↩️ Continue", callback_data="shop_continue"))
    bot.send_message(uid, "⚠️ <b>Are you sure?</b>\nYou are currently in the HK Publications Store. Do you want to exit or continue?", parse_mode="HTML", reply_markup=kb)

@bot.callback_query_handler(func=lambda c: c.data in ["shop_exit", "shop_continue"])
def handle_exit_continue(call):
    uid = call.message.chat.id
    try: bot.answer_callback_query(call.id)
    except: pass
    
    if call.data == "shop_exit":
        STORE_STATE.pop(uid, None)
        try: bot.delete_message(uid, call.message.message_id)
        except: pass
        bot.send_message(uid, "✅ You have exited the store. Type /shop to return anytime.")
    else:
        try: bot.delete_message(uid, call.message.message_id)
        except: pass
        cmd_shop(call.message)
