from config_fam import FAMGATEWAY_API_KEY, CREATE_ORDER_URL, CHECK_STATUS_URL

def create_fam_order(order_id, amount, name):
    import requests
    headers = {"Authorization": f"Bearer {FAMGATEWAY_API_KEY}", "Content-Type": "application/json"}
    payload = {"amount": str(amount), "order_id": order_id, "customer_name": name}
    try:
        r = requests.post(CREATE_ORDER_URL, json=payload, headers=headers, timeout=15)
        print(f"🔥 [FamGateway Response]: {r.status_code} - {r.text}")
        if r.status_code == 200:
            return r.json()
        return None
    except Exception as e:
        print(f"❌ [FamGateway Error]: {e}")
        return None

def check_fam_status(order_id):
    import requests
    url = f"{CHECK_STATUS_URL}?order_id={order_id}"
    try:
        r = requests.get(url, timeout=10)
        return r.json()
    except Exception as e:
        print(f"FamGateway Check Error: {e}")
        return None

