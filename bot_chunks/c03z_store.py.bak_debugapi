def _load_orders():
    if not os.path.exists(ORDERS_FILE): return {}
    try: return json.load(open(ORDERS_FILE))
    except: return {}

def _save_orders(data):
    os.makedirs("data", exist_ok=True)
    json.dump(data, open(ORDERS_FILE, "w"), indent=2)

def _get_cart(uid):
    if uid not in STORE_STATE: 
        STORE_STATE[uid] = {"cart": {}, "ai_recipient": None, "pending_ai": None, "qr_expiry": None, "final_amount": 0, "waiting_for_name": False}
    return STORE_STATE[uid]

def _get_ai_slots():
    try: pk = json.load(open("data/paid_keys.json"))
    except: pk = {}
    sold = len(pk)
    return max(0, 90 - sold), sold

def get_next_order_id():
    os.makedirs("data", exist_ok=True)
    counter_file = "data/order_counter.json"
    try:
        data = json.load(open(counter_file)) if os.path.exists(counter_file) else {"count": 0}
    except:
        data = {"count": 0}
    data["count"] += 1
    json.dump(data, open(counter_file, "w"))
    return f"HK-ORD-{str(data['count']).zfill(4)}"

def qr_expiry_worker():
    while True:
        time.sleep(10)
        now = time.time()
        for uid in list(STORE_STATE.keys()):
            state = STORE_STATE.get(uid)
            if state and state.get("qr_expiry") and now > state["qr_expiry"]:
                state["qr_expiry"] = None
                
                # Mark as expired so they can't verify
                order_id = state.get("order_id")
                
                try:
                    bot.send_message(uid, f"❌ <b>Scanner Expired!</b>\nOrder <code>{order_id}</code> has timed out (5 minutes).\n\nPlease click <b>Checkout</b> again to generate a fresh QR.", parse_mode="HTML")
                except: pass

try:
    threading.Thread(target=qr_expiry_worker, daemon=True).start()
except: pass


def auto_approve_order(uid, state, method):
    try:
        cart = state.get("cart", {})
        ai_items = {pid: qty for pid, qty in cart.items() if PRODUCTS[pid].get("is_ai")}
        book_items = {pid: qty for pid, qty in cart.items() if not PRODUCTS[pid].get("is_ai")}
        user_name = state.get("order_name", "User")
        
        if ai_items:
            import random, string
            years = 1
            safe_name = "".join(ch for ch in user_name if ch.isalnum())[:10].capitalize()
            key = f"HK-AI-{safe_name}-{years}Y-" + "".join(random.choices(string.ascii_uppercase + string.digits, k=6))
            exp_date = _dt.datetime.now() + _dt.timedelta(days=365 * int(years))
            
            if not os.path.exists("data/paid_keys.json"): json.dump({}, open("data/paid_keys.json", "w"))
            try: pk = json.load(open("data/paid_keys.json"))
            except: pk = {}
            pk[key] = {"user_id": uid, "name": user_name, "years": years, "order_id": state.get("order_id"), "purchase_date": _dt.datetime.now().isoformat(), "expires_at": exp_date.isoformat(), "status": "ACTIVE"}
            json.dump(pk, open("data/paid_keys.json", "w"), indent=2)
            
            success_msg = f"🎉 <b>Payment Verified ({method})!</b>\n\n🔑 <b>Your Key:</b>\n<code>{key}</code>\n\n👉 <a href='https://wa.me/918074231426'>Contact Admin</a>"
            bot.send_message(uid, success_msg, parse_mode="HTML")
            
        if book_items:
            orders_data = _load_orders()
            uid_str = str(uid)
            if uid_str not in orders_data: orders_data[uid_str] = []
            items_txt = "".join([f"- {PRODUCTS[pid]['name']} x{qty}\n" for pid, qty in book_items.items()])
            
            orders_data[uid_str].append({
                "name": user_name, "items": items_txt, "total": state["total_amount"],
                "delivery": state.get('delivery_date'), "location": state.get('location'),
                "status": "PAID", "contacted_admin": False, "date": _dt.datetime.now().isoformat()
            })
            _save_orders(orders_data)
            
            receipt = f"🎉 <b>Payment Verified ({method})!</b>\n\n📦 {items_txt}\n\n👉 <a href='https://wa.me/918074231426'>Contact Admin</a>"
            bot.send_message(uid, receipt, parse_mode="HTML")
            
        try:
            proof_msg = f"✅ <b>AUTO-VERIFIED ORDER</b>\n👤 {user_name}\n🏷 {state.get('order_id')}\n💰 ₹{state['total_amount']}"
            bot.send_message(PROOF_CHANNEL, proof_msg, parse_mode="HTML")
        except: pass
        
        STORE_STATE.pop(uid, None)
    except Exception as e:
        print(f"Approve error: {e}")


