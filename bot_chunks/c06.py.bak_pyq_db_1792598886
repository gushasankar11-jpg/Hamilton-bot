def _test_capture_papers(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip().lower()
    if "both" in t:
        p["_test_papers"] = 2
    elif "one" in t:
        p["_test_papers"] = 1
    else:
        bot.reply_to(message, "Tap One Paper or Both Papers.")
        return
    save_profile(uid, p)
    _test_prestart(uid)


