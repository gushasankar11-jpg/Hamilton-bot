@bot.callback_query_handler(func=lambda c: c.data.startswith("tq_num:"))
def _tq_num(call):
    uid = call.from_user.id
    state = bot._test_multi_state.get(uid)
    if not state: return
    ch = call.data.split(":")[1]
    
    if len(state.get("input", "")) < 30:
        state["input"] = state.get("input", "") + ch
        
    try:
        if state["type"] == "search":
            # Preserve current layout by checking existing message markup
            current_layout = "abc_upper" # Default
            # Hacky but works: check if message has small caps
            if call.message.reply_markup:
                for row in call.message.reply_markup.keyboard:
                    for btn in row:
                        if getattr(btn, "callback_data", "") == "tq_layout:abc_lower":
                            current_layout = "abc_upper"
                            break
                        if getattr(btn, "callback_data", "") == "tq_layout:abc_upper":
                            current_layout = "abc_lower"
                            break
            # Actually let's just keep it simple, re-render base based on what was clicked
            # To fix the "jumping to numbers" bug, we check if the char is a digit
            if ch.isdigit() or ch in "-/.,+=()":
                # If typing a number, stay in numbers if we were in numbers, else stay in abc
                # Best effort: if current display has letters, stay abc.
                layout = "num" if any(x.isdigit() for x in ch) and not any(x.isalpha() for x in state["input"][:-len(ch)]) else "abc_upper"
            else:
                layout = "abc_upper" if ch.isupper() else "abc_lower"
                
            # Better: store layout in state!
            layout = state.get("layout", "abc_upper")
            if ch.isdigit(): layout = "num"
            elif ch.isalpha(): layout = "abc_upper" if ch.isupper() else "abc_lower"
            
            state["layout"] = layout
            bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=_build_search_kb(uid, state["input"], layout))
        else:
            # Numeric test
            allow_dec = "decimal" in (state["q"].get("question", "").lower()) or True # Default allow for now
            bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=_build_numpad_kb(uid, state["input"]))
    except Exception as e: 
        print(f"[kb-render] {e}")
    bot.answer_callback_query(call.id)


