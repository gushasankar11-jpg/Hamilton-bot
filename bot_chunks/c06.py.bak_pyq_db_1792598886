def _finalize_test_answer(uid, msg_id, state, action):
    if not state: return
    q = state.get("q", {})
    if not isinstance(q, dict):
        print(f"[FINALIZE-ERROR] q is {type(q)}: {q}")
        bot._test_multi_state.pop(uid, None)
        try: bot.delete_message(uid, msg_id)
        except: pass
        safe_send(uid, "⚠️ Data error on this question. Skipping.")
        try: _send_next_test_q(uid)
        except: pass
        return
    exam = state["exam"]
    q_type = state["type"]
    is_correct = False
    user_answer = "SKIP"
    
    if action != "skip":
        if q_type == "mcq":
            sel = state["selected"]
            if not sel: return
            user_answer = list(sel)[0]
            is_correct = (ord(user_answer) - 65) == q.get("correct_index", 0)
        elif q_type == "multi":
            sel = state["selected"]
            if not sel: return
            user_answer = ",".join(sorted(sel))
            is_correct = (set(ord(x) - 65 for x in sel) == set(q.get("correct_indices", [])))
        elif q_type == "numerical":
            user_answer = state.get("input", "")
            try:
                val = eval(user_answer) if '/' in user_answer else float(user_answer)
                correct = float(q.get("correct_value", 0))
                is_correct = round(val, 2) == round(correct, 2) if exam == "JEE_ADV" else round(val) == round(correct)
            except: pass
        elif q_type == "matching":
            pairs = state.get("pairs", {})
            if not pairs: return
            user_answer = str(pairs)
            # Safety check: q might not be a dict
            if not isinstance(q, dict):
                print("[match-err] q is not a dict:", type(q))
                return
            correct_map = q.get("correct_match", {})
            if not isinstance(correct_map, dict):
                print("[match-err] correct_map is not a dict:", type(correct_map))
                return
            is_correct = all(correct_map.get(k) == v for k, v in pairs.items()) and len(pairs) == len(correct_map)
    
    try:
        sess = exam_engine.get_session(uid)
        if sess:
            sess["plan_index"] = sess.get("plan_index", 0) + 1
            if action == "skip": sess["skipped"] = sess.get("skipped", 0) + 1
            elif is_correct: sess["correct"] = sess.get("correct", 0) + 1
            else: sess["wrong"] = sess.get("wrong", 0) + 1
    except: pass
    
    bot._test_multi_state.pop(uid, None)
    try: bot.delete_message(uid, msg_id)
    except: pass
    
    icon = "⏭" if action == "skip" else ("✅" if is_correct else "❌")
    safe_send(uid, f"{icon} *Recorded:* {user_answer}", parse_mode="Markdown")
    
    try: _send_next_test_q(uid)
    except Exception as e: print(f"[finalize-next] {e}")

