# Sub-admin sub-flow: new vs registered
# ----------------------------------------------------------
def _cb_sub_new(call):
    # Neutralized — handled by c30v_subadmin_v2
    return


def _cb_sub_reg(call):
    uid = call.message.chat.id
    try:
        bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except Exception:
        pass

    if not auth.is_sub_admin_registered(uid):
        safe_send(uid,
            "❌ This device is *not registered*.\n\n"
            "Please tap *New Device* on the previous step.",
            parse_mode="Markdown")
        return

    _set_pending(uid, "sub_priv")
    safe_send(uid, "Please enter your *privacy code*.", parse_mode="Markdown")


