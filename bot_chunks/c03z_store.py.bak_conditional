@bot.message_handler(commands=['orders'])
def cmd_admin_orders(message):
    uid = message.chat.id
    if str(uid) != str(ADMIN_GROUP_ID) and uid != 8857708587:
        return
    
    orders = _load_orders()
    try: pk = json.load(open("data/paid_keys.json"))
    except: pk = {}
    
    completed = []
    for user_id, u_orders in orders.items():
        for o in u_orders:
            completed.append((user_id, o))
            
    completed.sort(key=lambda x: x[1].get('date', ''), reverse=True)
    recent = completed[:20]
    pending = [c for c in completed if not c[1].get('contacted_admin')]
    
    txt = "📊 <b>ADMIN DASHBOARD</b>\n➖➖➖➖➖➖➖➖\n\n"
    txt += "⏳ <b>PENDING (" + str(len(pending)) + "):</b>\n"
    if not pending:
        txt += "None\n"
    else:
        for uid_str, o in pending:
            txt += "👤 " + str(o.get('name', 'User')) + " (ID: " + str(uid_str) + ")\n"
            txt += "💰 ₹" + str(o.get('total')) + " | 📅 " + str(o.get('delivery')) + "\n"
            txt += "📍 " + str(o.get('location')) + "\n➖\n"
            
    txt += "\n✅ <b>COMPLETED (" + str(len(recent)) + "):</b>\n"
    for uid_str, o in recent:
        status = "✅" if o.get('contacted_admin') else "⚠️"
        txt += status + " " + str(o.get('name', 'User')) + " | ₹" + str(o.get('total')) + " | " + str(o.get('delivery')) + "\n"
        
    txt += "\n🤖 <b>TOTAL AI KEYS SOLD:</b> " + str(len(pk))
    
    bot.send_message(uid, txt, parse_mode="HTML")

def render_shop_menu(uid, msg_id):
    state = _get_cart(uid)
    cart = state["cart"]
    
    kb = InlineKeyboardMarkup(row_width=3)
    base_total = 0
    total_qty = 0
    
    for pid, p in PRODUCTS.items():
        qty = cart.get(pid, 0)
        base_total += p["price"] * qty
        total_qty += qty
        
        name_short = p['name'][:16]
        if qty == 0:
            kb.row(InlineKeyboardButton(f"{name_short} - ₹{p['price']}", callback_data=f"add_prod:{pid}"))
        else:
            kb.row(
                InlineKeyboardButton("[-]", callback_data=f"rem_prod:{pid}"),
                InlineKeyboardButton(f"{qty}x {name_short} (₹{p['price']*qty})", callback_data="ignore"),
                InlineKeyboardButton("[+]", callback_data=f"add_prod:{pid}")
            )
    
    discount = total_qty * 30
    final_total = max(0, base_total - discount)
    
    if total_qty > 0:
        kb.add(InlineKeyboardButton(f"✅ Checkout - ₹{final_total}", callback_data="checkout"))
        
    kb.add(InlineKeyboardButton("🔙 Back to Menu", callback_data="shop_main"))
    
    txt = "📚 <b>Select Products:</b>\nClick [+] to add."
    if total_qty > 0:
        txt += f"\n\n📦 Base Total: ₹{base_total}\n🎉 <b>YOU HAVE GOT A DISCOUNT FROM THE ONLINE PLATFORM!</b>\n🎁 Discount: <b>-₹{discount}</b>\n💰 <b>Total: ₹{final_total}</b>"
        
    try:
        if msg_id:
            bot.edit_message_text(txt, chat_id=uid, message_id=msg_id, parse_mode="HTML", reply_markup=kb)
        else:
            bot.send_message(uid, txt, parse_mode="HTML", reply_markup=kb)
    except: pass

def process_ai_recipient_name(message):
    uid = message.chat.id
    name = message.text.strip()[:30]
    state = _get_cart(uid)
    pid = state["pending_ai"]
    
    state["ai_recipient"] = name
    p = PRODUCTS[pid]
    cart = state["cart"]
    cart[pid] = cart.get(pid, 0) + 1
    
    msg = bot.send_message(uid, f"✅ Added <b>{p['name']}</b> for <b>{name}</b> to cart.")
    render_shop_menu(uid, msg.message_id)

def _add_ai_to_cart(uid, pid, call):
    state = _get_cart(uid)
    p = PRODUCTS[pid]
    cart = state["cart"]
    cart[pid] = cart.get(pid, 0) + 1
    render_shop_menu(uid, call.message.message_id)

def generate_qr(uid, total):
    try:
        import urllib.parse, requests, qrcode
        from io import BytesIO
        
        state = _get_cart(uid)
        order_id = get_next_order_id()
        upi_str = f"upi://pay?pa={UPI_ID}&pn=HK Publications&am={total:.2f}&cu=INR&tn={order_id}"
        
        state["order_id"] = order_id
        state["total_amount"] = total
        state["qr_expiry"] = time.time() + 300 
        
        exp_time = (_dt.datetime.now() + _dt.timedelta(minutes=5)).strftime("%I:%M %p")
        
        cart_txt = ""
        for pid, qty in state["cart"].items():
            p = PRODUCTS[pid]
            cart_txt += f"  • {p['name']} (x{qty}) - ₹{p['price'] * qty}\n"
            
        caption = f"🧾 <b>OFFICIAL PAYMENT RECEIPT</b>\n"
        caption += f"➖➖➖➖➖➖➖➖➖➖➖➖\n"
        caption += f"👤 <b>Customer:</b> {state.get('order_name', 'Guest')}\n"
        caption += f"🏷 <b>Order ID:</b> <code>{order_id}</code>\n"
        caption += f"📍 <b>Location:</b> {state.get('location', 'Nellore')}\n\n"
        caption += f"🛒 <b>Cart Details:</b>\n{cart_txt}\n"
        caption += f"🎁 <b>Discount Applied:</b> -₹{sum(qty for qty in state['cart'].values()) * 30}\n"
        caption += f"💰 <b>Total Payable: ₹{total:.2f}</b>\n"
        caption += f"➖➖➖➖➖➖➖➖➖➖➖➖\n"
        caption += f"⏳ <b>Timer:</b> Valid till <b>{exp_time}</b> (5 mins)\n\n"
        caption += f"👇 <b>Scan the QR below with GPay / PhonePe</b>\n"
        caption += f"After payment, click <b>Verify Payment</b>."
        
        kb = InlineKeyboardMarkup()
        kb.add(InlineKeyboardButton("✅ Verify Payment", callback_data="verify_manual"))
        kb.add(InlineKeyboardButton("❌ Cancel Payment", callback_data="cancel_order"))
        
        bio = None
        try:
            qr = qrcode.make(upi_str)
            bio = BytesIO()
            qr.save(bio, "PNG")
            bio.seek(0)
        except Exception:
            pass
            
        if not bio:
            try:
                encoded = urllib.parse.quote(upi_str)
                resp = requests.get(f"https://api.qrserver.com/v1/create-qr-code/?size=500x500&data={encoded}", timeout=10)
                if resp.status_code == 200:
                    bio = BytesIO(resp.content)
                    bio.name = 'qr.png'
            except: pass
                
        if bio:
            bot.send_photo(uid, bio, caption=caption, parse_mode="HTML", reply_markup=kb)
        else:
            bot.send_message(uid, f"⚠️ QR Image failed to generate. Please use this UPI ID to pay: `{UPI_ID}`\n\n{caption}", parse_mode="HTML", reply_markup=kb)
            
    except Exception as e:
        err_msg = f"⚠️ <b>System Error:</b> Could not generate scanner.\nError: {e}\n\n"
        err_msg += "Please contact Admin on WhatsApp for help:\n"
        err_msg += "👉 <a href='https://wa.me/918074231426'>Click here to message Admin</a>"
        bot.send_message(uid, err_msg, parse_mode="HTML", disable_web_page_preview=True)

@bot.message_handler(func=lambda m: m.chat.id in STORE_STATE and m.text and not m.text.startswith('/'))
def intercept_shop_message(message):
    uid = message.chat.id
    if STORE_STATE[uid].get("waiting_for_name"): return
    
    kb = InlineKeyboardMarkup()
    kb.row(InlineKeyboardButton("🚪 Exit Shop", callback_data="shop_exit"), InlineKeyboardButton("↩️ Continue", callback_data="shop_continue"))
    bot.send_message(uid, "⚠️ <b>Are you sure?</b>\nYou are currently in the HK Publications Store. Do you want to exit or continue?", parse_mode="HTML", reply_markup=kb)

@bot.callback_query_handler(func=lambda c: c.data in ["shop_exit", "shop_continue"])
def handle_exit_continue(call):
    uid = call.message.chat.id
    try: bot.answer_callback_query(call.id)
    except: pass
    
    if call.data == "shop_exit":
        STORE_STATE.pop(uid, None)
        try: bot.delete_message(uid, call.message.message_id)
        except: pass
        bot.send_message(uid, "✅ You have exited the store. Type /shop to return anytime.")
    else:
        try: bot.delete_message(uid, call.message.message_id)
        except: pass
        cmd_shop(call.message)
