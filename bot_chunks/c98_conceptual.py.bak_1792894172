import json
import time
from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton

_c_state = {}

# DEAD_CONCEPT
def cmd_conceptual(message):
    uid = message.chat.id
    _c_state[uid] = {"answered": 0, "covered": []}
    kb = InlineKeyboardMarkup(row_width=3)
    kb.add(
        InlineKeyboardButton("Physics", callback_data="c_mode:Physics"),
        InlineKeyboardButton("Chemistry", callback_data="c_mode:Chemistry"),
        InlineKeyboardButton("Maths", callback_data="c_mode:Maths")
    )
    bot.send_message(uid, "🧠 *Conceptual Engine*\n\nSelect Subject (No limits, full formula coverage):", parse_mode="Markdown", reply_markup=kb)

@bot.callback_query_handler(func=lambda c: c.data.startswith("c_mode:"))
def cb_c_mode(call):
    uid = call.from_user.id
    subj = call.data.split(":")[1]
    _c_state[uid]["subj"] = subj
    
    fn = f"data/jee_adv_{subj.lower()}.json"
    try:
        with open(fn) as f: chapters = list(json.load(f).keys())
    except: chapters = ["Trigonometric Functions"]
        
    _c_state[uid]["chapters"] = chapters
    _c_state[uid]["page"] = 0
    _show_c_chapters(uid, call.message.message_id)
    bot.answer_callback_query(call.id, "Subject Selected")

def _show_c_chapters(uid, msg_id):
    chapters = _c_state[uid]["chapters"]
    page = _c_state[uid]["page"]
    start, end = page * 5, (page + 1) * 5
    
    kb = InlineKeyboardMarkup(row_width=1)
    for ch in chapters[start:end]:
        kb.add(InlineKeyboardButton(ch[:25], callback_data=f"c_ch:{ch}"))
        
    nav = []
    if page > 0: nav.append(InlineKeyboardButton("⬅️ Prev", callback_data="c_page:-1"))
    if end < len(chapters): nav.append(InlineKeyboardButton("Next ➡️", callback_data="c_page:1"))
    if nav: kb.row(*nav)
    
    try: bot.edit_message_text("📚 Select Chapter:", chat_id=uid, message_id=msg_id, reply_markup=kb)
    except: pass

@bot.callback_query_handler(func=lambda c: c.data.startswith("c_page:"))
def cb_c_page(call):
    uid = call.from_user.id
    _c_state[uid]["page"] += int(call.data.split(":")[1])
    _show_c_chapters(uid, call.message.message_id)
    bot.answer_callback_query(call.id)

@bot.callback_query_handler(func=lambda c: c.data.startswith("c_ch:"))
def cb_c_ch(call):
    uid = call.from_user.id
    ch = call.data.split(":", 1)[1]
    _c_state[uid]["chapter"] = ch
    try: bot.edit_message_text("⏳ Analyzing formulas and generating Q1...", chat_id=uid, message_id=call.message.message_id)
    except: pass
    bot.answer_callback_query(call.id, "Scanning concepts...")
    _gen_c_q(uid)

def _gen_c_q(uid):
    state = _c_state[uid]
    import ai_client
    
    covered_str = ", ".join(state["covered"][-10:])
    
    prompt = f"You are an elite JEE teacher creating a CONCEPTUAL DRILL for chapter '{state['chapter']}'.\n"
    prompt += "Your goal is to test EVERY formula, condition, and edge case.\n"
    prompt += "Format: You must use a mix of Assertion-Reason, Statement-1/2, Multi-correct, Matching, and Direct Formula questions.\n"
    prompt += "Timers: 15s for direct formulas, 45s for deep reasoning.\n"
    prompt += f"DO NOT REPEAT THESE ALREADY COVERED CONCEPTS: {covered_str}\n"
    prompt += "Output strictly as JSON: {\"question\":\"...\", \"type\":\"...\", \"options\":[\"A\",\"B\",\"C\",\"D\"], \"correct_index\":0, \"explanation\":\"...\", \"timer\":15}"
    
    raw = ai_client._call_groq(0, "Output ONLY valid JSON.", prompt, max_tokens=1000, temperature=0.7)
    
    try:
        import re
        txt = raw.strip()
        if txt.startswith("```"): txt = re.sub(r"^```(?:json)?\s*", "", txt); txt = re.sub(r"\s*```\s*$", "", txt)
        first, last = txt.find("{"), txt.rfind("}")
        q = json.loads(txt[first:last+1])
        
        # Save to avoid repeats
        state["covered"].append(q.get("type", "concept") + ": " + q.get("question", "")[:30])
        state["q"] = q
        state["selected"] = None
        state["answered"] += 1
        
        qtext = str(q.get("question", ""))
        if hasattr(ai_client, 'postprocess_ai_output'): qtext = ai_client.postprocess_ai_output(qtext)
            
        body = f"<b>[Concept {state['answered']} | {state['chapter']}]</b>\n⏱️ <i>Ideal Time: {q.get('timer', 15)}s</i>\n\n{qtext}\n\n<pre>"
        for i, opt in enumerate(q.get("options", [])[:4]):
            opt_c = str(opt)
            if hasattr(ai_client, 'postprocess_ai_output'): opt_c = ai_client.postprocess_ai_output(opt_c)
            body += f"{chr(65+i)}) {opt_c}\n"
        body += "</pre>"
        
        kb = _build_c_kb(uid, len(q.get("options", [])))
        bot.send_message(uid, body, parse_mode="HTML", reply_markup=kb)
        
    except Exception as e:
        bot.send_message(uid, f"❌ Generation error: {e}")

def _build_c_kb(uid, n):
    sel = _c_state.get(uid, {}).get("selected")
    kb = InlineKeyboardMarkup(row_width=4)
    row = [InlineKeyboardButton(f"{'✅' if i == sel else ''}{chr(65+i)}", callback_data=f"c_ans:{i}") for i in range(min(4, n))]
    kb.row(*row)
    kb.row(InlineKeyboardButton("✔️ Save", callback_data="c_save"), InlineKeyboardButton("⏭ Skip", callback_data="c_skip"))
    return kb

@bot.callback_query_handler(func=lambda c: c.data.startswith("c_ans:"))
def cb_c_ans(call):
    uid = call.from_user.id
    _c_state[uid]["selected"] = int(call.data.split(":")[1])
    try: bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=_build_c_kb(uid, 4))
    except: pass
    bot.answer_callback_query(call.id, "Selected")

@bot.callback_query_handler(func=lambda c: c.data == "c_save")
def cb_c_save(call):
    uid = call.from_user.id
    state = _c_state.get(uid, {})
    if state.get("selected") is None:
        bot.answer_callback_query(call.id, "Select an option!")
        return
        
    import ai_client
    is_correct = state["selected"] == state["q"].get("correct_index", 0)
    bot.answer_callback_query(call.id, "✅ Correct!" if is_correct else "❌ Wrong!")
    
    msg = "✅ *Correct!*\n\n" if is_correct else "❌ *Wrong.*\n\n"
    exp = str(state["q"].get("explanation", ""))
    if exp and hasattr(ai_client, 'postprocess_ai_output'): exp = ai_client.postprocess_ai_output(exp)
    bot.send_message(uid, msg + exp, parse_mode="Markdown")
    try: bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except: pass
    
    # Auto next
    _gen_c_q(uid)

@bot.callback_query_handler(func=lambda c: c.data == "c_skip")
def cb_c_skip(call):
    uid = call.from_user.id
    bot.answer_callback_query(call.id, "Skipped")
    try: bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except: pass
    _gen_c_q(uid)

