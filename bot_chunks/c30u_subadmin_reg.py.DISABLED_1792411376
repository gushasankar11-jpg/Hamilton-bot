import admin_auth as _sar_auth


def _sar_get_pending(uid):
    for _mn, _mo in __import__("sys").modules.items():
        if hasattr(_mo, "PENDING_AUTH_FLOW"):
            return _mo.PENDING_AUTH_FLOW
    return None


def _sar_pending_action(message):
    try:
        uid = message.chat.id
        pf = _sar_get_pending(uid)
        if not pf or uid not in pf:
            return None
        act = pf[uid].get("action")
        if act in ("sub_new_name", "sub_new_privacy", "sub_new_forgot"):
            return act
        return None
    except Exception:
        return None


@bot.message_handler(func=_sar_pending_action, content_types=['text'])
def _sar_text_router(message):
    uid = message.chat.id
    pf = _sar_get_pending(uid)
    if not pf or uid not in pf:
        return
    act = pf[uid].get("action")
    txt = (message.text or "").strip()
    if not txt or txt.startswith("/"):
        return

    if act == "sub_new_name":
        if len(txt) < 2:
            safe_send(uid, "Name too short (min 2). Try again:")
            return
        pf[uid] = {
            "action": "sub_new_privacy",
            "name": txt[:60],
            "at": __import__("time").time(),
        }
        safe_send(uid,
            "🔐 *Step 4/5: Set privacy password*\\n\\n"
            "This is your login password. Type it below (min 4 chars):",
            parse_mode="Markdown")
        return

    if act == "sub_new_privacy":
        if len(txt) < 4:
            safe_send(uid, "Too short (min 4 chars). Try again:")
            return
        pf[uid] = {
            "action": "sub_new_forgot",
            "name": pf[uid].get("name", "Sub-Admin"),
            "privacy": txt,
            "at": __import__("time").time(),
        }
        safe_send(uid,
            "🗝 *Step 5/5: Set forgot-password key*\\n\\n"
            "If you ever forget your privacy password, enter this key to reset.\\n"
            "Min 6 chars. Keep it secret.",
            parse_mode="Markdown")
        return

    if act == "sub_new_forgot":
        if len(txt) < 6:
            safe_send(uid, "Forgot key too short (min 6). Try again:")
            return
        name = pf[uid].get("name", "Sub-Admin")
        privacy = pf[uid].get("privacy", "")
        try:
            # Register first (privacy)
            _sar_auth.register_sub_admin(uid, name, privacy)
            # Then store forgot key hash
            _cfg = _sar_auth._load_config()
            _entry = _cfg.get("sub_admins", {}).get(str(uid))
            if _entry is not None:
                try:
                    _fh, _fs = _sar_auth._hash_secret(txt)
                    _entry["reset_hash"] = _fh
                    _entry["reset_salt"] = _fs
                    _sar_auth._save_config(_cfg)
                except Exception as _eh:
                    print(f"[sar] forgot-hash err: {_eh}")
            _sar_auth.start_session(uid, "sub")
            _sar_auth.update_sub_admin_last_seen(uid)
            _sar_auth.audit("sub_login_ok", uid, {"name": name})
            pf.pop(uid, None)
            safe_send(uid,
                "✅ *Sub-admin registered!*\\n\\n"
                f"👤 {name}\\n"
                "🛡 Read-only observer access\\n"
                "🔐 Privacy + forgot key stored\\n\\n"
                "Opening panel...",
                parse_mode="Markdown")
            _show_sub = globals().get("_show_sub_admin_panel")
            if _show_sub:
                _show_sub(uid)
            print(f"[sar] registered sub-admin {uid} name={name}")
        except Exception as e:
            print(f"[sar] register fail: {e}")
            safe_send(uid, f"⚠️ Error: {str(e)[:100]}")
        return


print("c30u_subadmin_reg: loaded (5-step flow).")
