# ==========================================================
# c02w_mode_wizard.py — /mode = exam configuration wizard
# Multi-select → priority → marks → year. No mode confusion.
# ==========================================================
import admin_auth as _mw_auth

_MODE_WIZARD_STATE = {}


def _mw_exams_list():
    try:
        from config import EXAM_NAMES
        return list(EXAM_NAMES.items())  # [(key, name), ...]
    except Exception:
        return [("JEE_ADV", "JEE Advanced"), ("JEE_MAIN", "JEE Mains"), ("EAMCET", "EAMCET")]


def _mw_exam_name(key):
    for k, v in _mw_exams_list():
        if k == key:
            return v
    return key


def _mw_exam_total(key):
    totals = {"JEE_ADV": 360, "JEE_MAIN": 300, "EAMCET": 160}
    return totals.get(key, 100)


def _mw_build_selector(selected, uid):
    from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
    kb = InlineKeyboardMarkup(row_width=2)
    exams = _mw_exams_list()
    row = []
    for key, name in exams:
        mark = "✅ " if key in selected else "⬜ "
        row.append(InlineKeyboardButton(f"{mark}{name}", callback_data=f"mw_toggle:{key}"))
    # 2 per row
    for i in range(0, len(row), 2):
        if i + 1 < len(row):
            kb.row(row[i], row[i + 1])
        else:
            kb.row(row[i])
    kb.add(InlineKeyboardButton("✅ Done", callback_data="mw_done"))
    return kb


def _mw_build_selector_text(selected):
    lines = ["\U0001f4da *Configure Your Exams*", ""]
    lines.append("*Step 1/4 — Which exams are you writing?*")
    lines.append("_Tap to toggle. Multi-select allowed._")
    lines.append("")
    if selected:
        lines.append(f"Selected: *{len(selected)}*")
        for k in selected:
            lines.append(f"  \u2022 {_mw_exam_name(k)}")
    else:
        lines.append("_Nothing selected yet._")
    return "\n".join(lines)


@bot.message_handler(commands=['mode'])
def _mw_cmd_mode(message):
    uid = message.chat.id
    try:
        ready, reason = _profile_ready(uid)
        if not ready:
            _send_setup_prompt(uid, reason)
            return
    except Exception as _e:
        print(f"[mw-mode] profile err: {_e}")
    
    p = load_profile(uid)
    existing = p.get("exams") or []
    
    _MODE_WIZARD_STATE[uid] = {
        "step": "select",
        "selected": set(existing),
        "priority": p.get("priority"),
        "target_marks": dict(p.get("target_marks") or {}),
        "target_year": p.get("target_year"),
    }
    
    text = _mw_build_selector_text(set(existing))
    kb = _mw_build_selector(set(existing), uid)
    msg = bot.send_message(uid, text, parse_mode="Markdown", reply_markup=kb)
    print(f"[mw] {uid} → wizard start")


@bot.callback_query_handler(func=lambda c: c.data.startswith("mw_toggle:"))
def _mw_cb_toggle(call):
    uid = call.from_user.id
    st = _MODE_WIZARD_STATE.get(uid)
    if not st:
        bot.answer_callback_query(call.id, "Wizard expired. Send /mode again.")
        return
    try:
        key = call.data.split(":")[1]
    except Exception:
        return
    sel = st["selected"]
    if key in sel:
        sel.remove(key)
    else:
        sel.add(key)
    st["selected"] = sel
    _MODE_WIZARD_STATE[uid] = st
    text = _mw_build_selector_text(sel)
    kb = _mw_build_selector(sel, uid)
    try:
        bot.edit_message_text(text, chat_id=uid, message_id=call.message.message_id, reply_markup=kb, parse_mode="Markdown")
    except Exception:
        pass
    bot.answer_callback_query(call.id, f"{len(sel)} selected")


@bot.callback_query_handler(func=lambda c: c.data == "mw_done")
def _mw_cb_done(call):
    uid = call.from_user.id
    st = _MODE_WIZARD_STATE.get(uid)
    if not st:
        bot.answer_callback_query(call.id, "Wizard expired.")
        return
    sel = st["selected"]
    if not sel:
        bot.answer_callback_query(call.id, "Select at least one exam")
        return
    
    # If only one exam — jump straight to marks
    if len(sel) == 1:
        only = list(sel)[0]
        st["priority"] = only
        st["step"] = "marks"
        st["marks_queue"] = [only]
        _MODE_WIZARD_STATE[uid] = st
        _mw_ask_next_mark(uid, call.message.message_id)
        return
    
    # Multiple — ask priority
    from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
    kb = InlineKeyboardMarkup(row_width=1)
    for k in sel:
        kb.add(InlineKeyboardButton(_mw_exam_name(k), callback_data=f"mw_prio:{k}"))
    text = (
        "\U0001f4da *Configure Your Exams*\n\n"
        "*Step 2/4 — Which is your PRIORITY exam?*\n"
        "_Notes, plan, short notes will focus on this exam._"
    )
    st["step"] = "priority"
    _MODE_WIZARD_STATE[uid] = st
    try:
        bot.edit_message_text(text, chat_id=uid, message_id=call.message.message_id, reply_markup=kb, parse_mode="Markdown")
    except Exception:
        pass


@bot.callback_query_handler(func=lambda c: c.data.startswith("mw_prio:"))
def _mw_cb_prio(call):
    uid = call.from_user.id
    st = _MODE_WIZARD_STATE.get(uid)
    if not st:
        return
    try:
        key = call.data.split(":")[1]
    except Exception:
        return
    st["priority"] = key
    st["step"] = "marks"
    # Queue all selected exams for marks prompt
    st["marks_queue"] = list(st["selected"])
    _MODE_WIZARD_STATE[uid] = st
    _mw_ask_next_mark(uid, call.message.message_id)


def _mw_ask_next_mark(uid, msg_id=None):
    st = _MODE_WIZARD_STATE.get(uid)
    if not st:
        return
    queue = st.get("marks_queue") or []
    if not queue:
        # All marks collected — ask year
        _mw_ask_year(uid, msg_id)
        return
    current = queue[0]
    total = _mw_exam_total(current)
    name = _mw_exam_name(current)
    text = (
        f"\U0001f4da *Configure Your Exams*\n\n"
        f"*Step 3/4 — Target marks for {name}*\n\n"
        f"Total: *{total}*\n"
        f"Send a number between 1 and {total}:"
    )
    if msg_id:
        try:
            bot.edit_message_text(text, chat_id=uid, message_id=msg_id, parse_mode="Markdown")
        except Exception:
            pass
    else:
        safe_send(uid, text, parse_mode="Markdown")
    # Next step: wait for text input — use _MODE_WIZARD_STATE.step = "await_mark"
    st["step"] = "await_mark"
    _MODE_WIZARD_STATE[uid] = st


@bot.message_handler(func=lambda m: (
    m.chat.id in _MODE_WIZARD_STATE and
    _MODE_WIZARD_STATE[m.chat.id].get("step") == "await_mark"
), content_types=['text'])
def _mw_catch_mark(message):
    uid = message.chat.id
    st = _MODE_WIZARD_STATE.get(uid)
    if not st:
        return
    txt = (message.text or "").strip()
    queue = st.get("marks_queue") or []
    if not queue:
        _MODE_WIZARD_STATE.pop(uid, None)
        return
    current = queue[0]
    total = _mw_exam_total(current)
    name = _mw_exam_name(current)
    try:
        val = int(txt)
        if val < 1 or val > total:
            bot.reply_to(message, f"\u274c Enter 1\u2013{total}:")
            return
    except Exception:
        bot.reply_to(message, f"\u274c Invalid number. Enter 1\u2013{total}:")
        return
    st["target_marks"][current] = val
    st["marks_queue"] = queue[1:]
    _MODE_WIZARD_STATE[uid] = st
    _mw_ask_next_mark(uid)


def _mw_ask_year(uid, msg_id=None):
    from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton
    st = _MODE_WIZARD_STATE.get(uid)
    if not st:
        return
    st["step"] = "await_year"
    _MODE_WIZARD_STATE[uid] = st
    kb = InlineKeyboardMarkup(row_width=3)
    kb.add(
        InlineKeyboardButton("2026", callback_data="mw_year:2026"),
        InlineKeyboardButton("2027", callback_data="mw_year:2027"),
        InlineKeyboardButton("2028", callback_data="mw_year:2028"),
    )
    text = (
        "\U0001f4da *Configure Your Exams*\n\n"
        "*Step 4/4 — Which year are you writing?*"
    )
    if msg_id:
        try:
            bot.edit_message_text(text, chat_id=uid, message_id=msg_id, reply_markup=kb, parse_mode="Markdown")
        except Exception:
            pass
    else:
        safe_send(uid, text, parse_mode="Markdown", reply_markup=kb)


@bot.callback_query_handler(func=lambda c: c.data.startswith("mw_year:"))
def _mw_cb_year(call):
    uid = call.from_user.id
    st = _MODE_WIZARD_STATE.get(uid)
    if not st:
        return
    try:
        year = int(call.data.split(":")[1])
    except Exception:
        return
    st["target_year"] = year
    # Save everything to profile
    p = load_profile(uid)
    p["exams"] = sorted(st["selected"])
    p["priority"] = st["priority"]
    p["priority_pct"] = 70  # default, unused
    p["target_marks"] = st["target_marks"]
    p["target_year"] = year
    save_profile(uid, p)
    _MODE_WIZARD_STATE.pop(uid, None)
    # Summary
    from config import EXAM_NAMES
    prio_name = _mw_exam_name(st["priority"])
    lines = ["\u2705 *Configuration Saved!*", ""]
    lines.append(f"\U0001f3af *Priority:* {prio_name}")
    lines.append(f"\U0001f4c5 *Year:* {year}")
    lines.append("")
    lines.append("*Your exams & targets:*")
    for k in sorted(st["selected"]):
        name = _mw_exam_name(k)
        marks = st["target_marks"].get(k, 0)
        total = _mw_exam_total(k)
        star = "\u2b50" if k == st["priority"] else "  "
        lines.append(f"{star} {name}: *{marks}/{total}*")
    lines.append("")
    lines.append("_Type /mode anytime to reconfigure._")
    text = "\n".join(lines)
    try:
        bot.edit_message_text(text, chat_id=uid, message_id=call.message.message_id, parse_mode="Markdown")
    except Exception:
        safe_send(uid, text, parse_mode="Markdown")
    print(f"[mw] {uid} saved exams={p['exams']} prio={p['priority']} year={year}")


print("c02w_mode_wizard: loaded.")
