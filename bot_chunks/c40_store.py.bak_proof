import os, json, datetime, random, string
from io import BytesIO
from telebot.types import InlineKeyboardMarkup, InlineKeyboardButton

try:
    import qrcode
except ImportError:
    print("⚠️ qrcode not installed.")

UPI_ID = "7032617894@ybl"
ADMIN_GROUP_ID = 8857708587
STORE_STATE = {}
ORDERS_FILE = "data/user_orders.json"

# Unified Catalog
PRODUCTS = {
    "1": {"name": "📘 Analyser Module", "price": 249, "link": "https://wa.me/p/29345775085017763/918074231426"},
    "3": {"name": "📕 BIPC 1st Year JEE Mains Revision Book", "price": 679, "link": "https://wa.me/p/37659707166953822/918074231426"},
    "4": {"name": "📙 JEE Complete 1st Year JEE Main Revision", "price": 859, "link": "https://wa.me/p/27602087376124822/918074231426"},
    "5": {"name": "🧪 Organic Chemistry 1st Year JEE Mains", "price": 369, "link": "https://wa.me/p/37197185153261563/918074231426"},
    "6": {"name": "📗 JEE Slim 1st Year JEE Mains Revision", "price": 699, "link": "https://wa.me/p/38161400123451221/918074231426"},
    "7": {"name": "📘 MPC Without M 1st Year JEE Mains", "price": 699, "link": "https://wa.me/p/36883482691295177/918074231426"},
    "8": {"name": "⚛️ Physics 1st Year JEE Mains Revision", "price": 369, "link": "https://wa.me/p/27177195635293074/918074231426"},
    "9": {"name": "📐 Mathematics 1st Year JEE Mains Revision", "price": 319, "link": "https://wa.me/p/28258833240380540/918074231426"},
    "10": {"name": "🧪 Chemistry 1st Year JEE Mains Revision", "price": 329, "link": "https://wa.me/p/27775224768808817/918074231426"},
    
    # Hamilton AI Plans
    "ai_1y": {"name": "🤖 Hamilton AI Plan (1 Year)", "price": 299, "is_ai": True, "years": 1},
    "ai_2y": {"name": "🤖 Hamilton AI Plan (2 Years)", "price": 599, "is_ai": True, "years": 2},
    "ai_3y": {"name": "🤖 Hamilton AI Plan (3 Years)", "price": 899, "is_ai": True, "years": 3},
}

def _load_orders():
    if not os.path.exists(ORDERS_FILE): return {}
    try: return json.load(open(ORDERS_FILE))
    except: return {}

def _save_orders(data):
    os.makedirs("data", exist_ok=True)
    json.dump(data, open(ORDERS_FILE, "w"), indent=2)

def _get_cart(uid):
    if uid not in STORE_STATE: STORE_STATE[uid] = {"cart": {}, "delivery_date": None, "address": "", "location": ""}
    return STORE_STATE[uid]

def _get_ai_slots():
    try: pk = json.load(open("data/paid_keys.json"))
    except: pk = {}
    sold = len(pk)
    return max(0, 90 - sold), sold

@bot.message_handler(commands=['shop'])
def cmd_shop(message):
    try:
        uid = message.chat.id
        STORE_STATE[uid] = {"cart": {}, "delivery_date": None, "address": "", "location": ""}
        
        kb = InlineKeyboardMarkup(row_width=1)
        kb.add(InlineKeyboardButton("🛒 Buy Books & AI", callback_data="shop_buy"))
        kb.add(InlineKeyboardButton("📄 View Product Details", callback_data="shop_details"))
        kb.add(InlineKeyboardButton("🤖 Hamilton AI Limits", callback_data="shop_ai_limit"))
        kb.row(InlineKeyboardButton("📦 My Pending Orders", callback_data="shop_orders"))
        
        msg = "🏪 <b>Welcome to HK Publications & Hamilton AI!</b>\n\nPlease select an option below:"
        bot.send_message(uid, msg, parse_mode="HTML", reply_markup=kb)
    except Exception as e:
        bot.send_message(message.chat.id, f"⚠️ Error: {e}")

@bot.callback_query_handler(func=lambda c: c.data.startswith("shop_"))
def handle_shop(call):
    uid = call.message.chat.id
    try: bot.answer_callback_query(call.id)
    except: pass
    data = call.data

    if data == "shop_buy":
        kb = InlineKeyboardMarkup(row_width=1)
        for pid, p in PRODUCTS.items():
            kb.add(InlineKeyboardButton(f"{p['name']} - ₹{p['price']}", callback_data=f"add_prod:{pid}"))
        kb.add(InlineKeyboardButton("🛒 View Cart", callback_data="view_cart"))
        kb.add(InlineKeyboardButton("🔙 Back to Menu", callback_data="shop_main"))
        try: bot.edit_message_text("📚 <b>Select a Product to Add to Cart:</b>", chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb)
        except: pass

    elif data == "shop_details":
        kb = InlineKeyboardMarkup(row_width=1)
        for pid, p in PRODUCTS.items():
            if not p.get("is_ai"):
                kb.add(InlineKeyboardButton(f"{p['name']}", callback_data=f"det_prod:{pid}"))
        kb.add(InlineKeyboardButton("🔙 Back to Menu", callback_data="shop_main"))
        try: bot.edit_message_text("📄 <b>Product Details</b>\nClick a product to view reviews on WhatsApp:", chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb)
        except: pass

    elif data.startswith("det_prod:"):
        pid = data.split(":")[1]
        p = PRODUCTS[pid]
        bot.send_message(uid, f"📦 <b>{p['name']}</b>\n💰 Price: ₹{p['price']}\n\nClick here to view details and reviews:\n👉 <a href='{p['link']}'>Open WhatsApp Product Link</a>", parse_mode="HTML", disable_web_page_preview=False)

    elif data == "shop_ai_limit":
        avail, sold = _get_ai_slots()
        msg = f"🤖 <b>Hamilton AI Premium - Availability</b>\n\n🔒 <b>Total Seats:</b> 90\n👥 <b>Registered:</b> {sold}\n✅ <b>Remaining:</b> {avail}\n\n"
        if avail > 0:
            msg += "Hurry up and secure your seat before they run out! 🏃‍♂️💨"
            kb = InlineKeyboardMarkup().add(InlineKeyboardButton("🛒 Buy Now", callback_data="shop_buy"))
        else:
            msg += "❌ <b>SOLD OUT!</b> All 90 seats have been claimed."
            kb = InlineKeyboardMarkup().add(InlineKeyboardButton("🔙 Back", callback_data="shop_main"))
        try: bot.edit_message_text(msg, chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb)
        except: pass

    elif data == "shop_orders":
        orders_data = _load_orders()
        user_orders = orders_data.get(str(uid), [])
        if not user_orders:
            bot.send_message(uid, "📦 You have no pending book orders.")
            return
            
        kb = InlineKeyboardMarkup()
        msg = "📦 <b>Your Book Orders:</b>\n\n"
        for idx, o in enumerate(user_orders):
            msg += f"🛒 <b>Order {idx+1}:</b>\n📅 Delivery: {o.get('delivery')}\n💰 Total: ₹{o.get('total')}\n"
            if not o.get("contacted_admin"):
                msg += "⚠️ <b>You have not contacted admin yet!</b>\n"
                kb.add(InlineKeyboardButton(f"Contact Admin (Order {idx+1})", callback_data=f"contact_admin:{idx}"))
            else:
                msg += "✅ Contacted admin.\n"
            msg += "---\n"
            
        kb.add(InlineKeyboardButton("🔙 Back to Menu", callback_data="shop_main"))
        bot.send_message(uid, msg, parse_mode="HTML", reply_markup=kb)

    elif data.startswith("contact_admin:"):
        idx = data.split(":")[1]
        orders_data = _load_orders()
        uid_str = str(uid)
        if uid_str in orders_data and int(idx) < len(orders_data[uid_str]):
            orders_data[uid_str][int(idx)]["contacted_admin"] = True
            _save_orders(orders_data)
            bot.answer_callback_query(call.id, "✅ Marked as contacted!")
            bot.send_message(uid, "👉 <a href='https://wa.me/918074231426'>Click here to message Admin on WhatsApp</a>", parse_mode="HTML", disable_web_page_preview=True)
            handle_shop(type('obj', (object,), {'id': call.id, 'message': call.message, 'data': 'shop_orders'})())
        return

    elif data == "shop_main":
        try: bot.delete_message(uid, call.message.message_id)
        except: pass
        cmd_shop(call.message)

    elif data.startswith("add_prod:"):
        pid = data.split(":")[1]
        p = PRODUCTS[pid]
        
        # If it's an AI plan, check limit immediately when adding
        if p.get("is_ai"):
            avail, _ = _get_ai_slots()
            if avail <= 0:
                bot.answer_callback_query(call.id, "❌ Sold Out! All 90 Hamilton AI keys are claimed.", show_alert=True)
                return

        cart = _get_cart(uid)["cart"]
        cart[pid] = cart.get(pid, 0) + 1
        
        kb = InlineKeyboardMarkup()
        kb.row(InlineKeyboardButton("➖", callback_data=f"rem_prod:{pid}"), InlineKeyboardButton("➕", callback_data=f"add_prod:{pid}"))
        kb.add(InlineKeyboardButton("✅ Done Adding", callback_data="view_cart"))
        try: bot.edit_message_text(f"📦 <b>{p['name']}</b>\nQty: {cart[pid]}\nPrice: ₹{p['price']} each", chat_id=uid, message_id=call.message.message_id, reply_markup=kb, parse_mode="HTML")
        except: pass

    elif data.startswith("rem_prod:"):
        pid = data.split(":")[1]
        cart = _get_cart(uid)["cart"]
        if pid in cart:
            cart[pid] -= 1
            if cart[pid] <= 0: del cart[pid]
        if not cart:
            handle_shop(type('obj', (object,), {'id': call.id, 'message': call.message, 'data': 'shop_buy'})())
            return
        p = PRODUCTS[pid]
        kb = InlineKeyboardMarkup()
        kb.row(InlineKeyboardButton("➖", callback_data=f"rem_prod:{pid}"), InlineKeyboardButton("➕", callback_data=f"add_prod:{pid}"))
        kb.add(InlineKeyboardButton("✅ Done Adding", callback_data="view_cart"))
        try: bot.edit_message_text(f"📦 <b>{p['name']}</b>\nQty: {cart.get(pid, 0)}\nPrice: ₹{p['price']} each", chat_id=uid, message_id=call.message.message_id, reply_markup=kb, parse_mode="HTML")
        except: pass

    elif data == "view_cart":
        cart = _get_cart(uid)["cart"]
        if not cart:
            bot.answer_callback_query(call.id, "Your cart is empty!", show_alert=True)
            return
            
        total = 0
        txt = "🛒 <b>Your Cart:</b>\n\n"
        has_ai = False
        
        for pid, qty in cart.items():
            p = PRODUCTS[pid]
            if p.get("is_ai"): has_ai = True
            subtotal = p["price"] * qty
            total += subtotal
            txt += f"• {p['name']} (x{qty}) = ₹{subtotal}\n"
            
        txt += f"\n💰 <b>Total: ₹{total}</b>"
        
        # Cross-check AI limit at cart view
        if has_ai:
            avail, _ = _get_ai_slots()
            if avail <= 0:
                txt += "\n\n❌ <b>WARNING:</b> Hamilton AI is SOLD OUT. Please remove it from the cart."
                
        kb = InlineKeyboardMarkup()
        kb.add(InlineKeyboardButton("✅ Proceed to Checkout", callback_data="checkout"))
        kb.add(InlineKeyboardButton("🔙 Back to Shop", callback_data="shop_main"))
        try: bot.edit_message_text(txt, chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb)
        except: pass

    elif data == "checkout":
        state = _get_cart(uid)
        cart = state["cart"]
        if not cart: return
        
        # CROSS CHECK AI LIMIT AT CHECKOUT
        has_ai = any(PRODUCTS[pid].get("is_ai") for pid in cart.keys())
        if has_ai:
            avail, _ = _get_ai_slots()
            if avail <= 0:
                bot.answer_callback_query(call.id, "❌ Hamilton AI is SOLD OUT. Remove it to proceed.", show_alert=True)
                return
                
        # Check if cart only has AI
        only_ai = all(PRODUCTS[pid].get("is_ai") for pid in cart.keys())
        
        if only_ai:
            total = sum(PRODUCTS[pid]["price"] * qty for pid, qty in cart.items())
            state["delivery_date"] = "Digital Delivery"
            state["location"] = "Digital"
            try: bot.delete_message(uid, call.message.message_id)
            except: pass
            generate_qr(uid, total, True)
        else:
            total = sum(PRODUCTS[pid]["price"] * qty for pid, qty in cart.items())
            kb = InlineKeyboardMarkup()
            d1 = (datetime.datetime.now() + datetime.timedelta(days=3)).strftime("%Y-%m-%d")
            d2 = (datetime.datetime.now() + datetime.timedelta(days=5)).strftime("%Y-%m-%d")
            kb.add(InlineKeyboardButton(f"📅 {d1}", callback_data=f"del_date:{d1}"))
            kb.add(InlineKeyboardButton(f"📅 {d2}", callback_data=f"del_date:{d2}"))
            kb.add(InlineKeyboardButton("🔙 Back", callback_data="view_cart"))
            try: bot.edit_message_text(f"📦 <b>Total: ₹{total}</b>\n\nWhen do you want to receive your physical order?\n<i>(Minimum 3 days)</i>", chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb)
            except: pass

    elif data.startswith("del_date:"):
        date = data.split(":")[1]
        state = _get_cart(uid)
        state["delivery_date"] = date
        kb = InlineKeyboardMarkup(row_width=1)
        kb.add(InlineKeyboardButton("📍 Nellore (₹50 Delivery)", callback_data="loc:Nellore"))
        kb.add(InlineKeyboardButton("🌍 Outside Nellore", callback_data="loc:Outside"))
        try: bot.edit_message_text("📍 <b>Where do you want delivery?</b>", chat_id=uid, message_id=call.message.message_id, parse_mode="HTML", reply_markup=kb)
        except: pass

    elif data.startswith("loc:"):
        loc = data.split(":")[1]
        state = _get_cart(uid)
        state["location"] = loc
        base_total = sum(PRODUCTS[pid]["price"] * qty for pid, qty in state["cart"].items())
        final_total = base_total + (50 if loc == "Nellore" else 0)
        if loc == "Outside":
            bot.send_message(uid, "⚠️ External delivery charges will be applied. Please contact Admin after payment:\n👉 <a href='https://wa.me/918074231426'>WhatsApp</a>", parse_mode="HTML")
        try: bot.delete_message(uid, call.message.message_id)
        except: pass
        generate_qr(uid, final_total, False)

def generate_qr(uid, total, has_ai):
    order_id = "ORD-" + "".join(random.choices(string.ascii_uppercase + string.digits, k=6))
    upi_str = f"upi://pay?pa={UPI_ID}&pn=HK_Publications&am={total:.2f}&cu=INR&tn={order_id}"
    try:
        qr = qrcode.make(upi_str)
        bio = BytesIO()
        qr.save(bio, "PNG")
        bio.seek(0)
    except Exception as e:
        bot.send_message(uid, f"⚠️ QR generation failed: {e}")
        return

    STORE_STATE[uid]["order_id"] = order_id
    STORE_STATE[uid]["total_amount"] = total
    caption = f"🏷 <b>Order ID: {order_id}</b>\n💰 <b>Amount: ₹{total:.2f}</b>\n\nScan this QR with GPay/PhonePe to pay.\n\nOnce paid, click below."
    kb = InlineKeyboardMarkup()
    kb.add(InlineKeyboardButton("✅ I Have Paid", callback_data="verify_manual"))
    kb.add(InlineKeyboardButton("❌ Cancel", callback_data="cancel_order"))
    bot.send_photo(uid, bio, caption=caption, parse_mode="HTML", reply_markup=kb)

@bot.callback_query_handler(func=lambda c: c.data == "cancel_order")
def cancel_order(call):
    uid = call.message.chat.id
    try: bot.answer_callback_query(call.id)
    except: pass
    try: bot.delete_message(uid, call.message.message_id)
    except: pass
    bot.send_message(uid, "❌ Order Cancelled.")
    STORE_STATE.pop(uid, None)

@bot.callback_query_handler(func=lambda c: c.data == "verify_manual")
def verify_manual(call):
    uid = call.message.chat.id
    try: bot.answer_callback_query(call.id)
    except: pass
    state = _get_cart(uid)
    try: bot.edit_message_caption("⏳ <b>Waiting for Admin Approval...</b>", chat_id=uid, message_id=call.message.message_id, parse_mode="HTML")
    except: pass
    kb = InlineKeyboardMarkup()
    kb.add(InlineKeyboardButton("✅ Approve Payment", callback_data=f"admin_approve:{uid}"))
    kb.add(InlineKeyboardButton("❌ Reject", callback_data=f"admin_reject:{uid}"))
    msg = f"🚨 <b>NEW PAYMENT TO VERIFY</b>\n👤 User ID: {uid}\n🏷 Order ID: {state['order_id']}\n💰 Amount: ₹{state['total_amount']}\n📍 Location: {state.get('location', 'Digital')}\n📅 Delivery: {state.get('delivery_date', 'Immediate')}\n"
    try: bot.send_message(ADMIN_GROUP_ID, msg, parse_mode="HTML", reply_markup=kb)
    except Exception as e: bot.send_message(uid, f"⚠️ Could not notify admin. Error: {e}")

@bot.callback_query_handler(func=lambda c: c.data.startswith("admin_approve:") or c.data.startswith("admin_reject:"))
def admin_verify(call):
    action, target_uid = call.data.split(":")
    target_uid = int(target_uid)
    state = STORE_STATE.get(target_uid)
    if not state: return
    try: bot.answer_callback_query(call.id)
    except: pass

    if action == "admin_approve":
        try: bot.edit_message_text("✅ Payment Approved!", chat_id=call.message.chat.id, message_id=call.message.message_id)
        except: pass
        
        cart = state.get("cart", {})
        ai_items = {pid: qty for pid, qty in cart.items() if PRODUCTS[pid].get("is_ai")}
        book_items = {pid: qty for pid, qty in cart.items() if not PRODUCTS[pid].get("is_ai")}
        
        # Process AI Purchase
        if ai_items:
            # Take the highest duration bought if multiple
            max_ai_pid = max(ai_items.keys(), key=lambda k: PRODUCTS[k]["years"])
            years = PRODUCTS[max_ai_pid]["years"]
            
            user_name = "User"
            prof_data = {}
            if os.path.exists(f"profiles/{target_uid}.json"):
                try: 
                    prof_data = json.load(open(f"profiles/{target_uid}.json"))
                    user_name = prof_data.get("name", "User")
                except: pass
            safe_name = "".join(ch for ch in user_name if ch.isalnum())[:10].capitalize()
            key = f"HK-AI-{safe_name}-{years}Y-" + "".join(random.choices(string.ascii_uppercase + string.digits, k=6))
            exp_date = datetime.datetime.now() + datetime.timedelta(days=365 * int(years))
            expires_iso = exp_date.isoformat()
            
            if not os.path.exists("data/paid_keys.json"): json.dump({}, open("data/paid_keys.json", "w"))
            try: pk = json.load(open("data/paid_keys.json"))
            except: pk = {}
            pk[key] = {"user_id": target_uid, "name": user_name, "years": years, "order_id": state.get("order_id"), "purchase_date": datetime.datetime.now().isoformat(), "expires_at": expires_iso, "status": "ACTIVE"}
            json.dump(pk, open("data/paid_keys.json", "w"), indent=2)
            
            if prof_data:
                prof_data["activation_key"] = key
                prof_data["secured"] = True
                prof_data["is_trial"] = False
                prof_data["is_paid"] = True
                prof_data["paid_expiry"] = expires_iso
                json.dump(prof_data, open(f"profiles/{target_uid}.json", "w"), indent=2)
            
            success_msg = f"🎉 <b>Payment Verified for Hamilton AI!</b>\n\n🔑 <b>Your Permanent Access Key:</b>\n<code>{key}</code>\n\n⚠️ <b>Important:</b> Contact the admin and share your payment screenshot for full guarantee and security.\n👉 <a href='https://wa.me/918074231426'>WhatsApp Admin</a>"
            bot.send_message(target_uid, success_msg, parse_mode="HTML")
            
        # Process Book Purchase
        if book_items:
            orders_data = _load_orders()
            uid_str = str(target_uid)
            if uid_str not in orders_data: orders_data[uid_str] = []
            items_txt = ""
            for pid, qty in book_items.items():
                p = PRODUCTS[pid]
                items_txt += f"- {p['name']} x{qty}\n"
            
            orders_data[uid_str].append({
                "items": items_txt,
                "total": state["total_amount"],
                "delivery": state.get('delivery_date'),
                "contacted_admin": False,
                "date": datetime.datetime.now().isoformat()
            })
            _save_orders(orders_data)
            
            receipt = f"🎉 <b>Payment Verified for Books!</b>\n\n📦 <b>Items:</b>\n{items_txt}\n📅 <b>Delivery Date:</b> {state.get('delivery_date')}\n📍 <b>Location:</b> {state.get('location')}\n\n⚠️ <b>IMPORTANT:</b> You must contact the admin on WhatsApp to confirm your delivery.\n👉 <a href='https://wa.me/918074231426'>Click here to WhatsApp Admin</a>"
            bot.send_message(target_uid, receipt, parse_mode="HTML")
            
        STORE_STATE.pop(target_uid, None)
        
    elif action == "admin_reject":
        try: bot.edit_message_text("❌ Payment Rejected.", chat_id=call.message.chat.id, message_id=call.message.message_id)
        except: pass
        bot.send_message(target_uid, "❌ Your payment was rejected. Please contact admin.")
