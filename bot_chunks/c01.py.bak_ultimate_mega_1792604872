@bot.callback_query_handler(func=lambda c: c.data.startswith("ex_lvl:"))
def cb_ex_lvl(call):
    uid = call.from_user.id
    lvl = int(call.data.split(":")[1])
    bot._exam_state[uid]["level"] = lvl
    try: bot.delete_message(uid, call.message.message_id)
    except: pass
    
    # 5-4-3-2-1 Countdown
    for i in range(5, 0, -1):
        m = safe_send(uid, f"⏳ *Test starting in {i}...*", parse_mode="Markdown")
        time.sleep(1)
        try: bot.delete_message(uid, m.message_id)
        except: pass
        
    # 1. Intro Message
    state = bot._exam_state[uid]
    exam = state["exam"]
    subs = list(state["subjects"])
    mode = state.get("mode", "test")
    papers = state.get("paper", "1")
    max_q = state.get("max_q", 20)
    
    mins = (60 if exam == "JEE_MAIN" else 45) * len(subs)
    if papers == "both": mins *= 2
    
    chapters_str = ", ".join([f"{s}: {len(c)}" for s, c in state["selected_chapters"].items()])
    intro = f"🚀 *{mode.upper()} STARTED!*\n\n"
    intro += f"📚 *Chapters:* {chapters_str}\n"
    intro += f"⏱️ *Time:* {mins} minutes\n"
    intro += f"📝 *Rules:*\n- No feedback until end\n- Timer is strictly enforced\n- Use buttons to answer\n\n"
    intro += f"_Generating questions..._"
    loader = safe_send(uid, intro, parse_mode="Markdown")
    
    import bot_chunks.c06 as c06_mod
    
    sess = exam_engine.get_session(uid)
    if not sess: sess = exam_engine.new_test_session(uid, exam, subs, {}, papers=1)
    sess["mode"] = mode
    sess["exam"] = exam
    sess["subjects"] = subs
    sess["level"] = lvl
    sess["max_q"] = max_q
    
    # Save selected chapters into the profile/session so preload uses them
    p = load_profile(uid)
    if "selected_chapters" not in p: p["selected_chapters"] = {}
    for s, chs in state["selected_chapters"].items():
        p["selected_chapters"][s] = list(chs)
    save_profile(uid, p)
    
    timer_manager.start_test_timer(bot, uid, mins, on_time_up=c06_mod._test_paper_time_up)
    
    # Launch preload in background
    c06_mod.PRELOAD_QUEUE[uid] = []
    
    def _bg_generate():
        try:
            c06_mod._preload_test(uid, count=3)
            time.sleep(2) # allow preload to start
            try: bot.edit_message_text("⚙️ Generating questions: 1/3...", chat_id=uid, message_id=loader.message_id)
            except: pass
            while len(c06_mod.PRELOAD_QUEUE.get(uid, [])) < 1:
                time.sleep(1)
                
            try: bot.edit_message_text("⚙️ Generating questions: 2/3...", chat_id=uid, message_id=loader.message_id)
            except: pass
            while len(c06_mod.PRELOAD_QUEUE.get(uid, [])) < 2:
                time.sleep(1)
                
            try: bot.edit_message_text("⚙️ Generating questions: 3/3...", chat_id=uid, message_id=loader.message_id)
            except: pass
            while len(c06_mod.PRELOAD_QUEUE.get(uid, [])) < 3:
                time.sleep(1)
                
            try: bot.delete_message(uid, loader.message_id)
            except: pass
            
            c06_mod._send_next_test_q(uid)
        except Exception as e:
            print(f"[bg-gen] {e}")
            
    import threading
    threading.Thread(target=_bg_generate, daemon=True).start()
    bot.answer_callback_query(call.id)
