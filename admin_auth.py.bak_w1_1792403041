        os.replace(tmp, path)
    except Exception:
        pass

# ==========================================================
# SESSION MESSAGE TRACKING + AUTO-DELETE
# ==========================================================
SESSION_MESSAGES = {}   # {chat_id: [list of (message_id, ts)]}
SESSION_CALLBACK = None  # set by bot.py via register_delete_callback

def track_message(chat_id: int, message_id: int):
    """Called for every admin-visible message to track it for deletion."""
    SESSION_MESSAGES.setdefault(chat_id, []).append((message_id, time.time()))

def register_delete_callback(cb):
    """bot.py calls this to register a deletion helper."""
    global SESSION_CALLBACK
    SESSION_CALLBACK = cb

def cleanup_session_messages(chat_id: int):
    """Called when session expires — deletes all tracked messages."""
    msgs = SESSION_MESSAGES.pop(chat_id, [])
    if not msgs or not SESSION_CALLBACK:
        return
    for msg_id, _ in msgs:
        try:
            SESSION_CALLBACK(chat_id, msg_id)
        except Exception:
            pass

def check_and_cleanup():
    """Run in background loop — deletes messages for expired sessions."""
    now = time.time()
    timeout = getattr(config, 'SESSION_IDLE_MINUTES', 5) * 60
    for chat_id in list(_SESSIONS.keys()):
        sess = _SESSIONS.get(chat_id)
        if not sess:
            continue
        if now > sess["expires"]:
            _SESSIONS.pop(chat_id, None)
            cleanup_session_messages(chat_id)
            try:
                if SESSION_CALLBACK:
                    SESSION_CALLBACK(chat_id, None, "⏰ Panel auto-closed (5 min idle).\nEnter the panel code to reopen.")
            except Exception:
                pass

# Auto-start cleanup thread
import threading as _thr
def _cleanup_loop():
    while True:
        try:
            check_and_cleanup()
        except Exception:
            pass
        _thr.Event().wait(30)

_thr.Thread(target=_cleanup_loop, daemon=True).start()
