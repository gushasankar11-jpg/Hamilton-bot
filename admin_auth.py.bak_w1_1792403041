def log_admin_device(chat_id: int, role: str):
    """Record admin panel open. Keep last 40 entries."""
    try:
        path = getattr(config, "ADMIN_LOG_FILE", "admin_devices.log")
        entry = {"ts": datetime.now().isoformat(), "chat_id": chat_id, "role": role}
        
        lines = []
        if os.path.exists(path):
            with open(path) as f:
                lines = [l.strip() for l in f if l.strip()]
                
        lines.append(json.dumps(entry))
        lines = lines[-1000:]   # S1: ~100 days retention
        
        with open(path, "w") as f:
            f.write("\n".join(lines))
    except Exception as e:
        print(f"[log_device] error: {e}")

def list_admin_devices(limit=40):
    path = getattr(config, "ADMIN_LOG_FILE", "admin_devices.log")
    if not os.path.exists(path):
        return []
    try:
        with open(path) as f:
            lines = [l.strip() for l in f if l.strip()]
        entries = [json.loads(l) for l in lines]
        entries.reverse()
        return entries[:limit]
    except Exception:
        return []


# ==========================================================
# NEW USER QUEUE (verify / reject)
# ==========================================================
def _load_new_users():
    path = getattr(config, "NEW_USERS_FILE", "new_users.json")
    if not os.path.exists(path):
        return {"queue": [], "last_panel_open": None}
    try:
        with open(path) as f:
            data = json.load(f)
        data.setdefault("queue", [])
        data.setdefault("last_panel_open", None)
        return data
    except Exception:
        return {"queue": [], "last_panel_open": None}

def _save_new_users(data):
    path = getattr(config, "NEW_USERS_FILE", "new_users.json")
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)

def mark_new_user(uid: int, name: str, phone: str):
    """Called when a user finishes onboarding."""
    data = _load_new_users()
    q = data["queue"]
    # avoid duplicates
    if not any(e.get("uid") == uid for e in q):
        q.append({
            "uid": uid,
            "name": name,
            "phone": phone,
            "joined_at": datetime.now().isoformat(),
        })
    _save_new_users(data)

def list_new_users():
    return _load_new_users()["queue"]

def verify_new_user(uid: int):
    """Remove from new-user queue (verified)."""
    data = _load_new_users()
    data["queue"] = [e for e in data["queue"] if e.get("uid") != uid]
    _save_new_users(data)

def reject_new_user(uid: int):
    """Remove from queue (rejected). Caller should message the user."""
    data = _load_new_users()
    data["queue"] = [e for e in data["queue"] if e.get("uid") != uid]
    _save_new_users(data)

def mark_panel_opened():
    """Called when admin opens panel — snapshot of new users since last open."""
    data = _load_new_users()
    since = data.get("last_panel_open")
    q = data["queue"]
    if since:
        try:
            dt = datetime.fromisoformat(since)
            new_since = [e for e in q if datetime.fromisoformat(e["joined_at"]) > dt]
        except Exception:
            new_since = q
    else:
        new_since = q
    data["last_panel_open"] = datetime.now().isoformat()
    _save_new_users(data)
    return len(new_since), len(q)


