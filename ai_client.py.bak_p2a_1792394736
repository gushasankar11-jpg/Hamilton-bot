def _parse_env_rows(body):
    """Split LaTeX env body into rows of cells."""
    body = body.replace("\\\\", "||ROW||")
    rows = [r.strip() for r in body.split("||ROW||")]
    out = []
    for r in rows:
        cells = [c.strip() for c in r.split("&")]
        out.append(cells)
    return [r for r in out if any(c for c in r)]


def _fmt_grid(rows, left, right, sep="  "):
    """Render grid with given brackets."""
    if not rows:
        return ""
    ncols = max(len(r) for r in rows)
    # Pad cells
    padded = []
    for r in rows:
        padded.append([(r[i] if i < len(r) else "") for i in range(ncols)])
    # Column widths
    widths = [max(len(padded[i][j]) for i in range(len(padded))) for j in range(ncols)]
    lines = []
    for i, r in enumerate(padded):
        cells = [r[j].ljust(widths[j]) for j in range(ncols)]
        mid = sep.join(cells)
        if i == 0:
            lines.append(left + " " + mid + " " + right)
        elif i == len(padded) - 1:
            lines.append(left + " " + mid + " " + right)
        else:
            lines.append(" " + mid)
    return "\n".join(lines)


def convert_latex_envs(text):
    """Replace LaTeX environments with Unicode art blocks."""
    import re
    if not text:
        return text

    def _parse_rows(body):
        body = body.replace("\\\\", "||R||")
        out = []
        for r in body.split("||R||"):
            cells = [c.strip() for c in r.split("&")]
            if any(cells):
                out.append(cells)
        return out

    def _grid(rows):
        if not rows:
            return []
        n = max(len(r) for r in rows)
        padded = [r + [""] * (n - len(r)) for r in rows]
        widths = [max(len(padded[i][j]) for i in range(len(padded))) for j in range(n)]
        return ["  ".join(padded[i][j].ljust(widths[j]) for j in range(n)) for i in range(len(padded))]

    def _bracket(rows, l1, lm, ll, r1, rm, rl):
        """Generic bracketed grid."""
        body_lines = _grid(rows)
        n = len(body_lines)
        if n == 0:
            return ""
        if n == 1:
            lefts = [l1]; rights = [r1]
        else:
            lefts = [l1] + [lm] * (n - 2) + [ll]
            rights = [r1] + [rm] * (n - 2) + [rl]
        out = []
        for i, line in enumerate(body_lines):
            out.append(f"{lefts[i]} {line} {rights[i]}")
        return "```\n" + "\n".join(out) + "\n```"

    def repl_bmatrix(m):
        rows = _parse_rows(m.group(1))
        return _bracket(rows, "[", "|", "[", "]", "|", "]")

    def repl_vmatrix(m):
        rows = _parse_rows(m.group(1))
        return _bracket(rows, "|", "|", "|", "|", "|", "|")

    def repl_pmatrix(m):
        rows = _parse_rows(m.group(1))
        return _bracket(rows, "(", "|", "(", ")", "|", ")")

    def repl_Bmatrix(m):
        rows = _parse_rows(m.group(1))
        return _bracket(rows, "{", "|", "{", "}", "|", "}")

    def repl_cases(m):
        body = m.group(1)
        body = body.replace("\\\\", "\n")
        lines = [l.strip() for l in body.split("\n") if l.strip()]
        parts = []
        for l in lines:
            # Clean LaTeX in text
            p = l.replace("&", "   ")
            p = re.sub(r'\\text\s*\{([^{}]*)\}', r'\1', p)
            p = p.replace("\\geq", "≥").replace("\\leq", "≤")
            p = p.replace("\\ge", "≥").replace("\\le", "≤")
            p = p.replace("\\neq", "≠")
            p = p.replace("\\cdot", "·")
            parts.append(p.strip())
        if not parts:
            return m.group(0)
        out = []
        for i, p in enumerate(parts):
            if i == 0:
                out.append("{  " + p)
            elif i == len(parts) - 1 and len(parts) > 2:
                out.append("{  " + p)
            elif i == len(parts) - 1 and len(parts) == 2:
                out.append("{  " + p)
            else:
                out.append("{  " + p)
        return "```\n" + "\n".join(out) + "\n```"

    # Wrap matrix pattern with optional $$ on either side
    def make_wrap(pattern, repl):
        def wrapped(m):
            left = m.group(1) or ""
            right = m.group(3) or ""
            inner = m.group(2)
            return repl(type("M", (), {"group": lambda self, n, inner=inner: inner})())
        return wrapped

    # Match $$\begin{env}...\end{env}$$ OR \begin{env}...\end{env}
    def replace_env(text, env_name, repl_func):
        pattern = (
            r'(\$\$)?\s*\\begin\{' + env_name + r'\}(.*?)\\end\{' + env_name + r'\}\s*(\$\$)?'
        )
        def wrapper(m):
            body = m.group(2)
            fake = type("M", (), {"group": lambda self, n: body})()
            return repl_func(fake)
        return re.sub(pattern, wrapper, text, flags=re.DOTALL)

    text = replace_env(text, "bmatrix", repl_bmatrix)
    text = replace_env(text, "vmatrix", repl_vmatrix)
    text = replace_env(text, "pmatrix", repl_pmatrix)
    text = replace_env(text, "Bmatrix", repl_Bmatrix)
    text = replace_env(text, "cases", repl_cases)

    # Cleanup leftover $$ right before code blocks
    text = re.sub(r'\$\$([^$\n]{0,80})?```', r'\1```', text)
    # Cleanup leftover $ at start of line before backtick
    text = re.sub(r'\$([^$\n]{0,80})```', r'\1```', text)

    return text


