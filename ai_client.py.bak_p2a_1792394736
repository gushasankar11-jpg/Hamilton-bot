def classify_and_answer(exam, user_message):
    """
    Returns (intent, answer_text). Intent is one of:
        STUDY, META_STUDY, OFF_TOPIC
    For OFF_TOPIC, answer_text is the Guru lecture.
    """
    prompt = f"""The student sent: "{user_message}"

FIRST, decide intent (internal):
- STUDY: study content, doubts, formulas, chapters, strategy
- META_STUDY: exam system info (NTA, IIT, colleges, cutoffs, pattern)
- OFF_TOPIC: anime, movies, songs, sports, gossip, love, games, jokes, everything non-exam

THEN reply appropriately:
- If STUDY: give the friendly answer.
- If META_STUDY: 2-3 line answer + redirect to study.
- If OFF_TOPIC: reply EXACTLY with the Guru lecture.

Start your reply with a single line: `INTENT=STUDY`, `INTENT=META_STUDY`, or `INTENT=OFF_TOPIC`, then a newline, then the actual answer body.
"""
    system = build_system_prompt(exam)
    raw = _route_call(system, prompt, max_tokens=3500, temperature=0.6)

    if not raw:
        return "UNCERTAIN", None

    intent = "STUDY"
    body = raw
    first_line = raw.split("\n", 1)[0].strip().upper()
    if "INTENT=OFF_TOPIC" in first_line:
        intent = "OFF_TOPIC"
    elif "INTENT=META_STUDY" in first_line:
        intent = "META_STUDY"
    elif "INTENT=STUDY" in first_line:
        intent = "STUDY"

    if "\n" in raw and first_line.startswith("INTENT="):
        body = raw.split("\n", 1)[1].strip()

    # # body = convert_latex_envs(body)  # disabled
    return intent, body


