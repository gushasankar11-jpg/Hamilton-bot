def postprocess_ai_output(text):
    """Strip code fences, convert pipe-matrices to bmatrix."""
    if not text:
        return text
    import re

    # Step 1: Remove ALL triple backticks (they're always wrong here)
    text = text.replace("```", "")

    # Step 2: Line-by-line — detect consecutive pipe-matrix lines
    lines = text.split("\n")
    out = []
    buf = []

    def flush():
        if not buf:
            return
        rows = []
        for ln in buf:
            inner = ln.strip().strip("[]|").strip()
            cells = [c.strip() for c in re.split(r"\s{2,}|\s*&\s*", inner) if c.strip()]
            if cells:
                rows.append(cells)
        if rows:
            body = r" \\ ".join(" & ".join(r) for r in rows)
            out.append(r"$$\begin{bmatrix} " + body + r" \end{bmatrix}$$")
        buf.clear()

    for line in lines:
        s = line.strip()
        is_matrix = (
            (s.startswith("[") and (s.endswith("]") or s.endswith("],")))
            or (s.startswith("|") and s.endswith("|"))
        )
        if is_matrix:
            buf.append(s)
        else:
            flush()
            out.append(line)
    flush()

    return "\n".join(out)




def _orig_ask_hamilton(exam, prompt, context=None, retries=3):
    cache_key = f"{exam}||{prompt[:250]}"
    if cache_key in AI_CACHE:
        return AI_CACHE[cache_key]
    system = build_system_prompt(exam)
    if context:
        system += "\n\nADDITIONAL CONTEXT:\n" + str(context)
    result = _route_call(system, prompt, max_tokens=4000, temperature=0.6)
    if result:
        AI_CACHE[cache_key] = result
    return result


def _orig_ask_raw(exam, prompt, system_override=None, retries=3):
    cache_key = f"RAW::{exam}||{prompt[:250]}"
    if cache_key in AI_CACHE:
        return AI_CACHE[cache_key]
    system = system_override or build_system_prompt(exam)
    result = _route_call(system, prompt, max_tokens=4000, temperature=0.5)
    if result:
        AI_CACHE[cache_key] = result
    return result


