def quick_offtopic_check(text):
    """Return True if the message is clearly off-topic. No API call."""
    if not text:
        return False
    low = text.lower().strip()
    # Very short greetings only
    if len(low) <= 15:
        for g in ["hi", "hello", "hey", "yo", "sup", "hii", "hiii"]:
            if low == g or low == g + "!":
                return True
    for word in _OFFLINE_OFFTOPIC_WORDS:
        if word in low:
            return True
    return False


def classify_message_and_answer(exam, user_message, selected_exams=None):
    """
    Single-call classifier + answer.
    Returns: (verdict, reply)
      verdict = "STUDY"        → reply is the real answer
      verdict = "OFF_TOPIC"    → reply is the guru lecture text
    """
    import re as _re_cls

    # Fast path — obvious off-topic, no API call
    if quick_offtopic_check(user_message):
        return "OFF_TOPIC", (
            "Think about study. Think about studies. Don't simply learn. "
            "Understand it so you can simply memorize it. Remember that your "
