    system += (
        "\n\n=== RELEVANCE GATE — MANDATORY ===\n"
        "Student's selected exams: " + exam_phrase + ".\n\n"
        "You MUST start EVERY reply with EXACTLY ONE of these two tags "
        "on the FIRST LINE — nothing else on that line, no punctuation, no spaces before it:\n\n"
        "[STUDY]      — use when the message relates to study, syllabus, strategy, career, "
        "academics, or any doubt for ANY of the selected exams.\n"
        "[OFF_TOPIC]  — use when the message is casual (movie, song, joke, gossip, love, "
        "weather, food, cricket, personal chat, greeting) OR unrelated to any selected exam.\n\n"
        "Line 2 onward:\n"
        "  - If [STUDY] → write the full answer to the student's question.\n"
        "  - If [OFF_TOPIC] → write ONLY the guru lecture text (HARD RULES rule 2). "
        "Do NOT answer the actual question, do NOT lecture about study plans. "
        "Just the guru lecture.\n\n"
        "CRITICAL: Even for greetings or casual chat, use [OFF_TOPIC]. "
        "Do not get distracted. The tag on line 1 is not optional."
    )

    raw = _orig_ask_hamilton(exam, user_message)
    if not raw:
        return "STUDY", None

    # Regex parse — find the tag ANYWHERE in the first 200 chars
    head = raw[:200].upper()
    if "[OFF_TOPIC]" in head:
        # Strip the tag and any leading junk before it
        m = _re_cls.search(r"\[OFF_TOPIC\]", raw, _re_cls.IGNORECASE)
        rest = raw[m.end():].lstrip("\n: .-")
        return "OFF_TOPIC", rest
    if "[STUDY]" in head:
        m = _re_cls.search(r"\[STUDY\]", raw, _re_cls.IGNORECASE)
        rest = raw[m.end():].lstrip("\n: .-")
        return "STUDY", rest

    # No tag anywhere → check for obvious off-topic content as fallback
    low = raw.lower()[:400]
    off_signals = ["guru", "focus on study", "focus now", "get back to study",
                   "distracted", "bored", "wasting time",
                   "channel that energy", "channel your energy",
                   "let's channel", "lets channel",
                   "keep the momentum", "keep your momentum",
                   "stay focused", "stay consistent",
                   "keep your focus", "let's keep our focus",
                   "lets keep our focus", "mini-mission", "mini mission",
                   "study blueprint", "study sprint", "study plan",
                   "focus on jee", "focus on your exam",
                   "focus on jee-advanced", "focus on jee advanced",
                   "focus on jee-main", "focus on jee mains",
                   "you've got this", "you got this"]
    if any(sig in low for sig in off_signals):
        return "OFF_TOPIC", raw
    return "STUDY", raw

def verify_name(name):
    """
    Returns (verdict, reply)
      verdict = "REAL"       → accept name
      verdict = "FICTIONAL"  → reject with reply text
    """
    if not name or len(name.strip()) < 2:
        return "REAL", None

    system = (
        "You classify whether a name is a fictional character or a real human name.\n"
        "FICTIONAL examples: Naruto, Goku, Luffy, Batman, Superman, Iron Man, "
        "Harry Potter, Baahubali, Gabbar Singh, Mogambo, Kratos, Mario, Link, "
        "Gandalf, Frodo, Arjuna (Mahabharata), Krishna (deity), Zeus, Thor, "
        "Tanjiro, Ichigo, Levi, Eren, Light Yagami, Lelouch, Any anime character, "
        "Any comic superhero, Any movie villain/hero, Any mythological figure.\n"
        "REAL examples: Rahul, Priya, Arjun, Anjali, Vikram, Suresh, Ravi, "
        "Aisha, Meera, Kiran, Rohan, Neha, etc. — common real-world names.\n\n"
        "Reply on line 1 with exactly: [FICTIONAL] or [REAL]\n"
        "Line 2 onward: leave blank. Do not add comments."
    )

    raw = _orig_ask_raw("JEE_MAIN", f"Is this name fictional? '{name}'",
                        system_override=system)
    if not raw:
        return "REAL", None

    tag = raw.strip().split("\n")[0].upper()
    if tag.startswith("[FICTIONAL]"):
        return "FICTIONAL", (
            "🤔 I think this is not your actual name.\n\n"
            "Please enter your actual name."
        )
    return "REAL", None



