def generate_question_batch(exam, subject, chapter, subtopic_list,
                             q_type="mcq", difficulty="medium", count=5):
    """
    Generate N questions in ONE API call. Returns list of question dicts.
    subtopic_list: list of subtopic names to draw from.
    """
    subtopics_str = "\n".join(f"- {s}" for s in subtopic_list[:15])

    prompt = f"""Generate {count} {q_type.upper()} questions for {exam}.
Subject: {subject}
Chapter: {chapter}
Difficulty: {difficulty}

Draw questions from these subtopics (spread them out):
{subtopics_str}

REQUIREMENTS for EACH question:
- Real exam-quality, no plug-and-chug
- Include step-by-step solution in "explanation"
- 2-3 traps in "traps"
- Shortcut if exists
- ALL mathematical formulas MUST be written in LaTeX inside $ ... $ (inline) or $$ ... $$ (display). Example: $\\tau = rF\\sin\\theta$ and $$\\frac{a}{b}$$. Do NOT use plain Unicode for math symbols.
- If diagram needed, include "svg" field

Return a valid JSON ARRAY, no markdown fences:
[
  {{"question":"...","options":["A","B","C","D"],"correct_index":0,
   "explanation":"...","traps":[],"shortcut":"","concept_tested":"...",
   "ideal_time_sec":60,"logic_type":"logic","min_realistic_sec":15,
   "source_type":"Material","source_detail":"Cengage","difficulty":"{difficulty}",
   "subtopic":"..."}}
]

ONLY output the JSON array. Nothing else.
"""

    simple_system = (
        "You output ONLY valid JSON. No prose, no markdown, no fences. "
        "Just the JSON array."
    )

    raw = ask_hamilton_raw(exam, prompt, system_override=simple_system)
    if not raw:
        return []

    text = raw.strip()
    if text.startswith("```"):
        import re
        text = re.sub(r"^```(?:json)?\s*", "", text)
        text = re.sub(r"\s*```\s*$", "", text)

    first = text.find("[")
    last = text.rfind("]")
    if first == -1 or last == -1:
        # Try object wrapper
        first = text.find("{")
        last = text.rfind("}")
        if first == -1:
            return []
        try:
            obj = json.loads(text[first:last+1])
            if isinstance(obj, dict) and "questions" in obj:
                return obj["questions"]
            return [obj]
        except Exception:
            return []

    try:
        arr = json.loads(text[first:last+1])
    except Exception:
        try:
            cleaned = text[first:last+1]
            import re
            cleaned = re.sub(r",\s*]", "]", cleaned)
            cleaned = re.sub(r",\s*}", "}", cleaned)
            arr = json.loads(cleaned)
        except Exception:
            return []

    if not isinstance(arr, list):
        return []

    # Validate + defaults
    out = []
    for q in arr:
        if not isinstance(q, dict) or not q.get("question"):
            continue
        q.setdefault("ideal_time_sec", 60 if q_type == "mcq" else 90)
        q.setdefault("logic_type", "calc" if q_type == "numerical" else "logic")
        q.setdefault("min_realistic_sec", 15 if q_type == "mcq" else 45)
        q.setdefault("difficulty", difficulty)
        q.setdefault("source_type", "AI-Generated")
        q.setdefault("source_detail", "")
        q.setdefault("traps", [])
        q.setdefault("shortcut", "")
        q.setdefault("explanation", "(no explanation)")
        out.append(q)

    return out


