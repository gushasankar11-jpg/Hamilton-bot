# FULL NOTES IN ONE CALL
# ==========================================================
def generate_full_notes(exam, subject, chapter, concepts_list, uid=None, offset=0):
    """
    Adaptive notes. Uses only as many parts as needed, capped at 10 per batch.
    offset = which concept index to start from (for part 2+).
    Returns (parts_list, next_offset, has_more).
    """
    if not concepts_list:
        return [], 0, False

    BATCH_CAP = 10           # Max parts per user request
    MIN_PER_PART = 3         # Min concepts per part
    MAX_PER_PART = 5         # Max concepts per part for depth

    # Adaptive: aim for ~4 concepts per part
    per_part = max(MIN_PER_PART, min(MAX_PER_PART, len(concepts_list) // 6))
    if per_part < 2:
        per_part = 2

    # Slice from offset
    remaining = concepts_list[offset:]
    if not remaining:
        return [], offset, False

    # How many parts needed for the remaining
    needed = (len(remaining) + per_part - 1) // per_part
    use_parts = min(needed, BATCH_CAP)

    all_parts = []
    consumed = 0

    for gi in range(use_parts):
        start_idx = gi * per_part
        group = remaining[start_idx:start_idx + per_part]
        if not group:
            break
        consumed += len(group)

        concepts_str = "\n".join(f"- {c}" for c in group)

        prompt = (
            f"Write EXHAUSTIVE short notes for chapter '{chapter}' ({subject}, {exam}). "
            f"PART {gi+1} of {use_parts} in this batch.\n\n"
            f"Cover these concepts in MAXIMUM depth:\n{concepts_str}\n\n"
            "MATH FORMAT (LaTeX is preferred):\n"
            "- Fractions: $\\frac{a}{b}$\n"
            "- Integrals: $$\\int_0^\\infty e^{-x} dx$$\n"
            "- Sums: $$\\sum_{i=1}^{n} i^2$$\n"
            "- Greek: $\\theta$, $\\pi$, $\\Delta$\n"
            "- Matrices: $$\\begin{bmatrix} a & b \\\\ c & d \\end{bmatrix}$$\n"
            "- Determinants: $$\\begin{vmatrix} a & b \\\\ c & d \\end{vmatrix}$$\n"
            "- Cases: $$\\begin{cases} x^2 & x \\geq 0 \\\\ -x^2 & x < 0 \\end{cases}$$\n"
            "- Vectors: $\\vec{F}$ and $\\vec{F} \\cdot \\vec{r}$\n\n"
            "CONTENT per concept:\n"
            "1. Definition (3-4 lines)\n"
            "2. EVERY formula + variable meanings\n"
            "3. 2-3 common traps\n"
            "4. Shortcut if it exists\n"
            "5. Typical JEE question pattern\n\n"
            "RULES:\n"
            "- NO COMPRESSION. Target 12-15 lines per concept.\n"
            "- Cover every case, every exception, every shortcut.\n"
            "- Warm friendly senior voice.\n"
            "- Use bold (*term*) for key terms.\n"
            "- Structure with headings.\n"
            "- NO code fences around math.\n"
            "Output ONLY this part."
        )

        raw = ask_hamilton(exam, prompt)
        if raw:
            all_parts.append(raw.strip())
        time.sleep(0.2)

    next_offset = offset + consumed
    has_more = next_offset < len(concepts_list)

    return all_parts, next_offset, has_more




def _convert_delims(t):
    if not t:
        return t
    t = t.replace(chr(92) + '[', '$$').replace(chr(92) + ']', '$$')
    t = t.replace(chr(92) + '(', '$').replace(chr(92) + ')', '$')
    return t

def ask_hamilton(exam, prompt, context=None, retries=3):
    r = _orig_ask_hamilton(exam, prompt, context, retries)
    r = _convert_delims(r)
    r = postprocess_ai_output(r)
    return r

def ask_hamilton_raw(exam, prompt, system_override=None, retries=3):
    return _convert_delims(_orig_ask_raw(exam, prompt, system_override, retries))


