# ROTATION LOGIC
# ==========================================================
def _get_next_provider():
    now = time.time()
    n = len(_ROTATION)
    with _LOCK:
        start = _CURRENT[0]
        for offset in range(n):
            idx = (start + offset) % n
            ptype, kidx = _ROTATION[idx]
            if now < _COOLDOWN.get((ptype, kidx), 0):
                continue
            _CURRENT[0] = (idx + 1) % n
            return ptype, kidx
    return None, None


def _mark_fail(ptype, kidx, cooldown_sec=60):
    with _LOCK:
        key = (ptype, kidx)
        _COOLDOWN[key] = time.time() + cooldown_sec
        _FAILS[key] = _FAILS.get(key, 0) + 1


def _mark_ok(ptype, kidx):
    with _LOCK:
        key = (ptype, kidx)
        _FAILS[key] = 0
        _COOLDOWN.pop(key, None)


