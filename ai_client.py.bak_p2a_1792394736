def _call_groq(kidx, system, user, max_tokens=4000, temperature=0.6):
    headers = {
        "Authorization": f"Bearer {GROQ_KEYS[kidx]}",
        "Content-Type": "application/json",
    }
    body = {
        "model": GROQ_MODEL,
        "messages": [
            {"role": "system", "content": system},
            {"role": "user", "content": user},
        ],
        "temperature": temperature,
        "max_tokens": max_tokens,
    }
    try:
        r = requests.post(GROQ_URL, headers=headers,
                          data=json.dumps(body), timeout=60)
        if r.status_code == 200:
            return r.json()["choices"][0]["message"]["content"]
        elif r.status_code == 429:
            _mark_fail("groq", kidx, cooldown_sec=3600)
        elif r.status_code in (401, 403):
            _mark_fail("groq", kidx, cooldown_sec=86400)
        else:
            print(f"[GROQ {kidx}] {r.status_code}: {r.text[:120]}")
            _mark_fail("groq", kidx, cooldown_sec=60)
    except Exception as e:
        print(f"[GROQ {kidx}] err: {e}")
        _mark_fail("groq", kidx, cooldown_sec=60)
    return None


