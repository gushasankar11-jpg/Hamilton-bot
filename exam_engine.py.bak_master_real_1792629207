def generate_quick_question(exam, subject, chapter, difficulty="medium", mode="practice"):
    """Fast generation with strict mode enforcement."""
    import random
    prompt = f"Generate 1 {difficulty} level {exam} {subject} question from chapter '{chapter}'.\n"
    if mode == "conceptual":
        prompt += "This MUST be a theoretical question about the fundamental concept. No numerical calculations.\n"
    elif mode == "exceptional":
        prompt += "This MUST be an exceptional case / boundary condition / trap question. Do not ask standard textbook problems.\n"
    else:
        prompt += "This should be a standard competitive exam style question.\n"
        
    prompt += "Output strictly as JSON: {\"question\":\"...\", \"options\":[\"A\",\"B\",\"C\",\"D\"], \"correct_index\":0, \"explanation\":\"...\", \"ideal_time_sec\":90}"
    
    system = "You are a JSON API. Output ONLY valid JSON. Do not include markdown formatting like ```json. Start directly with { and end with }."
    import ai_client
    raw = ai_client._call_groq(0, system, prompt, max_tokens=800, temperature=0.6)
    if not raw: return None
    
    import json, re
    try:
        txt = raw.strip()
        if txt.startswith("```"): txt = re.sub(r"^```(?:json)?\s*", "", txt); txt = re.sub(r"\s*```\s*$", "", txt)
        data = json.loads(txt)
        data["type"] = "mcq"
        return data
    except:
        return None
