# RECORD CONCEPTUAL ATTEMPT
# ==========================================================
def record_conceptual_attempt(uid, subtopic, correct):
    s = SESSIONS.get(uid)
    if not s or s.get("mode") != "conceptual":
        return
    st = s["subtopic_stats"].setdefault(subtopic, {"attempted": 0, "correct": 0})
    st["attempted"] += 1
    if correct:
        st["correct"] += 1


# ==========================================================
# CONCEPTUAL REPORT
# ==========================================================
def conceptual_report(uid):
    s = SESSIONS.get(uid)
    if not s or s.get("mode") != "conceptual":
        return "No conceptual test running."

    subj = s["subject"]
    chapter = s["chapter"]
    data = health.load_subject_data(subj, s["exam"])
    total_subtopics = len(data.get(chapter, {})) if data and chapter in data else 0
    tested = len(s["subtopic_stats"])

    lines = [
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━",
        f"   🧠 CONCEPTUAL TEST — {s.get('test_type','general').upper()}",
        f"   {subj} → {chapter}",
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━",
        "",
    ]

    if s["questions_done"] == 0:
        lines.append("No questions attempted.")
        return "\n".join(lines)

    acc = round(100 * s["correct"] / s["questions_done"], 1)
    coverage = round(100 * tested / total_subtopics, 1) if total_subtopics else 0

    lines.append(f"🎯 Score: {s['correct']}/{s['questions_done']}")
    lines.append(f"✅ Accuracy: {acc}%")
    lines.append(f"📊 Coverage: {coverage}% of subtopics")
    lines.append(f"⏱️ Time: {round(s['total_time']/60, 1)} min")
    lines.append("")
    lines.append(f"✅ Correct: {s['correct']}")
    lines.append(f"❌ Wrong: {s['wrong']}")
    lines.append(f"🚪 Skipped: {s['skipped']}")
    lines.append("")
    lines.append("━━━ SUBTOPIC BREAKDOWN ━━━")
    for sub, stat in sorted(s["subtopic_stats"].items(),
                            key=lambda x: x[1]["correct"] / max(1, x[1]["attempted"])):
        att = stat["attempted"]
        cor = stat["correct"]
        pct = round(100 * cor / att, 1) if att else 0
        emoji = "🟢" if pct >= 70 else "🟡" if pct >= 50 else "🔴"
        lines.append(f"{emoji} {sub[:30]:<32} {cor}/{att} ({pct}%)")
    return "\n".join(lines)


