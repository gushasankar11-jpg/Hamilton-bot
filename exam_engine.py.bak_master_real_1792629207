# SOURCE HINT
# ==========================================================
def _source_hint():
    roll = random.random()
    if roll < 0.50:
        return "Material-style: " + random.choice(MATERIAL_NAMES)
    if roll < 0.80:
        year = random.choice([2019, 2020, 2021, 2022, 2023, 2024])
        exam = random.choice(["JEE Mains", "JEE Advanced", "EAMCET"])
        return f"PYQ-style from {exam} {year}"
    return "AI-generated conceptual twist"


# ==========================================================
# QUESTION PROMPT BUILDER
# ==========================================================
def _build_question_prompt(exam, subject, chapter, subtopic, q_type="mcq", difficulty="medium", source_hint=""):
    base = f"Generate a {difficulty} level question for {exam} (Subject: {subject}, Chapter: {chapter}, Subtopic: {subtopic}).\n"
    
    if q_type == "conceptual":
        base += "CRITICAL: This MUST be a theoretical / conceptual question. NO NUMERICALS. Ask about the underlying principles, laws, or theoretical reasoning.\n"
    elif q_type == "exceptional":
        base += "CRITICAL: This MUST be an exceptional case / edge case question. Focus on traps, exceptions to the rule, or highly specific rare scenarios. Do NOT generate standard textbook questions.\n"
    elif q_type == "test":
        base += "This is a standard exam-level question. It should be challenging.\n"
    else:
        base += "This is a standard practice question.\n"
        
    base += f"\nSource hint: {source_hint}\n\n"
    base += "STRICT RULES:\n"
    base += "1. ALL mathematical formulas, symbols, variables, and equations MUST be written in LaTeX.\n"
    base += "   - Use $ ... $ for inline math (e.g., $v = u + at$).\n"
    base += "   - Use $$ ... $$ for display math.\n"
    base += "   - Apply this to the question text AND all options.\n"
    base += "2. NEVER use plain Unicode for math. Use \\theta, ^2, \\sqrt, \\pi.\n"
    base += "3. Output strictly as JSON:\n"
    base += '{"question":"...","options":["$...$","$...$","$...$","$...$"],"correct_index":0,"explanation":"...","ideal_time_sec":60,"concept_tested":"..."}'
    return base

