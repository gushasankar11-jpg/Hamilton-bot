def generate_question(exam, subject, chapter, subtopic,
                       q_type="mcq", difficulty="medium"):
    # Normalize q_type — PAPER_PATTERN uses uppercase keys
    q_type = str(q_type).lower()
    if isinstance(q_type, str):
        q_type = q_type.lower()
    if isinstance(q_type, str):
        q_type = q_type.lower()
    if isinstance(q_type, str):
        q_type = q_type.lower()
    """
    Returns a validated question dict or None.
    Retries up to 3 times if Gemini returns bad JSON.
    """
    simple_system = (
        "You are a question generator. Output ONLY valid JSON. "
        "No prose, no markdown fences, no explanations. Just the JSON object. "
        "Use real Unicode symbols (θ, τ, π, √, ²) — never LaTeX."
    )

    for attempt in range(3):
        prompt = _build_question_prompt(exam, subject, chapter, subtopic,
                                         q_type, difficulty, _source_hint())
        raw = ai_client.ask_hamilton_raw(exam, prompt, system_override=simple_system)
        if not raw:
            continue

        text = raw.strip()
        if text.startswith("```"):
            text = re.sub(r"^```(?:json)?\s*", "", text)
            text = re.sub(r"\s*```\s*$", "", text)

        first = text.find("{")
        last = text.rfind("}")
        if first == -1 or last == -1 or last <= first:
            continue

        json_str = text[first:last+1]

        try:
            data = json.loads(json_str)
        except Exception:
            try:
                cleaned = re.sub(r",\s*}", "}", json_str)
                cleaned = re.sub(r",\s*]", "]", cleaned)
                data = json.loads(cleaned)
            except Exception:
                continue

        if not data.get("question"):
            continue

        # Defaults
        data.setdefault("ideal_time_sec", 60 if q_type == "mcq" else 90)
        data.setdefault("logic_type", "calc" if q_type == "numerical" else "logic")
        data.setdefault("min_realistic_sec", 15 if q_type == "mcq" else 45)
        data.setdefault("difficulty", difficulty)
        data.setdefault("source_type", "AI-Generated")
        data.setdefault("source_detail", "")
        data.setdefault("traps", [])
        data.setdefault("shortcut", "")
        data.setdefault("explanation", "(no explanation)")

        # Validate MCQ
        if q_type == "mcq":
            if not data.get("options") or data.get("correct_index") is None:
                continue
            if len(data["options"]) < 4:
                continue

        # Validate numerical
        if q_type == "numerical":
            if data.get("correct_value") is None:
                continue

        # Validate multi
        if q_type == "multi":
            if not data.get("options") or not data.get("correct_indices"):
                continue

        # Validate match
        if q_type == "match":
            if not data.get("options") or data.get("correct_index") is None:
                continue

        return data

    return None


# ==========================================================
# PICK NEXT SUBTOPIC (weakest first from selected/all chapters)
# ==========================================================
def pick_next_subtopic(profile, subject, exam, allowed_chapters=None):
    """
    Returns (subject, chapter, subtopic) or None.
    If allowed_chapters is provided (list), restrict to those.
    Otherwise use profile.selected_chapters.
    """
    data = health.load_subject_data(subject, exam)
    if not data:
        return None

    if allowed_chapters is None:
        allowed_chapters = profile.get("selected_chapters", {}).get(subject, [])

    allowed_set = set(allowed_chapters) if allowed_chapters else None

    candidates = []
    for chapter, subs in data.items():
        if allowed_set and chapter not in allowed_set:
            continue
        for sub in subs.keys():
            h = health.subtopic_health(profile, subject, chapter, sub)
            score = h if h is not None else 0.0
            candidates.append((score, chapter, sub))

    if not candidates:
        return None

    candidates.sort(key=lambda x: x[0])
    top_pool = candidates[:min(8, len(candidates))]
    _, ch, sub = random.choice(top_pool)
    return (subject, ch, sub)


# ==========================================================
# TEST PAPER PLANNER
# ==========================================================
def build_test_plan(exam, subjects, allowed_chapters):
    """
    subjects: list of subject names (must include all 3 for a real paper)
    allowed_chapters: dict {subject: [chapter1, chapter2, ...]}
    Returns list of (subject, chapter, subtopic, q_type, difficulty) tuples.
    """
    pattern = PAPER_PATTERN.get(exam, {})
    plan = []

    for subject in subjects:
        subject_pattern = pattern.get(subject, {})
        chapters = allowed_chapters.get(subject, [])
        if not chapters:
            continue

        # Get all subtopics in allowed chapters
        subj_data = health.load_subject_data(subject, exam)
        if not subj_data:
            continue

        all_subtopics = []
        for ch in chapters:
            if ch not in subj_data:
                continue
            for sub in subj_data[ch].keys():
                all_subtopics.append((ch, sub))

        if not all_subtopics:
            continue

        for q_type, count in subject_pattern.items():
            for i in range(count):
                ch, sub = random.choice(all_subtopics)
                # Simple difficulty mix: 30% easy, 50% medium, 20% hard
                r = random.random()
                if r < 0.30:
                    diff = "easy"
                elif r < 0.80:
                    diff = "medium"
                else:
                    diff = "hard"
                plan.append((subject, ch, sub, q_type, diff))

    random.shuffle(plan)
    return plan


