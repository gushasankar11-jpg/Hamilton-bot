def session_report(uid):
    s = SESSIONS.get(uid)
    if not s:
        return "No active session."
    lines = [
        "🏁 SESSION COMPLETE",
        "",
        f"📝 Questions: {s['questions_done']}",
        f"   ✅ Correct: {s['correct']}",
        f"   ❌ Wrong: {s['wrong']}",
        f"   🚪 Skipped: {s['skipped']}",
    ]
    if s["questions_done"] > 0:
        acc = round(100 * s["correct"] / s["questions_done"], 1)
        lines.append(f"🎯 Accuracy: {acc}%")
    lines.append(f"⏱️ Total time: {round(s['total_time']/60, 1)} min")
    return "\n".join(lines)


# ==========================================================
# TEST PAPER SCORE
# ==========================================================
def test_paper_score(exam, correct, wrong, skipped):
    from config import MARKING
    m = MARKING.get(exam, {"MCQ": 4, "MCQ_wrong": -1})
    mcq_c = m.get("MCQ", 4)
    mcq_w = m.get("MCQ_wrong", -1)
    score = correct * mcq_c + wrong * mcq_w
    max_score = (correct + wrong + skipped) * mcq_c
    return score, max_score


