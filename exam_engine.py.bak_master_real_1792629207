def start_conceptual_test(uid, subject, chapter, total_q, test_type="general"):
    profile = health.load_profile(uid) or {}
    exam = health.exam_of(profile) or "JEE_MAIN"
    data = health.load_subject_data(subject, exam)
    if not data or chapter not in data:
        return None

    subs = data[chapter]
    all_subtopics = list(subs.keys())
    if not all_subtopics:
        return None

    plan = []
    if total_q >= len(all_subtopics):
        plan = list(all_subtopics)
        extra = total_q - len(all_subtopics)
        for _ in range(extra):
            plan.append(random.choice(all_subtopics))
    else:
        plan = random.sample(all_subtopics, total_q)
    random.shuffle(plan)

    SESSIONS[uid] = {
        "mode": "conceptual",
        "test_type": test_type,
        "exam": exam,
        "subject": subject,
        "chapter": chapter,
        "plan": plan,
        "index": 0,
        "total_q": total_q,
        "started_at": time.time(),
        "questions_done": 0,
        "correct": 0,
        "wrong": 0,
        "skipped": 0,
        "total_time": 0,
        "subtopic_stats": {},
        "current_q": None,
        "current_meta": None,
        "current_started": None,
        "last_q": None,
        "last_meta": None,
    }
    return SESSIONS[uid]


def get_session(uid):
    return SESSIONS.get(uid)


def end_session(uid):
    return SESSIONS.pop(uid, None)


