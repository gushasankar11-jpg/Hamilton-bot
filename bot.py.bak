# ==========================================================
# GATING + COUNTDOWN FOOTER
# ==========================================================
def _profile_ready(uid):
    """Returns (ready_bool, reason_str_or_None)."""
    p = load_profile(uid)
    if not p:
        return False, "no_profile"
    if not p.get("secured"):
        return False, "not_secured"
    if not p.get("name") or not p.get("institute") or not p.get("level"):
        return False, "not_onboarded"
    if not p.get("exams"):
        return False, "no_exams"
    if not p.get("target_year"):
        return False, "no_year"
    return True, None


def _countdown_footer(uid):
    """Returns the countdown footer string, or '' if not available."""
    p = load_profile(uid)
    if not p:
        return ""
    exams = p.get("exams", [])
    priority = p.get("priority")
    year = p.get("target_year")
    if not exams or not year:
        return ""

    today = datetime.now().date()
    lines = []
    # Priority first
    ordered = []
    if priority and priority in exams:
        ordered.append(priority)
    for e in exams:
        if e not in ordered:
            ordered.append(e)

    for e in ordered:
        days = _days_until_exam(e, year)
        if days is None:
            continue
        name = EXAM_NAMES.get(e, e)
        if e == priority:
            lines.append(f"⏳ *{name} {year}: {days} days left* (primary)")
        else:
            lines.append(f"⏳ {name} {year}: {days} days left")

    if not lines:
        return ""
    return "\n\n━━━━━━━━━━━━━━━\n" + "\n".join(lines)


def _days_until_exam(exam, year):
    """Returns integer days until exam, using fixed month/day per exam."""
    MONTH_DAY = {
        "JEE_ADV":  (5, 18),
        "JEE_MAIN": (1, 22),
        "EAMCET":   (5, 5),
    }
    if exam not in MONTH_DAY:
        return None
    m, d = MONTH_DAY[exam]
    try:
        exam_date = datetime(year, m, d).date()
    except Exception:
        return None
    today = datetime.now().date()
    delta = (exam_date - today).days
    return max(0, delta)


def _send_setup_prompt(uid, reason):
    """Sends the appropriate setup prompt based on what's missing."""
    msgs = {
        "not_secured":  "🔒 Please activate first. Send your key.",
        "not_onboarded": "⚠️ *Finish your profile setup first.*\n\nSend /start to continue onboarding.",
        "no_exams":     "⚠️ *Complete your setup first.*\n\nType /mode to choose your exams and target year.",
        "no_year":      "⚠️ *Almost there.*\n\nType /mode to set your target year.",
        "no_profile":   "⚠️ *Welcome!*\n\nSend /start to begin.",
    }
    safe_send(uid, msgs.get(reason, "⚠️ Please complete setup with /mode first."))

def safe_edit(chat_id, message_id, text, parse_mode=None):
    try:
        if len(text) > TELEGRAM_MSG_LIMIT:
            bot.edit_message_text(chat_id=chat_id, message_id=message_id,
                                  text=text[:TELEGRAM_MSG_LIMIT], parse_mode=parse_mode)
            safe_send(chat_id, text[TELEGRAM_MSG_LIMIT:], parse_mode=parse_mode)
        else:
            bot.edit_message_text(chat_id=chat_id, message_id=message_id,
                                  text=text, parse_mode=parse_mode)
    except Exception:
        safe_send(chat_id, text, parse_mode=parse_mode)

