def _pricing_message(selected_exams=None):
    """Returns the pricing message, highlighting student's exams if known."""
    def _fmt(exam_code, price, label):
        line = f"📘 *{label}* — ₹{price}"
        if selected_exams and exam_code in selected_exams:
            line = f"👉 *{line}*  ← your plan"
        return line

    return (
        "💰 *Pricing* (valid from now to your last day of preparation):\n\n"
        f"{_fmt('JEE_ADV', 150, 'JEE Advanced')}\n"
        "   _longest prep window, deepest content_\n\n"
        f"{_fmt('JEE_MAIN', 100, 'JEE Mains')}\n"
        "   _focused, syllabus-aligned_\n\n"
        f"{_fmt('EAMCET', 120, 'EAMCET')}\n"
        "   _extended duration, state-level prep_"
    )


