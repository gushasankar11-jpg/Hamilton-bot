@bot.message_handler(commands=['start'])
def cmd_start(message):
    uid = message.chat.id
    p = get_or_create_profile(uid)

    if not p.get("secured"):
        save_profile(uid, p)
        bot.reply_to(message,
            "🙏 *Namaskaram, Aspirant!*\n\n"
            "You stand in the final stretch of your *Intermediate journey* — "
            "balancing board studies with deep, focused preparation for your "
            "competitive exams.\n\n"
            "I am *Hamilton Study AI* *(by Hemanth and Krishna Publications)*, "
            "your personal exam mentor — built to walk beside you every single "
            "day until your rank is sealed.\n\n"
            "🔒 *To begin, send your activation key.*",
            parse_mode="Markdown")
        return

    if p.get("onboarding_step") and p["onboarding_step"] != "done":
        _run_onboarding(uid)
        return

    bot.reply_to(message,
        f"🙏 *Welcome back, {p.get('name', 'Aspirant')}!*\n\n"
        "Type /mode to set up exams, /health to see progress.",
        parse_mode="Markdown")

# ==========================================================
# ONBOARDING
# ==========================================================
def _run_onboarding(uid):
    p = load_profile(uid)
    step = p.get("onboarding_step")
    if step == "name":
        msg = bot.send_message(uid, "📝 *What is your name?*", parse_mode="Markdown")
        bot.register_next_step_handler(msg, _onboarding_name)
    elif step == "institute":
        msg = bot.send_message(uid, "🏫 *Which institute / school / college?*", parse_mode="Markdown")
        bot.register_next_step_handler(msg, _onboarding_institute)
    elif step == "level":
        markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
        markup.add("Junior", "Senior", "Dropper")
        msg = bot.send_message(uid, "🎓 *Junior, Senior, or Dropper?*",
            reply_markup=markup, parse_mode="Markdown")
        bot.register_next_step_handler(msg, _onboarding_level)
    else:
        bot.send_message(uid, "✅ Setup complete. Type /mode to begin.")

def _onboarding_name(message):
    uid = message.chat.id
    n = (message.text or "").strip()[:40]
    if not n:
        bot.reply_to(message, "Please type your name."); return
    p = load_profile(uid)
    p["name"] = n
    p["onboarding_step"] = "institute"
    save_profile(uid, p)
    _run_onboarding(uid)

def _onboarding_institute(message):
    uid = message.chat.id
    i = (message.text or "").strip()[:60]
    if not i:
        bot.reply_to(message, "Please type your institute."); return
    p = load_profile(uid)
    p["institute"] = i
    p["onboarding_step"] = "level"
    save_profile(uid, p)
    _run_onboarding(uid)

def _onboarding_level(message):
    uid = message.chat.id
    t = (message.text or "").strip().lower()
    if t not in ("junior", "senior", "dropper"):
        bot.reply_to(message, "Tap one of: Junior / Senior / Dropper"); return
    p = load_profile(uid)
    p["level"] = t.capitalize()
    p["onboarding_step"] = "done"
    save_profile(uid, p)
    bot.reply_to(message,
        f"✅ *Profile saved*\n\n👤 {p['name']}\n🏫 {p['institute']}\n🎓 {p['level']}\n\n"
        "Now choose exams: /mode",
        reply_markup=telebot.types.ReplyKeyboardRemove(),
        parse_mode="Markdown")

# ==========================================================
# /mode
# ==========================================================
# ==========================================================
# /mode — full setup flow
# exams → priority → priority% → year → papers → marks → done
# ==========================================================
@bot.message_handler(commands=['mode'])
def cmd_mode(message):
    uid = message.chat.id
    p = load_profile(uid)
    if not p or not p.get("secured"):
        bot.reply_to(message, "🔒 Activate first."); return

    if p.get("exams") and p.get("target_year"):
        current = ", ".join(EXAM_NAMES[e] for e in p["exams"])
        msg = bot.reply_to(message,
            f"🎯 *Current setup:*\n"
            f"Exams: {current}\n"
            f"Priority: {EXAM_NAMES.get(p.get('priority','—'), '—')}\n"
            f"Year: {p.get('target_year')}\n\n"
            "Change setup? YES to redo, NO to keep.",
            parse_mode="Markdown")
        bot.register_next_step_handler(msg, _mode_confirm)
        return
    _mode_start(uid)

def _mode_confirm(message):
    uid = message.chat.id
    if (message.text or "").strip().lower() == "yes":
        _mode_start(uid)
    else:
        bot.reply_to(message, "✅ Setup unchanged.")

def _mode_start(uid):
    msg = bot.send_message(uid,
        "🎯 *Choose target exam(s):*\n\n"
        "*A* → JEE Advanced\n*B* → JEE Mains\n*C* → EAMCET\n\n"
        "Reply combo: `A`, `B`, `C`, `AB`, `BC`, `AC`, `ABC`",
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, _mode_exams)

def _mode_exams(message):
    uid = message.chat.id
    p = load_profile(uid)
    sel = [EXAM_OPTIONS[c] for c in (message.text or "").strip().upper() if c in EXAM_OPTIONS]
    if not sel:
        bot.reply_to(message, "❌ Invalid. Send A, B, C, AB, BC, AC or ABC."); return

    p["exams"] = sel
    p["priority"] = None
    p["priority_pct"] = 100
    p["target_year"] = None
    p["advanced_papers"] = None
    p["target_marks"] = {}
    save_profile(uid, p)

    if len(sel) == 1:
        p["priority"] = sel[0]
        p["priority_pct"] = 100
        save_profile(uid, p)
        _mode_ask_year(uid)
        return

    # Multiple → ask priority
    names = " / ".join(EXAM_NAMES[e] for e in sel)
    msg = bot.reply_to(message,
        f"🎯 Active exams: *{names}*\n\n"
        "*Which is your PRIMARY target?*\n"
        "Reply with the exam name exactly.",
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, _mode_priority)

def _mode_priority(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip()
    chosen = next((e for e in p["exams"] if EXAM_NAMES[e].lower() == t.lower()), None)
    if not chosen:
        bot.reply_to(message, "❌ Not recognised. Type the exam name exactly."); return
    p["priority"] = chosen
    save_profile(uid, p)

    msg = bot.reply_to(message,
        f"✅ Primary: *{EXAM_NAMES[chosen]}*\n\n"
        "*Priority focus %?*\n"
        "Reply: `100`, `80`, `70`, `60`, `50` or a custom number 50–100",
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, _mode_pct)

def _mode_pct(message):
    uid = message.chat.id
    p = load_profile(uid)
    try:
        pct = int((message.text or "").strip())
        if pct < 50 or pct > 100:
            raise ValueError
    except ValueError:
        bot.reply_to(message, "❌ Send a number between 50 and 100."); return
    p["priority_pct"] = pct
    save_profile(uid, p)
    _mode_ask_year(uid)

def _mode_ask_year(uid):
    current = datetime.now().year
    max_yr = current + MAX_FUTURE_YEARS
    msg = bot.send_message(uid,
        f"📅 *Which YEAR are you targeting?*\n\n"
        f"Type the year (e.g., `{current+1}`).\n"
        f"Range allowed: {current}–{max_yr}",
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, _mode_year)

def _mode_year(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip()
    current = datetime.now().year
    max_yr = current + MAX_FUTURE_YEARS

    if not t.isdigit():
        bot.reply_to(message, f"❌ Please type a year like {current+1}."); return
    yr = int(t)
    if yr < current:
        bot.reply_to(message, f"❌ That year has passed. Try {current+1}+."); return
    if yr > max_yr:
        bot.reply_to(message,
            f"🤔 Seriously? Max allowed is {max_yr}. Try again."); return

    p["target_year"] = yr
    save_profile(uid, p)

    # If Advanced selected → ask papers FIRST
    if "JEE_ADV" in p["exams"]:
        markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
        markup.add("1 Paper", "2 Papers")
        msg = bot.send_message(uid,
            "📄 *JEE Advanced — How many papers will you write?*\n"
            "• One Paper (single day)\n"
            "• Two Papers (Paper 1 + Paper 2)",
            reply_markup=markup, parse_mode="Markdown")
        bot.register_next_step_handler(msg, _mode_adv_papers)
        return

    # Non-Advanced → go to marks
    _mode_start_marks(uid)

def _mode_adv_papers(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip().lower()
    if "1" in t:
        p["advanced_papers"] = 1
    elif "2" in t:
        p["advanced_papers"] = 2
    else:
        bot.reply_to(message, "Reply 1 Paper or 2 Papers."); return
    save_profile(uid, p)
    _mode_start_marks(uid)

# ----------------------------------------------------------
# Marks collection (one per selected exam)
# ----------------------------------------------------------
def _mode_start_marks(uid):
    p = load_profile(uid)
    p["_marks_queue"] = list(p["exams"])
    p["target_marks"] = {}
    save_profile(uid, p)
    _mode_ask_next_mark(uid)

def _mode_ask_next_mark(uid):
    p = load_profile(uid)
    queue = p.get("_marks_queue", [])
    if not queue:
        _mode_finish(uid)
        return

    exam = queue.pop(0)
    p["_marks_queue"] = queue
    save_profile(uid, p)

    max_m = _max_marks_for(exam, p)
    msg = bot.send_message(uid,
        f"🎯 *Expected marks for {EXAM_NAMES[exam]}?*\n\n"
        f"Maximum possible: *{max_m}*\n"
        f"Type your expected total marks.",
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, _mode_capture_marks, exam, max_m)

def _mode_capture_marks(message, exam, max_m):
    uid = message.chat.id
    p = load_profile(uid)
    try:
        val = int((message.text or "").strip())
        if val < 0 or val > max_m:
            raise ValueError
    except ValueError:
        bot.reply_to(message, f"❌ Send a number between 0 and {max_m}.")
        p["_marks_queue"].insert(0, exam)
        save_profile(uid, p)
        _mode_ask_next_mark(uid)
        return

    p.setdefault("target_marks", {})
    p["target_marks"][exam] = val
    save_profile(uid, p)
    _mode_ask_next_mark(uid)

# ----------------------------------------------------------
# Max marks per exam
# ----------------------------------------------------------
def _max_marks_for(exam, profile):
    if exam == "JEE_ADV":
        papers = profile.get("advanced_papers", 1) or 1
        return 180 * papers   # 1 paper = 180, 2 papers = 360
    if exam == "JEE_MAIN":
        return 300
    if exam == "EAMCET":
        return 160
    return 100

# ----------------------------------------------------------
# Final summary
# ----------------------------------------------------------
def _mode_finish(uid):
    p = load_profile(uid)
    names = ", ".join(EXAM_NAMES[e] for e in p["exams"])
    lines = ["━━━━━━━━━━━━━━━━━━━━━━━━━━━",
             "   ✅ *SETUP COMPLETE*",
             "━━━━━━━━━━━━━━━━━━━━━━━━━━━", "",
             f"👤 {p['name']}",
             f"🏫 {p['institute']}",
             f"🎓 {p['level']}", "",
             f"📚 Exams: {names}"]

    if p.get("priority") and len(p["exams"]) > 1:
        lines.append(f"🎯 Priority: {EXAM_NAMES[p['priority']]} ({p['priority_pct']}%)")

    lines.append(f"📅 Target year: {p['target_year']}")

    if p.get("advanced_papers"):
        lines.append(f"📄 Advanced papers: {p['advanced_papers']}")

    # Marks
    targets = p.get("target_marks", {})
    if targets:
        lines.append("")
        lines.append("🎯 Expected marks:")
        for e in p["exams"]:
            if e in targets:
                max_m = _max_marks_for(e, p)
                lines.append(f"   {EXAM_NAMES[e]}: *{targets[e]} / {max_m}*")

    lines += ["", "Next steps:",
              "👉 /select — pick your focus chapters",
              "👉 /exam — start practice",
              "👉 /health — see readiness",
              "👉 /target — update marks anytime"]

    bot.send_message(uid, "\n".join(lines),
                     reply_markup=telebot.types.ReplyKeyboardRemove(),
                     parse_mode="Markdown")

# ==========================================================
# /health, /stop
# ==========================================================
@bot.message_handler(commands=['health'])
def cmd_health(message):
    uid = message.chat.id
    p = load_profile(uid)
    if not p or not p.get("secured"):
        bot.reply_to(message, "🔒 Activate first."); return
    safe_send(uid, health.render_full_health(p))

@bot.message_handler(commands=['stop'])
def cmd_stop(message):
    uid = message.chat.id
    sess = exam_engine.get_session(uid)
    if not sess:
        bot.reply_to(message, "No active session."); return
    p = load_profile(uid)
    if p:
        p["_practice_active"] = False
        save_profile(uid, p)
    report = exam_engine.session_report(uid)
    exam_engine.end_session(uid)
    safe_send(uid, report)

