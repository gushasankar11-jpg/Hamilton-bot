# CONCEPTUAL
# ==========================================================
def _start_conceptual(uid):
    p = load_profile(uid)
    exam = health.exam_of(p)
    subj = "Maths"
    data = health.load_subject_data(subj, exam)
    if not data:
        bot.send_message(uid, "❌ No data."); return
    chapter_list = list(data.keys())
    numbered = "\n".join(f"{i+1}. {c}" for i, c in enumerate(chapter_list))
    msg = bot.send_message(uid,
        f"🧠 *Conceptual Test — {subj}*\n\n{numbered[:3500]}\n\nPick chapter number.",
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, _concept_chapter, subj, chapter_list)

def _concept_chapter(message, subj, chapter_list):
    uid = message.chat.id
    try:
        idx = int((message.text or "").strip()) - 1
        if idx < 0 or idx >= len(chapter_list): raise ValueError
    except ValueError:
        bot.reply_to(message, "❌ Invalid."); return
    chapter = chapter_list[idx]
    msg = bot.send_message(uid,
        f"🧠 *{chapter}* — How many questions? Reply 40/60/80/100",
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, _concept_count, subj, chapter)

def _concept_count(message, subj, chapter):
    uid = message.chat.id
    try:
        n = int((message.text or "").strip())
        if n < 40 or n > 100: raise ValueError
    except ValueError:
        bot.reply_to(message, "❌ Send 40, 60, 80, or 100."); return
    exam_engine.start_conceptual_test(uid, subj, chapter, n)
    safe_send(uid,
        f"🧠 *Conceptual test started* — {chapter}\nQuestions: {n}",
        parse_mode="Markdown")

# ==========================================================
# LEADERBOARD
# ==========================================================
def _compute_leaderboard():
    entries = []
    for fname in os.listdir(PROFILE_DIR):
        if not fname.endswith(".json"): continue
        uid = fname.replace(".json", "")
        try:
            with open(os.path.join(PROFILE_DIR, fname)) as f:
                p = json.load(f)
        except Exception: continue
        if not p.get("secured") or not p.get("name"): continue
        if not p.get("leaderboard_optin", True): continue
        if not p.get("exams"): continue
        attempted = correct = 0
        for ch, concepts in p.get("concept_stats", {}).items():
            for c, stat in concepts.items():
                attempted += stat.get("attempts", 0)
                correct += stat.get("correct", 0)
        if attempted < 20: continue
        report = health.overall_health(p)
        h = report.get("overall") or 0
        pct = _predict_percentile(h)
        score = 0.4*h + 0.4*pct + 0.2*min(100, attempted/5)
        entries.append({
            "uid": uid, "name": p.get("name"), "institute": p.get("institute","—"),
            "level": p.get("level","—"),
            "exam": ", ".join(EXAM_NAMES.get(e,e) for e in p["exams"]),
            "health": round(h,1), "percentile": pct,
            "attempted": attempted, "correct": correct,
            "wrong": attempted-correct,
            "accuracy": round(100*correct/attempted,1) if attempted else 0,
            "score": round(score,1)
        })
    entries.sort(key=lambda x: x["score"], reverse=True)
    return entries

def _predict_percentile(h):
    if h>=90: return 99.5
    if h>=85: return 99.0
    if h>=80: return 98.0
    if h>=75: return 96.5
    if h>=70: return 94.0
    if h>=65: return 91.0
    if h>=60: return 87.0
    if h>=55: return 82.0
    if h>=50: return 76.0
    if h>=45: return 70.0
    return round(h*1.5, 1)

@bot.message_handler(commands=['leaderboard'])
def cmd_leaderboard(message):
    uid = message.chat.id
    entries = _compute_leaderboard()
    if not entries:
        bot.reply_to(message, "📭 No qualifying users yet (min 20 attempts)."); return
    lines = ["🏆 *LEADERBOARD*\n"]
    for i, e in enumerate(entries[:20], 1):
        medal = "🥇" if i==1 else "🥈" if i==2 else "🥉" if i==3 else f"{i}."
        lines.append(f"{medal} *{e['name']}* — Health {e['health']} · %ile {e['percentile']}")
    lines.append("\nSay `top 3` to see rank #3 in detail.")
    safe_send(uid, "\n".join(lines))

@bot.message_handler(func=lambda m: m.text and m.text.lower().startswith("top "))
def cmd_top(message):
    uid = message.chat.id
    try:
        n = int(message.text.split()[1])
        if n < 1 or n > 20: raise ValueError
    except Exception:
        bot.reply_to(message, "Usage: top 3"); return
    entries = _compute_leaderboard()
    if not entries or n > len(entries):
        bot.reply_to(message, "No data."); return
    e = entries[n-1]
    safe_send(uid,
        f"🏆 *Rank #{n}*\n\n👤 {e['name']}\n🏫 {e['institute']}\n🎓 {e['level']}\n"
        f"📚 {e['exam']}\n\n📊 Health: {e['health']}\n🎯 %ile: {e['percentile']}\n"
        f"📝 Attempted: {e['attempted']}\n✅ Correct: {e['correct']}\n❌ Wrong: {e['wrong']}\n"
        f"🎯 Accuracy: {e['accuracy']}%")

# ==========================================================
# BOOKMARKS, PLAN, TARGET
# ==========================================================
@bot.message_handler(commands=['bookmarks'])
def cmd_bookmarks(message):
    uid = message.chat.id
    bpath = os.path.join(BOOKMARK_DIR, f"{uid}.json")
    if not os.path.exists(bpath):
        bot.reply_to(message, "📭 No bookmarks."); return
    with open(bpath) as f: bm = json.load(f)
    if not bm:
        bot.reply_to(message, "📭 No bookmarks."); return
    lines = [f"🔖 *Bookmarks* ({len(bm)})"]
    for i, b in enumerate(bm[:20], 1):
        lines.append(f"{i}. {b.get('question','')[:60]}")
    safe_send(uid, "\n".join(lines))

@bot.message_handler(commands=['plan'])
def cmd_plan(message):
    uid = message.chat.id
    p = load_profile(uid)
    if not p or not p.get("secured"):
        bot.reply_to(message, "🔒 Activate first."); return
    r = health.overall_health(p)
    if r["overall"] is None:
        bot.reply_to(message, "📭 No data yet. /exam first."); return
    lines = [f"📋 *STUDY PLAN*\nTarget: {EXAM_NAMES.get(r['exam'],r['exam'])} {p.get('target_year','')}",
             f"Overall health: {r['overall']}/100", ""]
    for s, d in r["subjects"].items():
        if d["health"] is not None:
            lines.append(f"📘 {s}: {d['health']}/100")
    lines.append("\nFocus on weakest chapters in /health.")
    safe_send(uid, "\n".join(lines))

@bot.message_handler(commands=['target'])
def cmd_target(message):
    uid = message.chat.id
    msg = bot.send_message(uid,
        "🎯 *Expected total marks?* (0-500)", parse_mode="Markdown")
    bot.register_next_step_handler(msg, _set_target)

def _set_target(message):
    uid = message.chat.id
    p = load_profile(uid)
    try:
        t = int((message.text or "").strip())
        if t < 0 or t > 500: raise ValueError
    except ValueError:
        bot.reply_to(message, "❌ Send 0-500."); return
    p["target_marks"] = t
    save_profile(uid, p)
    safe_send(uid, f"🎯 Target set: *{t} marks*", parse_mode="Markdown")

