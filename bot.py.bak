@bot.message_handler(commands=['select'])
def cmd_select(message):
    uid = message.chat.id
    p = load_profile(uid)
    if not p or not p.get("secured"):
        bot.reply_to(message, "🔒 Activate first."); return
    msg = bot.send_message(uid,
        "🎯 *Which subject?* Reply: Maths / Physics / Chemistry",
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, _select_subject)

def _select_subject(message):
    uid = message.chat.id
    p = load_profile(uid)
    subj = (message.text or "").strip().capitalize()
    if subj not in health.available_subjects():
        bot.reply_to(message, f"❌ Not available. Try: {', '.join(health.available_subjects())}")
        return
    exam = health.exam_of(p)
    data = health.load_subject_data(subj, exam)
    if not data:
        bot.reply_to(message, f"❌ No data for {subj}."); return
    chapter_list = list(data.keys())
    numbered = "\n".join(f"{i+1}. {c}" for i, c in enumerate(chapter_list))
    msg = bot.send_message(uid,
        f"📚 *{subj} — {len(chapter_list)} chapters*\n\n{numbered}\n\n"
        "Reply numbers like `1,4,7,12` or `ALL`.",
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, _select_chapters, subj, chapter_list)

def _select_chapters(message, subj, chapter_list):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip()
    if t.upper() == "ALL":
        chosen = chapter_list
    else:
        try:
            idxs = [int(x.strip()) - 1 for x in t.split(",") if x.strip()]
            chosen = [chapter_list[i] for i in idxs if 0 <= i < len(chapter_list)]
        except Exception:
            bot.reply_to(message, "❌ Invalid. Try /select again."); return
    if not chosen:
        bot.reply_to(message, "❌ No valid chapters."); return
    p.setdefault("selected_chapters", {})
    p["selected_chapters"][subj] = chosen
    save_profile(uid, p)
    bot.reply_to(message,
        f"✅ *{subj}: {len(chosen)} chapters selected*", parse_mode="Markdown")

# ==========================================================
# /exam
# ==========================================================
@bot.message_handler(commands=['exam'])
def cmd_exam(message):
    uid = message.chat.id
    p = load_profile(uid)
    if not p or not p.get("secured"):
        bot.reply_to(message, "🔒 Activate first."); return
    if not p.get("exams"):
        bot.reply_to(message, "🎯 Set exams with /mode first."); return
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    markup.add("Practice", "Test", "Conceptual")
    msg = bot.send_message(uid,
        "🎯 *Choose mode:*\n📚 Practice\n📝 Test\n🧠 Conceptual",
        reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, _exam_mode)

def _exam_mode(message):
    uid = message.chat.id
    t = (message.text or "").strip().lower()
    if t == "practice":
        _start_practice(uid)
    elif t == "test":
        _start_test(uid)
    elif t == "conceptual":
        _start_conceptual(uid)
    else:
        bot.reply_to(message, "Tap Practice / Test / Conceptual.")

# ==========================================================
# PRACTICE
# ==========================================================
def _start_practice(uid):
    p = load_profile(uid)
    if not p.get("selected_chapters"):
        bot.send_message(uid, "⚠️ First use /select to pick chapters."); return
    exam = health.exam_of(p)
    p["_practice_active"] = True
    save_profile(uid, p)
    exam_engine.new_practice_session(uid)
    bot.send_message(uid,
        f"🚀 *Practice started* ({EXAM_NAMES.get(exam, exam)})\n"
        "Answer the poll. /next for next, /stop to end.",
        parse_mode="Markdown")
    _send_next_practice(uid)

def _send_next_practice(uid):
    p = load_profile(uid)
    exam = health.exam_of(p)
    if not exam:
        safe_send(uid, "❌ Exam not set."); return
    pick = None
    for subj in health.available_subjects():
        pick = exam_engine.pick_next_concept(p, subj, exam)
        if pick: break
    if not pick:
        safe_send(uid, "❌ No chapters available. /select first."); return
    subj, chapter, subtopic, concept = pick
    bot.send_chat_action(uid, "typing")
    q = exam_engine.generate_question(exam, subj, chapter, subtopic, q_type="mcq")
    if not q:
        safe_send(uid, "🔄 Regenerating..."); time.sleep(1)
        _send_next_practice(uid); return
    sess = exam_engine.get_session(uid)
    if not sess: return
    sess["current_q"] = q
    sess["current_started"] = time.time()
    sess["current_meta"] = {"subject": subj, "chapter": chapter,
                            "subtopic": subtopic, "concept": concept}
    options = q.get("options", [])[:4]
    if len(options) < 2:
        safe_send(uid, "🔄 Bad format, regenerating..."); time.sleep(1)
        _send_next_practice(uid); return
    options_with_skip = options + ["🚪 Skip"]
    try:
        bot.send_poll(
            chat_id=uid,
            question=f"[{EXAM_NAMES.get(exam, exam)} | {chapter[:30]}]\n{q['question']}"[:300],
            options=options_with_skip[:10],
            type="quiz",
            correct_option_id=int(q.get("correct_index", 0)),
            explanation=(q.get("explanation", "") or "")[:200],
            is_anonymous=False,
        )
    except Exception as e:
        safe_send(uid, f"🔄 Retry... {e}"); time.sleep(1)
        _send_next_practice(uid)

@bot.poll_answer_handler()
def on_poll_answer(poll_answer):
    uid = poll_answer.user.id
    sess = exam_engine.get_session(uid)
    if not sess: return
    q = sess.get("current_q")
    if not q: return
    selected = poll_answer.option_ids[0] if poll_answer.option_ids else -1
    options = q.get("options", [])
    time_taken = time.time() - sess.get("current_started", time.time())
    sess["total_time"] += time_taken
    sess["questions_done"] += 1
    meta = sess.get("current_meta", {})

    if selected == len(options):
        sess["skipped"] += 1
        safe_send(uid,
            f"🚪 *Skipped*\n\n📖 Solution:\n{q.get('explanation','')}\n\n"
            f"⚡ Shortcut: {q.get('shortcut','(none)')}\n\n"
            "Reply /next for next, /stop to end.",
            parse_mode="Markdown")
        sess["current_q"] = None
        return

    correct = int(selected) == int(q.get("correct_index", -1))
    if correct: sess["correct"] += 1
    else: sess["wrong"] += 1
    try:
        health.record_attempt(uid, meta.get("subject",""), meta.get("chapter",""),
                              meta.get("subtopic",""), meta.get("concept",""),
                              correct, int(time_taken), int(q.get("ideal_time_sec", 60)))
    except Exception:
        pass
    head = "✅ *CORRECT!*" if correct else \
           f"❌ *WRONG — You chose {chr(65+selected)}, correct is {chr(65+q['correct_index'])}*"
    msg = (f"{head}\n\n⏱️ {int(time_taken)}s (ideal: {q.get('ideal_time_sec',60)}s)\n\n"
           f"📖 Solution:\n{q.get('explanation','')}\n\n"
           f"⚡ Shortcut: {q.get('shortcut','(none)')}\n\n"
           "Reply /next for next, /stop to end.")
    safe_send(uid, msg)
    sess["current_q"] = None

@bot.message_handler(commands=['next'])
def cmd_next(message):
    uid = message.chat.id
    if not exam_engine.get_session(uid):
        bot.reply_to(message, "Start with /exam first."); return
    _send_next_practice(uid)

# ==========================================================
# TEST
# ==========================================================
def _start_test(uid):
    p = load_profile(uid)
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    for e in p["exams"]:
        markup.add(EXAM_NAMES[e])
    msg = bot.send_message(uid, "📝 *Which exam to test?*",
        reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, _test_exam)

def _test_exam(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip()
    chosen = next((e for e in p["exams"] if EXAM_NAMES[e].lower() == t.lower()), None)
    if not chosen:
        bot.reply_to(message, "❌ Pick one shown."); return
    minutes = exam_engine.EXAM_STRUCTURE[chosen]["duration_min"]
    bot.send_message(uid,
        f"📝 *Test starting*\n\nExam: {EXAM_NAMES[chosen]}\n"
        f"Duration: {minutes} min\n\n⚠️ Timer running.\n"
        f"⚠️ Reply /stop to submit.",
        reply_markup=telebot.types.ReplyKeyboardRemove(),
        parse_mode="Markdown")
    threading.Thread(target=_test_timer, args=(uid, minutes), daemon=True).start()

def _test_timer(uid, minutes):
    start = time.time()
    warn = {"10": False, "5": False, "1": False}
    while True:
        elapsed = (time.time() - start) / 60
        if elapsed >= minutes - 10 and not warn["10"]:
            safe_send(uid, "⚠️ 10 minutes left"); warn["10"] = True
        if elapsed >= minutes - 5 and not warn["5"]:
            safe_send(uid, "⚠️ 5 minutes left"); warn["5"] = True
        if elapsed >= minutes - 1 and not warn["1"]:
            safe_send(uid, "🔴 1 minute left"); warn["1"] = True
        if elapsed >= minutes:
            safe_send(uid, "⏰ Time up. Auto-submitted."); return
        time.sleep(10)

