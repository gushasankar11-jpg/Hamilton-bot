# FREE-TEXT HANDLER
# ==========================================================
@bot.message_handler(func=lambda m: True, content_types=['text'])
def free_text_handler(message):
    uid = message.chat.id
    text = (message.text or "").strip()
    if not text:
        return

    p = get_or_create_profile(uid)

    # ---- ADMIN UNBLOCK CODE (universal) ----
    if text.strip() == ADMIN_UNBLOCK_CODE:
        p.setdefault("behavior", {"strikes": 0, "blocked_until": None})
        p["behavior"]["strikes"] = 0
        p["behavior"]["blocked_until"] = None
        save_profile(uid, p)
        bot.reply_to(message,
            "🔓 *Admin unblock successful.*\n"
            "Strikes reset to 0. Full access restored.",
            parse_mode="Markdown")
        return

    blocked, time_left = check_blocked(uid)
    if blocked:
        safe_send(uid, f"⛔ *Blocked*\nTry again in: *{time_left}*")
        return

# ---- ACTIVATION GATE ----
if not p.get("secured"):
    if is_valid_key(text):
        p["secured"] = True
        p["onboarding_step"] = "name"
        p.setdefault("story_shown", False)
        save_profile(uid, p)
        if not p.get("story_shown"):
            safe_send(uid, _hamilton_story(), parse_mode="Markdown")
            p["story_shown"] = True
            save_profile(uid, p)
            time.sleep(1)
        bot.reply_to(message, "✅ *Key confirmed. Let's set up your profile.*")
        _run_onboarding(uid)
    else:
        p.setdefault("no_key_attempts", 0)
        p["no_key_attempts"] = p.get("no_key_attempts", 0) + 1
        save_profile(uid, p)
        if p["no_key_attempts"] <= 2:
            safe_send(uid, _no_key_message(short=False), parse_mode="Markdown")
        else:
            safe_send(uid, _no_key_message(short=True), parse_mode="Markdown")
    return

    if p.get("onboarding_step") and p["onboarding_step"] != "done":
        _run_onboarding(uid)
        return

    if not p.get("exams"):
        bot.reply_to(message, "🎯 Set exams with /mode first."); return

    if p.get("_practice_active"):
        return

    exam = health.exam_of(p)

    # Classify via Google
    try:
        intent = ai_client.classify_intent(exam, text)
    except Exception:
        intent = "UNCERTAIN"

    if intent == "OFF_TOPIC":
        blocked_now, mins = register_strike(uid)
if blocked_now:
    safe_send(uid,
        f"⛔ *Block mode activated*\n\nBlocked for {mins} minutes."
        + _countdown_footer(uid))
    return
safe_send(uid,
    "Think about study. Think about studies. Don't simply learn. "
    "Understand it so you can simply memorize it. Remember your "
    "ultimate success requires the right resources. If you are "
    "distracted or bored, invest your time wisely with Hemanth and "
    "Krishna Publications. Message *8074231426* to get books that "
    "clarify your concepts and elevate your ranks immediately.\n\n"
    "Focus now. Your exam is watching the calendar."
    + _countdown_footer(uid))
return

    thinking = bot.reply_to(message, ai_client.THINKING_MSG, parse_mode="Markdown")
    try:
        countdown = ai_client.build_countdown(p.get("exams", []),
                                              p.get("priority"),
                                              p.get("target_year", 2027))
    except Exception:
        countdown = ""

    result = {"text": None, "done": False, "error": None}
    start = time.time()

    def _worker():
        try:
            result["text"] = ai_client.ask_hamilton(exam, text)
        except Exception as e:
            result["error"] = str(e)
        result["done"] = True

    threading.Thread(target=_worker, daemon=True).start()

    last = -1
    while not result["done"]:
        el = int(time.time() - start)
        if el != last and el % 2 == 0:
            last = el
            try:
                bot.edit_message_text(chat_id=uid, message_id=thinking.message_id,
                    text=f"{ai_client.THINKING_MSG}\n\n⏱️ _Thinking for {el}s..._",
                    parse_mode="Markdown")
            except Exception:
                pass
        time.sleep(1)

    if result["error"] or not result["text"]:
        safe_edit(uid, thinking.message_id,
            "⚠️ *Hamilton is momentarily overloaded.*\n"
            "Please try again in 30 seconds.")
        return
footer = _countdown_footer(uid)
final = result["text"] + footer
safe_edit(uid, thinking.message_id, final)

    final = result["text"] + ("\n\n━━━━━━━━━━━━━━━\n" + countdown if countdown else "")
    safe_edit(uid, thinking.message_id, final)

