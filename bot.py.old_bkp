@bot.message_handler(commands=['notes'])
def cmd_notes(message):
    uid = message.chat.id
    ready, reason = profile_ready(uid)
    if not ready:
        send_setup_prompt(uid, reason)
        return
    p = load_profile(uid)
    sel = p.get("selected_chapters", {})
    subjects = [s for s in ["Maths", "Physics", "Chemistry"] if sel.get(s)]
    if not subjects:
        subjects = health.available_subjects()
    if len(subjects) == 1:
        notes_ask_chapter(uid, subjects[0])
        return
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    for s in subjects:
        markup.add(s)
    msg = bot.send_message(uid, "📝 Which subject?", reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, notes_pick_subject)


def notes_pick_subject(message):
    uid = message.chat.id
    subj = (message.text or "").strip().capitalize()
    if subj not in health.available_subjects():
        bot.reply_to(message, "Invalid.")
        return
    notes_ask_chapter(uid, subj)


def notes_ask_chapter(uid, subj):
    p = load_profile(uid)
    exam = health.exam_of(p) or "JEE_MAIN"
    sel_ch = p.get("selected_chapters", {}).get(subj, [])
    if sel_ch:
        ch_list = sel_ch
    else:
        data = health.load_subject_data(subj, exam)
        if not data:
            bot.send_message(uid, "No data.")
            return
        ch_list = list(data.keys())
    numbered = "\n".join(str(i + 1) + ". " + c for i, c in enumerate(ch_list))
    header = "📝 " + subj + " — pick chapter:\n\n" + numbered + "\n\nReply number."
    if len(header) > 4000:
        safe_send(uid, "📝 " + subj + " chapters:")
        safe_send(uid, numbered[:3900])
        msg = bot.send_message(uid, "Reply number.")
    else:
        msg = bot.send_message(uid, header, parse_mode="Markdown")
    bot.register_next_step_handler(msg, notes_capture_chapter, subj, ch_list)


def notes_capture_chapter(message, subj, ch_list):
    uid = message.chat.id
    try:
        idx = int((message.text or "").strip()) - 1
        if idx < 0 or idx >= len(ch_list):
            raise ValueError
    except ValueError:
        bot.reply_to(message, "Invalid.")
        return
    chapter = ch_list[idx]
    generate_notes_prompt(uid, subj, chapter)


def generate_notes_prompt(uid, subject, chapter):
    p = load_profile(uid)
    exam = health.exam_of(p) or "JEE_MAIN"
    data = health.load_subject_data(subject, exam)
    if not data or chapter not in data:
        safe_send(uid, "No data.")
        return

    subs = data[chapter]
    concepts = []
    for sub, val in subs.items():
        cl = val.get("adv", []) if isinstance(val, dict) else val
        for c in cl:
            concepts.append(c)

    safe_send(uid, "📝 Building a complete notes prompt for *" + chapter + "*...",
              parse_mode="Markdown")

    timer_manager.start_generating_timer(bot, uid, "notes prompt")

    concepts_str = "\n".join("- " + c for c in concepts)

    ai_prompt = (
        "You are a master teacher. Write COMPLETE, DEEP, EXAM-READY short notes "
        "for the JEE Advanced / JEE Mains chapter '" + chapter + "' in " + subject + ".\n\n"
        "Cover EVERY one of these concepts (do not skip):\n"
        + concepts_str + "\n\n"
        "═══════════════════════════════════════\n"
        "STRICT FORMAT RULES\n"
        "═══════════════════════════════════════\n"
        "1. Use ONLY real Unicode math symbols. Never LaTeX.\n"
        "   Write θ τ π α β Δ Σ Ω ω φ λ μ ν as actual symbols\n"
        "   Write √ × · ÷ ± ∓ ≈ ≠ ≤ ≥ → ⇒ ∞ ∫ ∑ ∏ ∂ ∇ directly\n"
        "   Powers: x², x³, aᵢⱼ, H₂O, C₆H₁₂O₆\n"
        "   Fractions: write as (a/b)\n"
        "   Matrices: use ⎡a b⎤ ⎣c d⎦\n"
        "   Determinants: use |a b; c d|\n"
        "   NEVER write backslash commands, never write $ signs\n\n"
        "2. For EVERY concept include:\n"
        "   • Definition (3-4 lines, clear)\n"
        "   • EVERY formula with all variables defined\n"
        "   • 2-3 common traps students fall into\n"
        "   • Shortcut or trick when one exists\n"
        "   • Typical JEE question pattern\n\n"
        "3. Do NOT summarise. Do NOT compress. Cover every case, every exception.\n"
        "4. Write like a friendly senior — warm, encouraging, not textbook.\n"
        "5. Split the answer into pages. Output each page separated by:\n"
        "   ---PAGE---\n"
        "   on its own line.\n"
        "6. Each page should be a standalone chunk that fits one Telegram message.\n"
        "7. Aim for 10-15 pages total.\n"
    )

    raw = ai_client.ask_hamilton(exam, ai_prompt)
    timer_manager.stop_generating_timer(bot, uid)

    if not raw:
        safe_send(uid, "Could not generate. Try again in a moment.")
        return

    raw = ai_client.clean_latex(raw)

    parts = [p.strip() for p in re.split(r"---PAGE---", raw) if p.strip()]
    if not parts:
        parts = [raw.strip()]

    total = len(parts)
    for i, part in enumerate(parts, 1):
        header = "📝 *" + chapter + " — Page " + str(i) + "/" + str(total) + "*\n\n"
        footer = countdown_footer(uid) if i == total else ""
        svg, clean = svg_renderer.detect_svg_in_text(part)
        send_math(uid, header + clean + footer, parse_mode="Markdown")
        if svg and SVG_ENABLED:
            path = svg_renderer.render_svg(svg, name="notes_" + str(uid) + "_" + str(i))
            if path:
                safe_send_photo(uid, path)
                svg_renderer.cleanup_file(path)
        time.sleep(0.4)

    safe_send(uid,
        "✅ *" + chapter + " notes delivered!*\n"
        "Pages: *" + str(total) + "*\n"
        "Concepts: *" + str(len(concepts)) + "*",
        parse_mode="Markdown")


# ==========================================================
# FREE-TEXT HANDLER (with correct border ordering)
# ==========================================================
@bot.message_handler(func=lambda m: True, content_types=['text'])
def free_text_handler(message):
    uid = message.chat.id
    text = (message.text or "").strip()
    if not text:
        return

    p = get_or_create_profile(uid)

    # Admin unblock
    if text.strip() == ADMIN_UNBLOCK_CODE:
        p.setdefault("behavior", {"strikes": 0, "blocked_until": None})
        p["behavior"]["strikes"] = 0
        p["behavior"]["blocked_until"] = None
        save_profile(uid, p)
        bot.reply_to(message, "🔓 Admin unblock successful.")
        return

    # Blocked
    blocked, time_left = check_blocked(uid)
    if blocked:
        safe_send(uid,
            "⛔ *Blocked*\n\nTry again in: *" + str(time_left) + "*\n\n"
            "WhatsApp " + WHATSAPP_CONTACT + " for help." + countdown_footer(uid),
            parse_mode="Markdown")
        return

    # Activation
    if not p.get("secured"):
        if is_valid_key(text):
            allowed, reason = check_key_binding(uid, text.strip())
            if not allowed:
                safe_send(uid, "This key is already active on another device.")
                return
            p["secured"] = True
            p["activation_key"] = text.strip()
            p["key_expired"] = False
            p["onboarding_step"] = "name"
            if not p.get("hku_id"):
                p["hku_id"] = allocate_user_id(uid)
            save_profile(uid, p)
            if not p.get("story_shown"):
                safe_send(uid, hamilton_story(), parse_mode="Markdown")
                p["story_shown"] = True
                save_profile(uid, p)
                time.sleep(1)
            bot.reply_to(message, "✅ Key confirmed. Let us set up.")
            run_onboarding(uid)
        else:
            p.setdefault("no_key_attempts", 0)
            p["no_key_attempts"] += 1
            save_profile(uid, p)
            if p["no_key_attempts"] <= 2:
                safe_send(uid, no_key_message(short=False), parse_mode="Markdown")
            else:
                safe_send(uid, no_key_message(short=True), parse_mode="Markdown")
        return

    if check_key_expired(uid, p):
        return

    if not p.get("hku_id"):
        p["hku_id"] = allocate_user_id(uid)
        save_profile(uid, p)

    if p.get("onboarding_step") and p["onboarding_step"] != "done":
        run_onboarding(uid)
        return

    if not p.get("exams"):
        bot.reply_to(message, "Set exams with /mode first.")
        return

    sess = exam_engine.get_session(uid)

    # 1. PENDING NUMERICAL — highest priority
    if uid in PENDING_NUMERICAL:
        pending = PENDING_NUMERICAL.get(uid)
        if pending and pending.get("is_test"):
            handle_test_numerical(uid, text)
        else:
            handle_numerical(uid, text)
        return

    # 2. TEST hard border
    if sess and sess.get("mode") == "test":
        q_done = sess.get("questions_done", 0)
        plan = sess.get("plan", [])
        paper = sess.get("current_paper", 1)
        markup = telebot.types.InlineKeyboardMarkup()
        markup.add(telebot.types.InlineKeyboardButton("Stop Test", callback_data="test_stop"))
        safe_send(uid,
            "📝 *Test in progress* — Paper " + str(paper) + ", Q" + str(q_done) + "/" + str(len(plan)) + "\n\n"
            "I cannot answer during the test. Finish first.",
            parse_mode="Markdown", reply_markup=markup)
        return

    # 3. CONCEPTUAL hard border
    if sess and sess.get("mode") == "conceptual":
        q_done = sess.get("questions_done", 0)
        plan = sess.get("plan", [])
        markup = telebot.types.InlineKeyboardMarkup()
        markup.add(telebot.types.InlineKeyboardButton("Stop Test", callback_data="concept_stop"))
        safe_send(uid,
            "🧠 *Conceptual test in progress* — Q" + str(q_done) + "/" + str(len(plan)) + "\n\n"
            "I cannot answer during the test.",
            parse_mode="Markdown", reply_markup=markup)
        return

    # 4. PRACTICE soft border (allow doubts)
    if p.get("_practice_active") and sess and sess.get("mode") == "practice":
        exam = sess.get("exam") or health.exam_of(p) or "JEE_MAIN"
        timer_manager.start_thinking_timer(bot, uid, ai_client.THINKING_MSG)
        intent, answer = ai_client.classify_and_answer(exam, text)
        timer_manager.stop_thinking_timer(uid)
        if not answer:
            safe_send(uid, "Retry or Continue.")
            return
        svg, clean = svg_renderer.detect_svg_in_text(answer)
        final = "💬 *Your doubt answered:*\n\n" + clean + countdown_footer(uid)
        mid = timer_manager.get_thinking_msg_id(uid)
        if mid:
            safe_edit(uid, mid, final, parse_mode="Markdown", reply_markup=doubt_buttons())
        else:
            safe_send(uid, final, parse_mode="Markdown", reply_markup=doubt_buttons())
        if svg and SVG_ENABLED:
            path = svg_renderer.render_svg(svg, name="doubt_" + str(uid))
            if path:
                safe_send_photo(uid, path)
                svg_renderer.cleanup_file(path)
        return

    if p.get("_practice_active") and not sess:
        p["_practice_active"] = False
        save_profile(uid, p)

    # 5. Normal free-text
    exam = health.exam_of(p) or "JEE_MAIN"
    timer_manager.start_thinking_timer(bot, uid, ai_client.THINKING_MSG)
    intent, answer = ai_client.classify_and_answer(exam, text)
    timer_manager.stop_thinking_timer(uid)

    if not answer:
        mid = timer_manager.get_thinking_msg_id(uid)
        err = "Hamilton is momentarily overloaded. Please try again."
        if mid:
            safe_edit(uid, mid, err)
        else:
            safe_send(uid, err)
        return

    if intent == "OFF_TOPIC":
        blocked_now, mins = register_strike(uid)
        if blocked_now:
            safe_send(uid,
                "⛔ Block mode activated for " + str(mins) + " minutes."
                + countdown_footer(uid), parse_mode="Markdown")
            return

    svg, clean = svg_renderer.detect_svg_in_text(answer)
    final = clean + countdown_footer(uid)
    mid = timer_manager.get_thinking_msg_id(uid)
    if mid:
        safe_edit(uid, mid, final, parse_mode="Markdown")
    else:
        safe_send(uid, final, parse_mode="Markdown")

    if svg and SVG_ENABLED:
        path = svg_renderer.render_svg(svg, name="ai_" + str(uid))
        if path:
            safe_send_photo(uid, path)
            svg_renderer.cleanup_file(path)


# ==========================================================
# /find /leaderboard /help /clear_data /genkey /shutdown
# ==========================================================
@bot.message_handler(commands=['find'])
def cmd_find(message):
    uid = message.chat.id
    parts = message.text.strip().split()
    if len(parts) < 2:
        bot.reply_to(message, "Usage: /find HKU-000001")
        return
    hku = parts[1].strip().upper()
    found_uid = find_user_by_hku_id(hku)
    if not found_uid:
        bot.reply_to(message, "No user with that ID.")
        return
    try:
        target = load_profile(int(found_uid))
    except Exception:
        target = load_profile(found_uid)
    if not target:
        bot.reply_to(message, "Not found.")
        return
    r = health.overall_health(target)
    summary = health.attempts_summary(target)
    pct = health.predict_percentile(r.get("overall"))
    _, tier = health.estimate_rank(target)
    lines = ["🔍 Search Result", "",
             "👤 " + str(target.get("name", "—")),
             "🆔 " + hku,
             "🏫 " + str(target.get("institute", "—")),
             "🎓 " + str(target.get("level", "—")),
             "📚 " + ", ".join(EXAM_NAMES.get(e, e) for e in target.get("exams", [])), "",
             "Total attempted: " + str(summary["attempted"]),
             "✅ " + str(summary["correct"]) + "  ❌ " + str(summary["wrong"]),
             "🎯 Accuracy: " + str(summary["accuracy"]) + "%", "",
             "📊 Overall Health: " + str(r.get("overall") or 0) + "/100",
             "🎯 Predicted %ile: " + str(pct),
             "🏆 " + tier]
    safe_send(uid, "\n".join(lines), parse_mode="Markdown")


def compute_leaderboard(filt=None):
    entries = []
    if not os.path.exists(PROFILE_DIR):
        return entries
    for fname in os.listdir(PROFILE_DIR):
        if not fname.endswith(".json"):
            continue
        uid_str = fname.replace(".json", "")
        try:
            with open(os.path.join(PROFILE_DIR, fname)) as f:
                p = json.load(f)
        except Exception:
            continue
        if not p.get("secured") or not p.get("name"):
            continue
        if not p.get("exams"):
            continue
        lvl = (p.get("level") or "").lower()
        if filt == "junior" and lvl != "junior":
            continue
        if filt == "senior" and lvl not in ("senior", "dropper"):
            continue
        summary = health.attempts_summary(p)
        if summary["attempted"] < 20:
            continue
        r = health.overall_health(p)
        h = r.get("overall") or 0
        pct = health.predict_percentile(h)
        entries.append({"name": p.get("name"), "hku": p.get("hku_id", "—"),
                        "health": round(h, 1), "pct": pct,
                        "attempted": summary["attempted"]})
    entries.sort(key=lambda x: x["health"], reverse=True)
    return entries


@bot.message_handler(commands=['leaderboard'])
def cmd_leaderboard(message):
    uid = message.chat.id
    parts = message.text.split()
    filt = None
    if len(parts) > 1:
        a = parts[1].lower()
        if "jun" in a:
            filt = "junior"
        elif "sen" in a or "drop" in a:
            filt = "senior"
    entries = compute_leaderboard(filt)
    if not entries:
        bot.reply_to(message, "No qualifying users yet (need 20+ attempts).")
        return
    title = "🏆 Leaderboard"
    if filt:
        title += " — " + filt
    lines = [title, ""]
    for i, e in enumerate(entries[:20], 1):
        m = "🥇" if i == 1 else "🥈" if i == 2 else "🥉" if i == 3 else str(i) + "."
        lines.append(m + " " + e["name"] + " (" + e["hku"] + ") — " + str(e["health"]))
    safe_send(uid, "\n".join(lines))


@bot.message_handler(commands=['help'])
def cmd_help(message):
