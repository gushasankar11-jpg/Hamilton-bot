def difficulty_str(d):
    if not isinstance(d, str):
        return str(d)
    return {"easy": "Easy", "medium": "Medium", "hard": "Hard"}.get(d, d.capitalize())


# ==========================================================
# /start
# ==========================================================
@bot.message_handler(commands=['start'])
def cmd_start(message):
    uid = message.chat.id
    p = get_or_create_profile(uid)

    if not p.get("secured"):
        save_profile(uid, p)
        bot.reply_to(message,
            "🙏 *Namaskaram, Aspirant!*\n\n"
            "You stand in the final stretch of your *Intermediate journey* — "
            "balancing board studies with deep, focused preparation for your "
            "competitive exams.\n\n"
            "I am *Hamilton Study AI* *(by Hemanth and Krishna Publications)*, "
            "your personal exam mentor.\n\n"
            "🔒 *To begin, send your activation key.*",
            parse_mode="Markdown")
        return

    if p.get("onboarding_step") and p["onboarding_step"] != "done":
        run_onboarding(uid)
        return

    bot.reply_to(message, "Welcome back, " + p.get("name", "Aspirant") + "!\n\n"
                 "Type /mode to change setup, or /exam to start.",
                 parse_mode="Markdown")


def run_onboarding(uid):
    p = load_profile(uid)
    step = p.get("onboarding_step")
    if step == "name":
        msg = bot.send_message(uid, "📝 What is your name?")
        bot.register_next_step_handler(msg, onb_name)
    elif step == "institute":
        msg = bot.send_message(uid, "🏫 Which institute / school / college?")
        bot.register_next_step_handler(msg, onb_institute)
    elif step == "level":
        markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
        markup.add("Junior", "Senior", "Dropper")
        msg = bot.send_message(uid,
            "🎓 Junior, Senior, or Dropper?",
            reply_markup=markup, parse_mode="Markdown")
        bot.register_next_step_handler(msg, onb_level)
    else:
        bot.send_message(uid, "Type /mode to begin.")


def onb_name(message):
    uid = message.chat.id
    name = (message.text or "").strip()[:40]
    if not name or len(name) < 2:
        bot.reply_to(message, "Please type your name (at least 2 characters).")
        return
    p = load_profile(uid)
    p["name"] = name
    p["onboarding_step"] = "institute"
    save_profile(uid, p)
    run_onboarding(uid)


def onb_institute(message):
    uid = message.chat.id
    inst = (message.text or "").strip()[:60]
    if not inst or len(inst) < 2:
        bot.reply_to(message, "Please type your institute name.")
        return
    p = load_profile(uid)
    p["institute"] = inst
    p["onboarding_step"] = "level"
    save_profile(uid, p)
    run_onboarding(uid)


def onb_level(message):
    uid = message.chat.id
    txt = (message.text or "").strip().lower()
    if txt not in ("junior", "senior", "dropper"):
        bot.reply_to(message, "Please tap Junior / Senior / Dropper.")
        return
    p = load_profile(uid)
    p["level"] = txt.capitalize()
    p["onboarding_step"] = "done"
    if not p.get("hku_id"):
        p["hku_id"] = allocate_user_id(uid)
    save_profile(uid, p)
    bot.reply_to(message,
        "✅ Profile saved\n\n"
        "👤 " + p["name"] + "\n"
        "🏫 " + p["institute"] + "\n"
        "🎓 " + p["level"] + "\n"
        "🆔 " + p["hku_id"] + "\n\n"
        "Type /mode to set up your exams.",
        reply_markup=telebot.types.ReplyKeyboardRemove(),
        parse_mode="Markdown")


# ==========================================================
# /mode
# ==========================================================
@bot.message_handler(commands=['mode'])
def cmd_mode(message):
    uid = message.chat.id
    p = load_profile(uid)
    if not p or not p.get("secured"):
        bot.reply_to(message, "Activate first.")
        return
    if p.get("exams") and p.get("target_year"):
        current = ", ".join(EXAM_NAMES[e] for e in p["exams"])
        msg = bot.reply_to(message,
            "🎯 Current setup:\n"
            "Exams: " + current + "\n"
            "Priority: " + EXAM_NAMES.get(p.get("priority", "—"), "—") + "\n"
            "Year: " + str(p.get("target_year")) + "\n\n"
            "Change setup? Type YES or NO.",
            parse_mode="Markdown")
        bot.register_next_step_handler(msg, mode_confirm)
        return
    mode_start(uid)


def mode_confirm(message):
    uid = message.chat.id
    if (message.text or "").strip().lower() == "yes":
        mode_start(uid)
    else:
        bot.reply_to(message, "Setup unchanged.")


def mode_start(uid):
    msg = bot.send_message(uid,
        "🎯 Choose target exam(s):\n\n"
        "A → JEE Advanced\nB → JEE Mains\nC → EAMCET\n\n"
        "Reply combo: A, B, C, AB, BC, AC, ABC",
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, mode_exams)


def mode_exams(message):
    uid = message.chat.id
    p = load_profile(uid)
    txt = (message.text or "").strip().upper()
    sel = [EXAM_OPTIONS[c] for c in txt if c in EXAM_OPTIONS]
    if not sel:
        bot.reply_to(message, "Invalid. Send A, B, C, AB, BC, AC or ABC.")
        return
    p["exams"] = sel
    p["priority"] = None
    p["priority_pct"] = 100
    p["target_year"] = None
    p["target_marks"] = {}
    save_profile(uid, p)
    if len(sel) == 1:
        p["priority"] = sel[0]
        p["priority_pct"] = 100
        save_profile(uid, p)
        ask_year(uid)
        return
    names = " / ".join(EXAM_NAMES[e] for e in sel)
    msg = bot.reply_to(message, "Active: " + names + "\n\nWhich is PRIMARY? Reply exact name.",
                       parse_mode="Markdown")
    bot.register_next_step_handler(msg, mode_priority)


def mode_priority(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip()
    chosen = None
    for e in p["exams"]:
        if EXAM_NAMES[e].lower() == t.lower():
            chosen = e
            break
    if not chosen:
        bot.reply_to(message, "Not recognised.")
        return
    p["priority"] = chosen
    save_profile(uid, p)
    msg = bot.reply_to(message,
        "Primary: " + EXAM_NAMES[chosen] + "\n\nPriority focus %? Reply 50-100",
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, mode_pct)


def mode_pct(message):
    uid = message.chat.id
    p = load_profile(uid)
    try:
        pct = int((message.text or "").strip())
        if pct < 50 or pct > 100:
            raise ValueError
    except ValueError:
        bot.reply_to(message, "Send 50-100.")
        return
    p["priority_pct"] = pct
    save_profile(uid, p)
    ask_year(uid)


def ask_year(uid):
    current = datetime.now().year
    max_yr = current + MAX_FUTURE_YEARS
    msg = bot.send_message(uid,
        "📅 Which YEAR are you targeting?\n\nType year like " + str(current + 1) + ". Range: " + str(current) + "-" + str(max_yr),
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, mode_year)


def mode_year(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip()
    current = datetime.now().year
    max_yr = current + MAX_FUTURE_YEARS
    if not t.isdigit():
        bot.reply_to(message, "Type a year like " + str(current + 1))
        return
    yr = int(t)
    if yr < current or yr > max_yr:
        bot.reply_to(message, "Try between " + str(current) + " and " + str(max_yr))
        return
    p["target_year"] = yr
    save_profile(uid, p)
    mode_start_marks(uid)


def mode_start_marks(uid):
    p = load_profile(uid)
    p["_marks_queue"] = list(p["exams"])
    p["target_marks"] = {}
    save_profile(uid, p)
    mode_ask_next_mark(uid)


def mode_ask_next_mark(uid):
    p = load_profile(uid)
    queue = p.get("_marks_queue", [])
    if not queue:
        mode_finish(uid)
        return
    exam = queue.pop(0)
    p["_marks_queue"] = queue
    save_profile(uid, p)
    max_m = MAX_MARKS.get(exam, 100)
    msg = bot.send_message(uid,
        "Expected marks for " + EXAM_NAMES[exam] + "? (0-" + str(max_m) + ")")
    bot.register_next_step_handler(msg, mode_capture_marks, exam, max_m)


def mode_capture_marks(message, exam, max_m):
    uid = message.chat.id
    p = load_profile(uid)
    try:
        val = int((message.text or "").strip())
        if val < 0 or val > max_m:
            raise ValueError
    except ValueError:
        bot.reply_to(message, "Send 0-" + str(max_m))
        p["_marks_queue"].insert(0, exam)
        save_profile(uid, p)
        mode_ask_next_mark(uid)
        return
    p.setdefault("target_marks", {})
    p["target_marks"][exam] = val
    save_profile(uid, p)
    mode_ask_next_mark(uid)


def mode_finish(uid):
    p = load_profile(uid)
    names = ", ".join(EXAM_NAMES[e] for e in p["exams"])
    lines = ["✅ SETUP COMPLETE", "",
             "👤 " + p["name"],
             "🏫 " + p["institute"],
             "🎓 " + p["level"],
             "🆔 " + p.get("hku_id", "—"), "",
             "📚 Exams: " + names]
    if p.get("priority") and len(p["exams"]) > 1:
        lines.append("🎯 Priority: " + EXAM_NAMES[p["priority"]] + " (" + str(p["priority_pct"]) + "%)")
    lines.append("📅 Year: " + str(p["target_year"]))
    targets = p.get("target_marks", {})
    if targets:
        lines.append("")
        lines.append("Expected marks:")
        for e in p["exams"]:
            if e in targets:
                lines.append("   " + EXAM_NAMES[e] + ": " + str(targets[e]) + " / " + str(MAX_MARKS.get(e, 100)))
    lines += ["", "Next: /select /exam /health"]
    bot.send_message(uid, "\n".join(lines),
                     reply_markup=telebot.types.ReplyKeyboardRemove(),
                     parse_mode="Markdown")


# ==========================================================
# /status
# ==========================================================
@bot.message_handler(commands=['status'])
def cmd_status(message):
    uid = message.chat.id
    p = load_profile(uid)
    if not p or not p.get("secured"):
        bot.reply_to(message, "Not activated.")
        return
    lines = ["📊 Your Status", "",
             "👤 " + str(p.get("name", "—")),
             "🏫 " + str(p.get("institute", "—")),
             "🎓 " + str(p.get("level", "—")),
             "🆔 " + str(p.get("hku_id", "—")), ""]
    if p.get("exams"):
        lines.append("📚 Exams: " + ", ".join(EXAM_NAMES.get(e, e) for e in p["exams"]))
    if p.get("target_year"):
        lines.append("📅 Year: " + str(p["target_year"]))
    if p.get("target_marks"):
        lines.append("🎯 Targets:")
        for e, m in p["target_marks"].items():
            lines.append("   " + EXAM_NAMES.get(e, e) + ": " + str(m))
    if p.get("selected_chapters"):
        lines.append("")
        lines.append("📖 Selected chapters:")
        for s, chs in p["selected_chapters"].items():
            lines.append("   " + s + ": " + str(len(chs)) + " chapters")
    safe_send(uid, "\n".join(lines), parse_mode="Markdown")


print("bot.py Block 1 loaded: setup, onboarding, mode, status ready.")
