def practice_ask_chapter_mode(uid):
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    markup.add("My selected chapters", "Pick from full syllabus")
    msg = bot.send_message(uid,
        "📖 Chapters to practice from?",
        reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, practice_capture_chapter_mode)


def practice_capture_chapter_mode(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip().lower()
    if "full" in t:
        p["_practice_chapter_mode"] = "custom"
        p["_practice_custom_chapters"] = {}
        save_profile(uid, p)
        practice_pick_subject(uid)
    elif "select" in t:
        p["_practice_chapter_mode"] = "selected"
        p["_practice_custom_chapters"] = None
        save_profile(uid, p)
        practice_ask_difficulty(uid)
    else:
        bot.reply_to(message, "Tap one option.")


def practice_pick_subject(uid):
    subjects = health.available_subjects()
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    for s in subjects:
        markup.add(s)
    msg = bot.send_message(uid, "Which subject?", reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, practice_capture_subject)


def practice_capture_subject(message):
    uid = message.chat.id
    p = load_profile(uid)
    subj = (message.text or "").strip().capitalize()
    exam = p.get("_exam_chosen") or p.get("priority") or health.exam_of(p)
    if subj not in health.available_subjects():
        bot.reply_to(message, "Invalid.")
        return
    data = health.load_subject_data(subj, exam)
    if not data:
        bot.reply_to(message, "No data.")
        return
    chapter_list = list(data.keys())
    numbered = "\n".join(str(i + 1) + ". " + c for i, c in enumerate(chapter_list))
    header = "📚 " + subj + " — " + str(len(chapter_list)) + " chapters\n\n"
    footer = "\n\nReply numbers or ALL"
    full = header + numbered + footer
    if len(full) > 4000:
        safe_send(uid, header + "(list below)")
        safe_send(uid, numbered[:3900])
        msg = bot.send_message(uid, footer.strip())
        bot.register_next_step_handler(msg, practice_capture_chapters, subj, chapter_list)
    else:
        msg = bot.send_message(uid, full,
                               reply_markup=telebot.types.ReplyKeyboardRemove(),
                               parse_mode="Markdown")
        bot.register_next_step_handler(msg, practice_capture_chapters, subj, chapter_list)


def practice_capture_chapters(message, subj, chapter_list):
    uid = message.chat.id
    p = load_profile(uid)
    txt = (message.text or "").strip()
    if txt.upper() == "ALL":
        chosen = chapter_list
    else:
        try:
            idxs = [int(x.strip()) - 1 for x in txt.split(",") if x.strip()]
            chosen = [chapter_list[i] for i in idxs if 0 <= i < len(chapter_list)]
        except Exception:
            bot.reply_to(message, "Invalid.")
            return
    if not chosen:
        bot.reply_to(message, "No valid chapters.")
        return
    p["_practice_custom_chapters"] = {subj: chosen}
    save_profile(uid, p)
    safe_send(uid, "✅ " + subj + ": " + str(len(chosen)) + " chapters.")
    practice_ask_difficulty(uid)


# ==========================================================
# PRACTICE — difficulty
# ==========================================================
def practice_ask_difficulty(uid):
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    markup.add("Level 1", "Level 2", "Level 3")
    msg = bot.send_message(uid,
        "🎯 Difficulty:\n\n"
        "Level 1 — Basic\nLevel 2 — Standard\nLevel 3 — IIT depth",
        reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, practice_capture_difficulty)


def practice_capture_difficulty(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip().lower()
    if "1" in t:
        p["_practice_level"] = "easy"
    elif "2" in t:
        p["_practice_level"] = "medium"
    elif "3" in t:
        p["_practice_level"] = "hard"
    else:
        bot.reply_to(message, "Tap Level 1 / 2 / 3.")
        return
    save_profile(uid, p)
    start_practice(uid)


# ==========================================================
# PRACTICE — start
# ==========================================================
def pick_subject_for_practice(profile):
    custom = profile.get("_practice_custom_chapters")
    if custom:
        for s, chs in custom.items():
            if chs and s in health.available_subjects():
                return s
    selected = profile.get("selected_chapters", {})
    for s, chs in selected.items():
        if chs and s in health.available_subjects():
            return s
    subjects = health.available_subjects()
    return subjects[0] if subjects else None


def start_practice(uid):
    p = load_profile(uid)
    exam = p.get("_exam_chosen") or p.get("priority") or health.exam_of(p)
    p["_practice_active"] = True
    p["_practice_exam"] = exam
    save_profile(uid, p)
    exam_engine.new_practice_session(uid, exam=exam)
    PRELOAD_QUEUE[uid] = []
    bot.send_message(uid,
        "🚀 Practice started (" + EXAM_NAMES.get(exam, exam) + ")\n\n"
        "Type /next /bookmark /stop anytime. Ask doubts freely — "
        "I'll answer, then you can Continue.",
        reply_markup=telebot.types.ReplyKeyboardRemove(),
        parse_mode="Markdown")
    send_next_practice(uid)


def send_next_practice(uid):
    p = load_profile(uid)
    exam = p.get("_practice_exam") or health.exam_of(p)
    level = p.get("_practice_level", "medium")
    if not exam:
        safe_send(uid, "Exam not set.")
        return
    queue = PRELOAD_QUEUE.get(uid, [])
    q = queue.pop(0) if queue else None

    if not q:
        timer_manager.start_generating_timer(bot, uid, "question")
        subj = pick_subject_for_practice(p)
        if not subj:
            timer_manager.stop_generating_timer(bot, uid)
            safe_send(uid, "No chapters. /select first.")
            return
        custom = p.get("_practice_custom_chapters")
        allowed = custom.get(subj) if custom else None
        pick = exam_engine.pick_next_subtopic(p, subj, exam, allowed_chapters=allowed)
        timer_manager.stop_generating_timer(bot, uid)
        if not pick:
            safe_send(uid, "No subtopics found.")
            return
        _, ch, sub = pick
        q_type = "mcq"
        if exam in ("JEE_MAIN", "JEE_ADV") and random.random() < 0.25:
            q_type = "numerical"
        q = exam_engine.generate_question(exam, subj, ch, sub,
                                           q_type=q_type, difficulty=level)
        if not q:
            safe_send(uid, "Could not generate question. Try /exam again.")
            return
        q["_meta"] = {"subject": subj, "chapter": ch, "subtopic": sub}

    meta = q["_meta"]
    sess = exam_engine.get_session(uid)
    if not sess:
        return
    sess["current_q"] = q
    sess["current_started"] = time.time()
    sess["current_meta"] = meta

    st = q.get("source_type", "AI-Generated")
    sd = q.get("source_detail", "")
    diff = q.get("difficulty", level)
    ideal = q.get("ideal_time_sec", 60)
    q_num = sess.get("questions_done", 0) + 1

    avg_time = None
    key = meta["subject"] + "::" + meta["chapter"] + "::" + meta["subtopic"]
    stat = p.get("subtopic_stats", {}).get(key)
    if stat and stat.get("attempts", 0) > 0:
        avg_time = stat.get("avg_time", 0)

    header_lines = [
        "[" + EXAM_NAMES.get(exam, exam) + " | " + meta["subject"] + " | Practice | Q" + str(q_num) + "]",
        "📌 Source: " + st + (" · " + sd if sd else ""),
        "⚡ Difficulty: " + difficulty_str(diff) + " | ⏱️ Ideal: " + str(ideal) + "s",
    ]
    if avg_time:
        header_lines.append("📈 Your avg: " + str(int(avg_time)) + "s")
    header_lines.append("📖 " + meta["chapter"] + " → " + meta["subtopic"])
    header = "\n".join(header_lines)
    full_q = header + "\n\n" + q["question"]

    svg_code = q.get("svg")
    if svg_code and SVG_ENABLED:
        path = svg_renderer.render_svg(svg_code, name="q_" + str(uid))
        if path:
            safe_send_photo(uid, path)
            svg_renderer.cleanup_file(path)

    # Numerical → save pending and ask for typed answer
    if q.get("correct_value") is not None:
        PENDING_NUMERICAL[uid] = {
            "q": q, "meta": meta, "started": time.time(), "is_test": False
        }
        safe_send(uid,
            "📝 *Numerical Question*\n\n" + full_q +
            "\n\n👉 *Just type the number* (e.g. `42` or `3.14`) and send.\n"
            "Type /skip to skip this question.",
            parse_mode="Markdown")
        timer_manager.start_question_timer(bot, uid)
        return

    options = q.get("options", [])[:4]
    if len(options) < 2:
        safe_send(uid, "Bad format. Regenerating...")
        time.sleep(1)
        send_next_practice(uid)
        return
    options_skip = options + ["🚪 Skip"]
    try:
        if len(full_q) <= 290:
            bot.send_poll(chat_id=uid, question=full_q[:300],
                          options=options_skip[:10], type="quiz",
                          correct_option_id=int(q.get("correct_index", 0)),
                          explanation="See solution below.",
                          is_anonymous=False)
        else:
            safe_send(uid, "📝 *Question*\n\n" + full_q, parse_mode="Markdown")
            time.sleep(0.4)
            bot.send_poll(chat_id=uid, question="👆 Tap your answer:",
                          options=options_skip[:10], type="quiz",
                          correct_option_id=int(q.get("correct_index", 0)),
                          explanation="See below.",
                          is_anonymous=False)
        timer_manager.start_question_timer(bot, uid)
    except Exception as e:
        safe_send(uid, "Retry... " + str(e))
        time.sleep(1)
        send_next_practice(uid)


print("bot.py Block 2 loaded: select/health/exam/practice ready.")
