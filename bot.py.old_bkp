# ==========================================================
# PROFILE I/O
# ==========================================================
def load_profile(uid):
    path = os.path.join(PROFILE_DIR, str(uid) + ".json")
    if not os.path.exists(path):
        return None
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


def save_profile(uid, profile):
    path = os.path.join(PROFILE_DIR, str(uid) + ".json")
    with open(path, "w") as f:
        json.dump(profile, f, indent=2, ensure_ascii=False)


def new_profile():
    return {
        "secured": False,
        "name": None,
        "institute": None,
        "level": None,
        "exams": [],
        "priority": None,
        "priority_pct": 100,
        "target_year": None,
        "target_marks": {},
        "selected_chapters": {},
        "onboarding_step": "name",
        "behavior": {"strikes": 0, "blocked_until": None},
        "story_shown": False,
        "no_key_attempts": 0,
        "hku_id": None,
        "activation_key": None,
        "key_expired": False,
        "_practice_active": False,
        "_practice_exam": None,
        "_practice_level": "medium",
        "created_at": datetime.now().isoformat(),
    }


def get_or_create_profile(uid):
    p = load_profile(uid)
    if p:
        return p
    return new_profile()


# ==========================================================
# HKU ID
# ==========================================================
def _load_user_ids():
    if not os.path.exists(USER_ID_FILE):
        return {"counter": 0, "mapping": {}}
    try:
        with open(USER_ID_FILE) as f:
            return json.load(f)
    except Exception:
        return {"counter": 0, "mapping": {}}


def _save_user_ids(data):
    with open(USER_ID_FILE, "w") as f:
        json.dump(data, f, indent=2)


def allocate_user_id(uid):
    data = _load_user_ids()
    uid_str = str(uid)
    if uid_str in data["mapping"]:
        return data["mapping"][uid_str]
    data["counter"] += 1
    new_id = "HKU-" + str(data["counter"]).zfill(6)
    data["mapping"][uid_str] = new_id
    _save_user_ids(data)
    return new_id


def find_user_by_hku_id(hku_id):
    data = _load_user_ids()
    for uid_str, stored in data["mapping"].items():
        if stored == hku_id:
            return uid_str
    return None


# ==========================================================
# KEYS
# ==========================================================
def load_keys():
    if not os.path.exists(KEYS_FILE):
        return {}
    try:
        with open(KEYS_FILE) as f:
            return json.load(f)
    except Exception:
        return {}


def is_valid_key(key):
    return key.strip() in load_keys()


def check_key_binding(uid, key):
    keys = load_keys()
    if key not in keys:
        return False, "invalid"
    info = keys[key]
    if not isinstance(info, dict):
        keys[key] = {"year": None, "bound_to": str(uid), "bound_at": datetime.now().isoformat()}
        with open(KEYS_FILE, "w") as f:
            json.dump(keys, f, indent=2)
        return True, "bound"
    if info.get("bound_to") is None:
        info["bound_to"] = str(uid)
        info["bound_at"] = datetime.now().isoformat()
        keys[key] = info
        with open(KEYS_FILE, "w") as f:
            json.dump(keys, f, indent=2)
        return True, "bound"
    if str(info["bound_to"]) == str(uid):
        return True, "same"
    return False, "other"


# ==========================================================
# STRIKE / BLOCK
# ==========================================================
def check_blocked(uid):
    p = load_profile(uid)
    if not p:
        return False, 0
    bu = p.get("behavior", {}).get("blocked_until")
    if not bu:
        return False, 0
    try:
        dt = datetime.fromisoformat(bu)
    except Exception:
        return False, 0
    if datetime.now() < dt:
        secs = int((dt - datetime.now()).total_seconds())
        return True, str(secs // 60) + " min " + str(secs % 60) + " sec"
    p["behavior"]["blocked_until"] = None
    p["behavior"]["strikes"] = 0
    save_profile(uid, p)
    return False, 0


def register_strike(uid):
    p = load_profile(uid)
    if not p:
        return False, None
    p.setdefault("behavior", {"strikes": 0, "blocked_until": None})
    p["behavior"]["strikes"] = p["behavior"].get("strikes", 0) + 1
    if p["behavior"]["strikes"] >= STRIKE_LIMIT:
        until = datetime.now() + timedelta(minutes=BLOCK_MINUTES)
        p["behavior"]["blocked_until"] = until.isoformat()
        save_profile(uid, p)
        return True, BLOCK_MINUTES
    save_profile(uid, p)
    return False, None


# ==========================================================
# SAFE SEND
# ==========================================================
def safe_send(chat_id, text, parse_mode=None, reply_markup=None):
    if not text:
        return
    while len(text) > TELEGRAM_MSG_LIMIT:
        cut = text.rfind("\n", 0, TELEGRAM_MSG_LIMIT)
        if cut == -1:
            cut = TELEGRAM_MSG_LIMIT
        try:
            bot.send_message(chat_id, text[:cut], parse_mode=parse_mode)
        except Exception:
            bot.send_message(chat_id, text[:cut])
        text = text[cut:].lstrip()
        time.sleep(0.3)
    if text:
        try:
            bot.send_message(chat_id, text, parse_mode=parse_mode, reply_markup=reply_markup)
        except Exception:
            bot.send_message(chat_id, text, reply_markup=reply_markup)


def safe_edit(chat_id, message_id, text, parse_mode=None, reply_markup=None):
    try:
        bot.edit_message_text(chat_id=chat_id, message_id=message_id,
                              text=text, parse_mode=parse_mode,
                              reply_markup=reply_markup)
    except Exception:
        safe_send(chat_id, text, parse_mode=parse_mode, reply_markup=reply_markup)


def safe_send_photo(chat_id, photo_path, caption=None):
    try:
        with open(photo_path, "rb") as f:
            bot.send_photo(chat_id, f, caption=caption)
        return True
    except Exception:
        return False


# ==========================================================
# GATING
# ==========================================================
def profile_ready(uid):
    p = load_profile(uid)
    if not p:
        return False, "no_profile"
    if not p.get("secured"):
        return False, "not_secured"
    if not p.get("name") or not p.get("institute") or not p.get("level"):
        return False, "not_onboarded"
    if not p.get("exams"):
        return False, "no_exams"
    if not p.get("target_year"):
        return False, "no_year"
    return True, None


def send_setup_prompt(uid, reason):
    msgs = {
        "not_secured": "Please activate first. Send your key.",
        "not_onboarded": "Finish your profile setup first. Send /start.",
        "no_exams": "Complete your setup first. Type /mode.",
        "no_year": "Type /mode to set your target year.",
        "no_profile": "Welcome! Send /start to begin.",
    }
    safe_send(uid, msgs.get(reason, "Complete setup with /mode first."))


def check_key_expired(uid, profile):
    if not profile.get("secured"):
        return False
    used_key = profile.get("activation_key")
    if not used_key:
        return False
    if used_key not in load_keys():
        profile["secured"] = False
        profile["key_expired"] = True
        save_profile(uid, profile)
        safe_send(uid, "Your activation key has expired. WhatsApp " + WHATSAPP_CONTACT)
        return True
    return False


# ==========================================================
# COUNTDOWN
# ==========================================================
def days_until_exam(exam, year):
    if exam not in EXAM_MD:
        return None
    m, d = EXAM_MD[exam]
    try:
        exam_date = datetime(year, m, d).date()
    except Exception:
        return None
    return max(0, (exam_date - datetime.now().date()).days)


def countdown_footer(uid):
    p = load_profile(uid)
    if not p:
        return ""
    exams = p.get("exams", [])
    priority = p.get("priority")
    year = p.get("target_year")
    if not exams or not year:
        return ""
    ordered = []
    if priority and priority in exams:
        ordered.append(priority)
    for e in exams:
        if e not in ordered:
            ordered.append(e)
    lines = []
    for e in ordered:
        days = days_until_exam(e, year)
        if days is None:
            continue
        name = EXAM_NAMES.get(e, e)
        if e == priority:
            lines.append("⏳ *" + name + " " + str(year) + ": " + str(days) + " days left* (primary)")
        else:
            lines.append("⏳ " + name + " " + str(year) + ": " + str(days) + " days left")
    if not lines:
        return ""
    return "\n\n━━━━━━━━━━━━━━━\n" + "\n".join(lines)


