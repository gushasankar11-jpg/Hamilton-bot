# ==========================================================
# RICH MATH HELPER — sends math with real fractions/matrices
# ==========================================================
def send_math(uid, text, parse_mode="Markdown", reply_markup=None):
    """
    Try Telegram Rich Message (renders LaTeX natively).
    Fallback to plain send if rich not supported.
    """
    try:
        rich = telebot.types.InputRichMessage(html=text)
        bot.send_rich_message(chat_id=uid, rich_message=rich,
                              reply_markup=reply_markup)
        return True
    except Exception:
        pass
    try:
        bot.send_message(uid, text, parse_mode=parse_mode,
                         reply_markup=reply_markup)
        return True
    except Exception:
        safe_send(uid, text, parse_mode=parse_mode,
                  reply_markup=reply_markup)
        return False


# ==========================================================
# /select — chapter picker
# ==========================================================
@bot.message_handler(commands=['select'])
def cmd_select(message):
    uid = message.chat.id
    ready, reason = profile_ready(uid)
    if not ready:
        send_setup_prompt(uid, reason)
        return
    subjects = health.available_subjects()
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    for s in subjects:
        markup.add(s)
    msg = bot.send_message(uid, "🎯 Which subject to pick chapters for?",
                           reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, select_subject)


def select_subject(message):
    uid = message.chat.id
    p = load_profile(uid)
    subj = (message.text or "").strip().capitalize()
    if subj not in health.available_subjects():
        bot.reply_to(message, "Not available. Try: " + ", ".join(health.available_subjects()))
        return
    exam = health.exam_of(p)
    data = health.load_subject_data(subj, exam)
    if not data:
        bot.reply_to(message, "No data for " + subj)
        return
    chapter_list = list(data.keys())
    numbered = "\n".join(str(i + 1) + ". " + c for i, c in enumerate(chapter_list))
    header = "📚 " + subj + " — " + str(len(chapter_list)) + " chapters\n\n"
    footer = "\n\nReply numbers like 1,4,7 or ALL"
    full = header + numbered + footer
    if len(full) > 4000:
        safe_send(uid, header + "(list below)", parse_mode="Markdown")
        safe_send(uid, numbered[:3900])
        msg = bot.send_message(uid, footer.strip())
        bot.register_next_step_handler(msg, select_chapters, subj, chapter_list)
    else:
        msg = bot.send_message(uid, full,
                               reply_markup=telebot.types.ReplyKeyboardRemove(),
                               parse_mode="Markdown")
        bot.register_next_step_handler(msg, select_chapters, subj, chapter_list)


def select_chapters(message, subj, chapter_list):
    uid = message.chat.id
    p = load_profile(uid)
    txt = (message.text or "").strip()
    if txt.upper() == "ALL":
        chosen = chapter_list
    else:
        try:
            idxs = [int(x.strip()) - 1 for x in txt.split(",") if x.strip()]
            chosen = [chapter_list[i] for i in idxs if 0 <= i < len(chapter_list)]
        except Exception:
            bot.reply_to(message, "Invalid. Try /select again.")
            return
    if not chosen:
        bot.reply_to(message, "No valid chapters.")
        return
    p.setdefault("selected_chapters", {})
    p["selected_chapters"][subj] = chosen
    save_profile(uid, p)
    safe_send(uid, "✅ " + subj + ": " + str(len(chosen)) + " chapters selected.",
              parse_mode="Markdown")


# ==========================================================
# /health
# ==========================================================
@bot.message_handler(commands=['health'])
def cmd_health(message):
    uid = message.chat.id
    ready, reason = profile_ready(uid)
    if not ready:
        send_setup_prompt(uid, reason)
        return
    p = load_profile(uid)
    parts = message.text.strip().split(maxsplit=1)
    if len(parts) > 1:
        subj = parts[1].strip().capitalize()
        if subj not in health.available_subjects():
            bot.reply_to(message, "Not available.")
            return
        exam = health.exam_of(p)
        ch_map = health.chapter_health_map(p, subj, exam, only_selected=False)
        lines = ["📗 " + subj + " — Chapter Health", ""]
        items = sorted(ch_map.items(),
                       key=lambda x: (x[1]["health"] is None,
                                      x[1]["health"] if x[1]["health"] is not None else 0))
        for ch, d in items:
            h = d["health"]
            hstr = str(h) if h is not None else "—"
            lines.append("• " + ch[:38] + ": " + hstr)
        safe_send(uid, "\n".join(lines), parse_mode="Markdown")
        return
    r = health.overall_health(p)
    days_left = None
    if p.get("priority") and p.get("target_year"):
        days_left = days_until_exam(p["priority"], p["target_year"])
    txt = health_text(r, days_left)
    safe_send(uid, txt, parse_mode="Markdown")
    if SVG_ENABLED and r.get("overall") is not None:
        subj_data = {s: d["health"] for s, d in r["subjects"].items()}
        svg = svg_templates.combined_progress(r["overall"], subj_data)
        path = svg_renderer.render_svg(svg, name="health_" + str(uid))
        if path:
            safe_send_photo(uid, path)
            svg_renderer.cleanup_file(path)


def health_text(r, days_left=None):
    if r.get("overall") is None:
        return "📭 No practice data yet. /exam to start."
    lines = ["❤️ Overall: " + str(r["overall"]) + " / 100"]
    if days_left is not None:
        lines.append("⏳ " + str(days_left) + " days left")
    lines.append("")
    for subj, d in r["subjects"].items():
        h = d["health"]
        hstr = str(h) + "/100" if h is not None else "Not started"
        lines.append("📘 " + subj + ": " + hstr)
    return "\n".join(lines)


