        "*Progress:*\n"
        "/health · /graph · /plan · /target\n\n"
        "*Social:*\n"
        "/leaderboard [junior|senior] · /find HKU-XXXXXX\n\n"
        "*Account:*\n"
        "/clear_data · /help"
    )
    safe_send(message.chat.id, text, parse_mode="Markdown")


@bot.message_handler(commands=['clear_data'])
def cmd_clear_data(message):
    uid = message.chat.id
    markup = telebot.types.InlineKeyboardMarkup()
    markup.add(
        telebot.types.InlineKeyboardButton("Yes, delete all", callback_data="clr_yes"),
        telebot.types.InlineKeyboardButton("Cancel", callback_data="clr_no"))
    bot.reply_to(message, "⚠️ Delete ALL your data? This cannot be undone.",
                 reply_markup=markup)


@bot.callback_query_handler(func=lambda c: c.data == "clr_yes")
def cb_clr_yes(call):
    uid = call.message.chat.id
    p = load_profile(uid) or {}
    fresh = new_profile()
    fresh["secured"] = True
    fresh["activation_key"] = p.get("activation_key")
    fresh["hku_id"] = p.get("hku_id")
    fresh["story_shown"] = True
    fresh["onboarding_step"] = "name"
    save_profile(uid, fresh)
    try:
        bot.edit_message_text(chat_id=uid, message_id=call.message.message_id,
                              text="✅ Data cleared. Type /start to set up again.")
    except Exception:
        safe_send(uid, "✅ Data cleared. /start to set up again.")


@bot.callback_query_handler(func=lambda c: c.data == "clr_no")
def cb_clr_no(call):
    try:
        bot.edit_message_text(chat_id=call.message.chat.id,
                              message_id=call.message.message_id,
                              text="Cancelled.")
    except Exception:
        pass


@bot.message_handler(commands=['genkey'])
def cmd_genkey(message):
    if message.chat.id != ADMIN_CHAT_ID:
        return
    parts = message.text.strip().split()
    if len(parts) < 3:
        bot.reply_to(message, "Usage: /genkey YY COUNT")
        return
    try:
        yy = parts[1].zfill(2)
        count = int(parts[2])
    except Exception:
        bot.reply_to(message, "Invalid.")
        return
    import string
    keys = load_keys()
    new = []
    for _ in range(count):
        b1 = "".join(random.choices(string.ascii_uppercase + string.digits, k=4))
        b2 = "".join(random.choices(string.ascii_uppercase + string.digits, k=4))
        k = "HK-" + yy + "-" + b1 + "-" + b2
        keys[k] = {"year": 2000 + int(yy), "bound_to": None}
        new.append(k)
    with open(KEYS_FILE, "w") as f:
        json.dump(keys, f, indent=2)
    safe_send(message.chat.id, "Generated:\n\n" + "\n".join(new))


@bot.message_handler(commands=['shutdown'])
def cmd_shutdown(message):
    if message.chat.id != ADMIN_CHAT_ID:
        return
    text = message.text.replace("/shutdown", "").strip()
    if not text:
        text = ("⚠️ Server maintenance in progress. Hamilton will be back soon.\n"
                "Until then — revise a concept, practice PYQs.")
    count = 0
    if os.path.exists(PROFILE_DIR):
        for fname in os.listdir(PROFILE_DIR):
            if not fname.endswith(".json"):
                continue
            try:
                cid = int(fname.replace(".json", ""))
            except Exception:
                continue
            try:
                safe_send(cid, text, parse_mode="Markdown")
                count += 1
            except Exception:
                pass
    bot.reply_to(message, "Sent to " + str(count) + " users. Shutting down...")
    time.sleep(3)
    os._exit(0)


# ==========================================================
# MASTER POLL HANDLER (routes to practice/test/concept)
# ==========================================================
@bot.poll_answer_handler()
def master_poll(ans):
    uid = ans.user.id
    sess = exam_engine.get_session(uid)
    if not sess:
        return
    mode = sess.get("mode", "practice")
    if mode == "practice":
        practice_handle_poll(uid, sess, ans)
    elif mode == "test":
        test_handle_poll(uid, sess, ans)
    elif mode == "conceptual":
        concept_handle_poll(uid, sess, ans)


