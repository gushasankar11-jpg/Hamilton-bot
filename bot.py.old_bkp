# ==========================================================
# /exam — mode picker
# ==========================================================
@bot.message_handler(commands=['exam'])
def cmd_exam(message):
    uid = message.chat.id
    ready, reason = profile_ready(uid)
    if not ready:
        send_setup_prompt(uid, reason)
        return
    p = load_profile(uid)
    if not p.get("selected_chapters"):
        bot.reply_to(message, "⚠️ No chapters selected. Use /select first.")
        return
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    markup.add("Practice", "Test", "Conceptual")
    msg = bot.send_message(uid,
        "🎯 Choose mode:\n\n"
        "📚 Practice — one at a time, instant feedback\n"
        "📝 Test — full paper with timer\n"
        "🧠 Conceptual — chapter coverage",
        reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, exam_mode)


def exam_mode(message):
    uid = message.chat.id
    t = (message.text or "").strip().lower()
    if t == "practice":
        pick_exam_for_mode(uid, "practice")
    elif t == "test":
        pick_exam_for_mode(uid, "test")
    elif t == "conceptual":
        pick_exam_for_mode(uid, "conceptual")
    else:
        bot.reply_to(message, "Tap Practice / Test / Conceptual.")


def pick_exam_for_mode(uid, mode):
    p = load_profile(uid)
    p["_exam_mode_chosen"] = mode
    p["_exam_chosen"] = None
    save_profile(uid, p)
    if len(p["exams"]) == 1:
        p["_exam_chosen"] = p["exams"][0]
        save_profile(uid, p)
        exam_after_pick(uid)
        return
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    for e in p["exams"]:
        markup.add(EXAM_NAMES[e])
    msg = bot.send_message(uid, "📚 Which exam?", reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, exam_pick_exam)


def exam_pick_exam(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip()
    chosen = None
    for e in p["exams"]:
        if EXAM_NAMES[e].lower() == t.lower():
            chosen = e
            break
    if not chosen:
        bot.reply_to(message, "Pick one shown.")
        return
    p["_exam_chosen"] = chosen
    save_profile(uid, p)
    exam_after_pick(uid)


def exam_after_pick(uid):
    p = load_profile(uid)
    mode = p.get("_exam_mode_chosen")
    if mode == "practice":
        practice_ask_chapter_mode(uid)
    elif mode == "test":
        test_ask_chapters(uid)
    elif mode == "conceptual":
        concept_pick_type(uid)


