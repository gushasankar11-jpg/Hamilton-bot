# ==========================================================
# TEST MODE
# ==========================================================
def test_ask_chapters(uid):
    p = load_profile(uid)
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    markup.add("My selected chapters", "Pick from full syllabus")
    msg = bot.send_message(uid, "📖 Chapters for this Test?",
                           reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, test_capture_mode)


def test_capture_mode(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip().lower()
    if "full" in t:
        p["_test_mode"] = "custom"
        p["_test_custom"] = {}
        p["_test_queue"] = ["Maths", "Physics", "Chemistry"]
        save_profile(uid, p)
        test_ask_next_subject(uid)
    elif "select" in t:
        p["_test_mode"] = "selected"
        p["_test_custom"] = None
        save_profile(uid, p)
        test_ask_papers(uid)
    else:
        bot.reply_to(message, "Tap one option.")


def test_ask_next_subject(uid):
    p = load_profile(uid)
    queue = p.get("_test_queue", [])
    if not queue:
        test_ask_papers(uid)
        return
    subj = queue[0]
    exam = p.get("_exam_chosen") or p.get("priority") or health.exam_of(p)
    data = health.load_subject_data(subj, exam)
    if not data:
        p["_test_queue"] = queue[1:]
        save_profile(uid, p)
        test_ask_next_subject(uid)
        return
    chapter_list = list(data.keys())
    numbered = "\n".join(str(i + 1) + ". " + c for i, c in enumerate(chapter_list))
    header = "📚 " + subj + " — " + str(len(chapter_list)) + " chapters\n\n"
    footer = "\n\nReply numbers or ALL. (" + str(len(queue)) + " subjects left)"
    full = header + numbered + footer
    if len(full) > 4000:
        safe_send(uid, header + "(list below)")
        safe_send(uid, numbered[:3900])
        msg = bot.send_message(uid, footer.strip())
        bot.register_next_step_handler(msg, test_capture_subject_chapters, subj, chapter_list)
    else:
        msg = bot.send_message(uid, full,
                               reply_markup=telebot.types.ReplyKeyboardRemove(),
                               parse_mode="Markdown")
        bot.register_next_step_handler(msg, test_capture_subject_chapters, subj, chapter_list)


def test_capture_subject_chapters(message, subj, chapter_list):
    uid = message.chat.id
    p = load_profile(uid)
    txt = (message.text or "").strip()
    if txt.upper() == "ALL":
        chosen = chapter_list
    else:
        try:
            idxs = [int(x.strip()) - 1 for x in txt.split(",") if x.strip()]
            chosen = [chapter_list[i] for i in idxs if 0 <= i < len(chapter_list)]
        except Exception:
            bot.reply_to(message, "Invalid.")
            return
    if not chosen:
        bot.reply_to(message, "No chapters.")
        return
    p.setdefault("_test_custom", {})
    p["_test_custom"][subj] = chosen
    p["_test_queue"] = p.get("_test_queue", [])[1:]
    save_profile(uid, p)
    safe_send(uid, subj + ": " + str(len(chosen)) + " chapters.")
    time.sleep(0.3)
    test_ask_next_subject(uid)


def test_ask_papers(uid):
    p = load_profile(uid)
    exam = p.get("_exam_chosen") or p.get("priority") or health.exam_of(p)
    if exam == "JEE_ADV":
        markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
        markup.add("One Paper", "Both Papers")
        msg = bot.send_message(uid,
            "📄 JEE Advanced — One Paper or Both Papers?",
            reply_markup=markup, parse_mode="Markdown")
        bot.register_next_step_handler(msg, test_capture_papers)
        return
    p["_test_papers"] = 1
    save_profile(uid, p)
    test_prestart(uid)


def test_capture_papers(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip().lower()
    if "both" in t:
        p["_test_papers"] = 2
    elif "one" in t:
        p["_test_papers"] = 1
    else:
        bot.reply_to(message, "Tap one.")
        return
    save_profile(uid, p)
    test_prestart(uid)


def test_prestart(uid):
    p = load_profile(uid)
    exam = p.get("_exam_chosen") or p.get("priority") or health.exam_of(p)
    mode = p.get("_test_mode", "selected")
    custom = p.get("_test_custom")
    papers = p.get("_test_papers", 1)
    if mode == "custom" and custom:
        allowed = custom
        subjects = [s for s in custom.keys() if custom[s]]
    else:
        sel = p.get("selected_chapters", {})
        allowed = {s: list(chs) for s, chs in sel.items() if chs}
        subjects = list(allowed.keys())
    for s in ["Maths", "Physics", "Chemistry"]:
        if s not in subjects:
            data = health.load_subject_data(s, exam)
            if data:
                allowed[s] = list(data.keys())
                subjects.append(s)
    if not subjects:
        bot.send_message(uid, "No subjects.")
        return
    p["_test_exam"] = exam
    p["_test_allowed"] = allowed
    p["_test_subject_list"] = subjects
    save_profile(uid, p)
    papers_txt = "1 paper" if papers == 1 else "2 papers"
    safe_send(uid,
        "📝 Test starting\n\nExam: " + EXAM_NAMES.get(exam, exam) +
        "\nSubjects: " + ", ".join(subjects) +
        "\nPapers: " + papers_txt +
        "\n\n⚠️ Timer runs silently. No feedback during test.\n"
        "⚠️ Use /stop to submit early.\n\nStarting in 5...",
        parse_mode="Markdown")
    for i in [5, 4, 3, 2, 1]:
        try:
            m = bot.send_message(uid, str(i))
            time.sleep(1)
            try:
                bot.delete_message(uid, m.message_id)
            except Exception:
                pass
        except Exception:
            break
    bot.send_message(uid, "🚀 Go!")
    test_start_paper(uid)


def test_start_paper(uid):
    p = load_profile(uid)
    exam = p.get("_test_exam")
    subjects = p.get("_test_subject_list", [])
    allowed = p.get("_test_allowed", {})
    papers = p.get("_test_papers", 1)
    paper_num = 1
    sess = exam_engine.get_session(uid)
    if sess and sess.get("mode") == "test":
        paper_num = sess.get("current_paper", 1)
    plan = exam_engine.build_test_plan(exam, subjects, allowed)
    if uid not in exam_engine.SESSIONS:
        exam_engine.new_test_session(uid, exam, subjects, allowed, papers=papers)
    sess = exam_engine.get_session(uid)
    sess["mode"] = "test"
    sess["exam"] = exam
    sess["subjects"] = subjects
    sess["allowed_chapters"] = allowed
    sess["papers"] = papers
    sess["current_paper"] = paper_num
    sess["plan"] = plan
    sess["plan_index"] = 0
    sess["questions_done"] = 0
    sess["correct"] = 0
    sess["wrong"] = 0
    sess["skipped"] = 0
    sess["total_time"] = 0
    sess["current_q"] = None
    sess["current_meta"] = None
    sess["current_started"] = None
    sess["answers_log"] = []
    sess["paper_scores"] = sess.get("paper_scores", [])
    PRELOAD_QUEUE[uid] = []
    dur = 180
    safe_send(uid,
        "📝 Paper " + str(paper_num) + " started\n"
        "Duration: " + str(dur) + " min\nQuestions: " + str(len(plan)),
        parse_mode="Markdown")
    timer_manager.start_test_timer(bot, uid, dur, on_time_up=test_paper_time_up)
    test_send_next(uid)


def test_paper_time_up(uid):
    safe_send(uid, "⏰ Time up. Submitting paper.")
    test_paper_finish(uid)


def test_send_next(uid):
    p = load_profile(uid)
    sess = exam_engine.get_session(uid)
    if not sess or sess.get("mode") != "test":
        return
    plan = sess.get("plan", [])
    idx = sess.get("plan_index", 0)
    if idx >= len(plan):
        test_paper_finish(uid)
        return
    exam = sess.get("exam")
    subj, ch, sub, q_type, diff = plan[idx]
    queue = PRELOAD_QUEUE.get(uid, [])
    q = queue.pop(0) if queue else None
    if not q:
        timer_manager.start_generating_timer(bot, uid, "question")
        q = exam_engine.generate_question(exam, subj, ch, sub,
                                           q_type=q_type.lower() if isinstance(q_type, str) else "mcq",
                                           difficulty=diff)
        timer_manager.stop_generating_timer(bot, uid)
        if not q:
            sess["plan_index"] = idx + 1
            test_send_next(uid)
            return
        q["_meta"] = {"subject": subj, "chapter": ch, "subtopic": sub}
        q["_plan_type"] = q_type
    sess["current_q"] = q
    sess["current_started"] = time.time()
    sess["current_meta"] = q["_meta"]
    sess["current_plan_type"] = q_type
    n_done = sess.get("questions_done", 0)
    n_total = len(plan)
    st = q.get("source_type", "AI-Generated")
    sd = q.get("source_detail", "")
    ideal = q.get("ideal_time_sec", 60)
    header = ("[" + EXAM_NAMES.get(exam, exam) + " | " + subj + " | Q" +
              str(n_done + 1) + "/" + str(n_total) + "]\n"
              "📌 " + st + (" · " + sd if sd else "") + "\n"
              "⚡ " + difficulty_str(diff) + " | ⏱️ " + str(ideal) + "s")
    full_q = header + "\n\n" + q["question"]
    svg_code = q.get("svg")
    if svg_code and SVG_ENABLED:
        path = svg_renderer.render_svg(svg_code, name="tq_" + str(uid))
        if path:
            safe_send_photo(uid, path)
            svg_renderer.cleanup_file(path)
    if q_type.lower() == "numerical" or q.get("correct_value") is not None:
        PENDING_NUMERICAL[uid] = {"q": q, "meta": q["_meta"],
                                   "started": time.time(), "is_test": True}
        safe_send(uid, "📝 *Numerical*\n\n" + full_q + "\n\n👉 Type the number and send.",
                  parse_mode="Markdown")
        return
    options = q.get("options", [])[:4]
    if len(options) < 2:
        sess["plan_index"] = idx + 1
        test_send_next(uid)
        return
    options_skip = options + ["🚪 Skip"]
    correct_idx = int(q.get("correct_index", 0))
    try:
        if len(full_q) <= 290:
            bot.send_poll(chat_id=uid, question=full_q[:300],
                          options=options_skip[:10], type="quiz",
                          correct_option_id=correct_idx,
                          explanation="Result in report.",
                          is_anonymous=False)
        else:
            safe_send(uid, "📝 " + full_q)
            time.sleep(0.3)
            bot.send_poll(chat_id=uid, question="👆 Tap your answer:",
                          options=options_skip[:10], type="quiz",
                          correct_option_id=correct_idx,
                          explanation="Result in report.",
                          is_anonymous=False)
    except Exception as e:
        safe_send(uid, "Retry... " + str(e))
        time.sleep(1)
        test_send_next(uid)


def test_paper_finish(uid):
    sess = exam_engine.get_session(uid)
    if not sess or sess.get("mode") != "test":
        return
    timer_manager.stop_test_timer(uid)
    paper = sess.get("current_paper", 1)
    papers = sess.get("papers", 1)
    p_correct = sess.get("correct", 0)
    p_wrong = sess.get("wrong", 0)
    p_skipped = sess.get("skipped", 0)
    p_log = sess.get("answers_log", [])
    score, max_score = exam_engine.test_paper_score(
        sess.get("exam"), p_correct, p_wrong, p_skipped)
    sess.setdefault("paper_scores", []).append({
        "paper": paper, "correct": p_correct, "wrong": p_wrong,
        "skipped": p_skipped, "score": score, "max": max_score,
        "log": list(p_log),
    })
    if paper < papers:
        markup = telebot.types.InlineKeyboardMarkup()
        markup.add(telebot.types.InlineKeyboardButton(
            "▶️ Continue to Paper 2", callback_data="test_paper2"))
        markup.add(telebot.types.InlineKeyboardButton(
            "⏹ End & Show Results", callback_data="test_end"))
        safe_send(uid,
            "🏁 Paper " + str(paper) + " submitted.\n"
            "Score: " + str(score) + " / " + str(max_score) + "\n"
            "✅ " + str(p_correct) + "  ❌ " + str(p_wrong) + "  🚪 " + str(p_skipped) +
            "\n\nTap Continue for Paper 2, or End.",
            parse_mode="Markdown", reply_markup=markup)
        return
    test_finish(uid)


def test_finish(uid):
    sess = exam_engine.get_session(uid)
    if not sess or sess.get("mode") != "test":
        return
    timer_manager.stop_test_timer(uid)
    exam = sess.get("exam", "JEE_MAIN")
    papers_data = sess.get("paper_scores", [])
    if not papers_data:
        p_correct = sess.get("correct", 0)
        p_wrong = sess.get("wrong", 0)
        p_skipped = sess.get("skipped", 0)
        log = sess.get("answers_log", [])
        score, max_score = exam_engine.test_paper_score(exam, p_correct, p_wrong, p_skipped)
        papers_data = [{"paper": 1, "correct": p_correct, "wrong": p_wrong,
                        "skipped": p_skipped, "score": score, "max": max_score, "log": log}]
    total_correct = sum(p["correct"] for p in papers_data)
    total_wrong = sum(p["wrong"] for p in papers_data)
    total_skipped = sum(p["skipped"] for p in papers_data)
    total_score = sum(p["score"] for p in papers_data)
    total_max = sum(p["max"] for p in papers_data)
    total_time_min = sess.get("total_time", 0) / 60
    lines = ["━━━━━━━━━━━━━━━━━━━━━━━━━━━",
             "   🏁 TEST COMPLETE",
             "━━━━━━━━━━━━━━━━━━━━━━━━━━━", "",
             "📘 " + EXAM_NAMES.get(exam, exam),
             "📝 Attempted: " + str(total_correct + total_wrong),
             "🚪 Skipped: " + str(total_skipped),
             "⏱️ Time: " + str(round(total_time_min, 1)) + " min", ""]
    for p in papers_data:
        lines.append("📄 Paper " + str(p["paper"]) + ": " + str(p["score"]) + " / " + str(p["max"]))
    lines.append("")
    lines.append("🏆 Overall: " + str(total_score) + " / " + str(total_max))
    lines.append("✅ " + str(total_correct) + "  ❌ " + str(total_wrong))
    safe_send(uid, "\n".join(lines), parse_mode="Markdown")
    exam_engine.end_session(uid)
    PRELOAD_QUEUE.pop(uid, None)
    PENDING_NUMERICAL.pop(uid, None)


@bot.callback_query_handler(func=lambda c: c.data == "test_paper2")
def cb_test_paper2(call):
    uid = call.message.chat.id
    try:
        bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except Exception:
        pass
    sess = exam_engine.get_session(uid)
    if not sess:
        return
    sess["current_paper"] = 2
    sess["correct"] = 0
    sess["wrong"] = 0
    sess["skipped"] = 0
    sess["questions_done"] = 0
    sess["total_time"] = 0
    sess["plan_index"] = 0
    sess["answers_log"] = []
    p = load_profile(uid)
    exam = sess.get("exam")
    plan = exam_engine.build_test_plan(exam, sess.get("subjects", []),
                                        sess.get("allowed_chapters", {}))
    sess["plan"] = plan
    PRELOAD_QUEUE[uid] = []
    safe_send(uid, "📄 Paper 2 started.")
    timer_manager.start_test_timer(bot, uid, 180, on_time_up=test_paper_time_up)
    test_send_next(uid)


@bot.callback_query_handler(func=lambda c: c.data == "test_end")
def cb_test_end(call):
    uid = call.message.chat.id
    try:
        bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except Exception:
        pass
    test_finish(uid)


@bot.callback_query_handler(func=lambda c: c.data == "test_stop")
def cb_test_stop(call):
    uid = call.message.chat.id
    try:
        bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except Exception:
        pass
    test_finish(uid)


# ==========================================================
# TEST POLL HANDLER (silent)
# ==========================================================
def test_handle_poll(uid, sess, ans):
    q = sess.get("current_q")
    if not q:
        return
    selected = ans.option_ids[0] if ans.option_ids else -1
    options = q.get("options", [])
    time_taken = time.time() - sess.get("current_started", time.time())
    meta = sess.get("current_meta", {})
    q_type = sess.get("current_plan_type", "mcq")
    if selected == len(options):
        sess["skipped"] = sess.get("skipped", 0) + 1
        correct = False
        user_repr = "SKIP"
    else:
        correct_idx = int(q.get("correct_index", 0))
        correct = (int(selected) == correct_idx)
        user_repr = chr(65 + int(selected)) if 0 <= selected <= 25 else "?"
        if correct:
            sess["correct"] = sess.get("correct", 0) + 1
        else:
            sess["wrong"] = sess.get("wrong", 0) + 1
    sess.setdefault("answers_log", []).append({
        "q": q, "meta": meta, "q_type": q_type,
        "user_answer": user_repr, "correct": correct,
        "time_taken": time_taken,
    })
    sess["questions_done"] = sess.get("questions_done", 0) + 1
    sess["total_time"] = sess.get("total_time", 0) + time_taken
    sess["plan_index"] = sess.get("plan_index", 0) + 1
    try:
        health.record_attempt(uid, meta.get("subject", ""), meta.get("chapter", ""),
                              meta.get("subtopic", ""), "", correct,
                              int(time_taken), int(q.get("ideal_time_sec", 60)),
                              difficulty=q.get("difficulty", "medium"))
    except Exception:
        pass
    sess["current_q"] = None
    test_send_next(uid)


# ==========================================================
# NUMERICAL HANDLER (used for both practice and test)
# ==========================================================
def handle_numerical(uid, text):
    pending = PENDING_NUMERICAL.pop(uid, None)
    if not pending:
        return
    timer_manager.stop_question_timer(bot, uid)
    q = pending["q"]
    meta = pending["meta"]
    time_taken = time.time() - pending["started"]
    is_test = pending.get("is_test", False)
    sess = exam_engine.get_session(uid)
    if not sess:
        return
    sess["total_time"] = sess.get("total_time", 0) + time_taken
    sess["questions_done"] = sess.get("questions_done", 0) + 1
    try:
        val = float(text.replace(",", "").replace(" ", "").strip())
    except Exception:
        PENDING_NUMERICAL[uid] = pending
        safe_send(uid, "Please send a valid number (e.g. 42 or 3.14).")
        return
    try:
        correct_val = float(q.get("correct_value", 0))
        correct = abs(val - correct_val) < 1e-6
    except Exception:
        correct = False
        correct_val = q.get("correct_value", "?")
    if correct:
        sess["correct"] = sess.get("correct", 0) + 1
    else:
        sess["wrong"] = sess.get("wrong", 0) + 1
    sess.setdefault("answers_log", []).append({
        "q": q, "meta": meta, "q_type": "numerical",
        "user_answer": text.strip(), "correct": correct,
        "time_taken": time_taken,
    })
    sess["plan_index"] = sess.get("plan_index", 0) + 1
    try:
        health.record_attempt(uid, meta.get("subject", ""), meta.get("chapter", ""),
                              meta.get("subtopic", ""), "", correct,
                              int(time_taken), int(q.get("ideal_time_sec", 90)),
                              difficulty=q.get("difficulty", "medium"))
    except Exception:
        pass
    if is_test:
        sess["current_q"] = None
        test_send_next(uid)
        return
    # Practice
    head = "✅ Correct!" if correct else "❌ Wrong — correct: " + str(correct_val)
    msg = (head + "\n\n⏱️ " + str(int(time_taken)) + "s\n\n"
           "📖 *Solution:*\n" + q.get("explanation", "") + "\n\n"
           "⚠️ *Traps:*\n" + "\n".join("• " + t for t in (q.get("traps") or ["(none)"])))
    safe_send(uid, msg + "\n\n/next /bookmark /stop",
              parse_mode="Markdown", reply_markup=practice_buttons())
    sess["last_q"] = q
    sess["last_meta"] = meta
    sess["current_q"] = None


def handle_test_numerical(uid, text):
    handle_numerical(uid, text)


# ==========================================================
# PRACTICE POLL HANDLER
# ==========================================================
def practice_handle_poll(uid, sess, ans):
    q = sess.get("current_q")
    if not q:
        return
    timer_manager.stop_question_timer(bot, uid)
    selected = ans.option_ids[0] if ans.option_ids else -1
    options = q.get("options", [])
    time_taken = time.time() - sess.get("current_started", time.time())
    sess["total_time"] = sess.get("total_time", 0) + time_taken
    sess["questions_done"] = sess.get("questions_done", 0) + 1
    meta = sess.get("current_meta", {})
    subj = meta.get("subject", "")
    chapter = meta.get("chapter", "")
    subtopic = meta.get("subtopic", "")
    if selected == len(options):
        sess["skipped"] = sess.get("skipped", 0) + 1
        try:
            before, after = rec_attempt(uid, subj, chapter, subtopic, False,
                                         time_taken, int(q.get("ideal_time_sec", 60)),
                                         q.get("difficulty", "medium"))
            dstr = delta_text(before, after)
        except Exception:
            dstr = ""
        msg = ("🚪 Skipped\n\n⏱️ " + str(int(time_taken)) + "s\n\n"
               "📖 " + q.get("explanation", "") + "\n" + dstr)
        safe_send(uid, msg + "\n\n/next /bookmark /stop",
                  parse_mode="Markdown", reply_markup=practice_buttons())
        sess["last_q"] = q
        sess["last_meta"] = meta
        sess["current_q"] = None
        return
    correct = (int(selected) == int(q.get("correct_index", -1)))
    if correct:
        sess["correct"] = sess.get("correct", 0) + 1
    else:
        sess["wrong"] = sess.get("wrong", 0) + 1
    try:
        before, after = rec_attempt(uid, subj, chapter, subtopic, correct,
                                     time_taken, int(q.get("ideal_time_sec", 60)),
                                     q.get("difficulty", "medium"))
        dstr = delta_text(before, after)
    except Exception:
        dstr = ""
    if correct:
        head = "✅ Correct!"
    else:
        ul = chr(65 + int(selected)) if 0 <= selected <= 25 else "?"
        cl = chr(65 + int(q.get("correct_index", 0)))
        head = "❌ Wrong — you chose " + ul + ", correct is " + cl
    msg = (head + "\n\n⏱️ " + str(int(time_taken)) + "s\n\n"
           "📖 *Solution:*\n" + q.get("explanation", "") + "\n\n"
           "⚠️ *Traps:*\n" + "\n".join("• " + t for t in (q.get("traps") or ["(none)"])) + "\n"
           + dstr)
    safe_send(uid, msg + "\n\n/next /bookmark /stop",
              parse_mode="Markdown", reply_markup=practice_buttons())
    sess["last_q"] = q
    sess["last_meta"] = meta
    sess["current_q"] = None


def rec_attempt(uid, subj, ch, sub, correct, time_taken, ideal, diff):
    p = load_profile(uid) or {}
    key = subj + "::" + ch + "::" + sub
    before = p.get("subtopic_stats", {}).get(key, {}).get("health")
    _, after = health.record_attempt(uid, subj, ch, sub, "", correct,
                                      int(time_taken), ideal, difficulty=diff)
    return before, after


def delta_text(before, after):
    if after is None:
        return ""
    if before is None:
        return "\n📊 Health: " + str(after) + "/100"
    d = round(after - before, 1)
    sign = "+" if d >= 0 else ""
    return "\n📊 Health: " + str(before) + " → " + str(after) + " (" + sign + str(d) + ")"


def practice_buttons():
    m = telebot.types.InlineKeyboardMarkup()
    m.add(telebot.types.InlineKeyboardButton("▶️ Continue", callback_data="prac_cont"),
          telebot.types.InlineKeyboardButton("🔖 Bookmark", callback_data="prac_bm"))
    m.add(telebot.types.InlineKeyboardButton("⏹ Stop", callback_data="prac_stop"))
    return m


def doubt_buttons():
    m = telebot.types.InlineKeyboardMarkup()
    m.add(telebot.types.InlineKeyboardButton("▶️ Continue", callback_data="prac_cont"),
          telebot.types.InlineKeyboardButton("⏹ Stop", callback_data="prac_stop"))
    return m


@bot.callback_query_handler(func=lambda c: c.data == "prac_cont")
def cb_prac_cont(call):
    uid = call.message.chat.id
    try:
        bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except Exception:
