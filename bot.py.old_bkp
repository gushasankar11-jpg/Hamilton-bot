@bot.message_handler(commands=['bookmark'])
def cmd_bookmark(message):
    uid = message.chat.id
    sess = exam_engine.get_session(uid)
    if not sess or not sess.get("last_q"):
        bot.reply_to(message, "No question to bookmark.")
        return
    bpath = os.path.join(BOOKMARK_DIR, str(uid) + ".json")
    bm = []
    if os.path.exists(bpath):
        try:
            with open(bpath) as f:
                bm = json.load(f)
        except Exception:
            bm = []
    bm.append({"question": sess["last_q"].get("question", ""),
               "meta": sess.get("last_meta", {})})
    with open(bpath, "w") as f:
        json.dump(bm, f, indent=2)
    bot.reply_to(message, "Bookmarked! " + str(len(bm)) + " total.")


@bot.message_handler(commands=['bookmarks'])
def cmd_bookmarks(message):
    uid = message.chat.id
    bpath = os.path.join(BOOKMARK_DIR, str(uid) + ".json")
    if not os.path.exists(bpath):
        bot.reply_to(message, "No bookmarks yet.")
        return
    with open(bpath) as f:
        bm = json.load(f)
    if not bm:
        bot.reply_to(message, "No bookmarks yet.")
        return
    lines = ["🔖 Bookmarks (" + str(len(bm)) + ")"]
    for i, b in enumerate(bm[:15], 1):
        lines.append(str(i) + ". " + b.get("question", "")[:60])
    safe_send(uid, "\n".join(lines))


@bot.message_handler(commands=['stop'])
def cmd_stop(message):
    do_stop(message.chat.id)


# ==========================================================
# CONCEPTUAL MODE
# ==========================================================
def concept_pick_type(uid):
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    markup.add("General Conceptual", "Exception Test")
    msg = bot.send_message(uid, "🧠 Which type?", reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, concept_capture_type)


def concept_capture_type(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip().lower()
    p["_concept_type"] = "exception" if "except" in t else "general"
    save_profile(uid, p)
    sel = p.get("selected_chapters", {})
    subjects = [s for s in ["Maths", "Physics", "Chemistry"] if sel.get(s)]
    if not subjects:
        subjects = health.available_subjects()
    if not subjects:
        bot.send_message(uid, "No subjects.")
        return
    if len(subjects) == 1:
        concept_ask_chapter(uid, subjects[0])
        return
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    for s in subjects:
        markup.add(s)
    msg = bot.send_message(uid, "Which subject?", reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, concept_capture_subject)


def concept_capture_subject(message):
    uid = message.chat.id
    subj = (message.text or "").strip().capitalize()
    if subj not in health.available_subjects():
        bot.reply_to(message, "Invalid.")
        return
    concept_ask_chapter(uid, subj)


def concept_ask_chapter(uid, subj):
    p = load_profile(uid)
    exam = health.exam_of(p) or "JEE_MAIN"
    sel_ch = p.get("selected_chapters", {}).get(subj, [])
    if sel_ch:
        chapter_list = sel_ch
    else:
        data = health.load_subject_data(subj, exam)
        if not data:
            bot.send_message(uid, "No data.")
            return
        chapter_list = list(data.keys())
    numbered = "\n".join(str(i + 1) + ". " + c for i, c in enumerate(chapter_list))
    header = "🧠 " + subj + " — pick chapter:\n\n" + numbered + "\n\nReply number."
    if len(header) > 4000:
        safe_send(uid, "🧠 " + subj + " chapters:")
        safe_send(uid, numbered[:3900])
        msg = bot.send_message(uid, "Reply number.")
    else:
        msg = bot.send_message(uid, header, parse_mode="Markdown")
    bot.register_next_step_handler(msg, concept_capture_chapter, subj, chapter_list)


def concept_capture_chapter(message, subj, chapter_list):
    uid = message.chat.id
    try:
        idx = int((message.text or "").strip()) - 1
        if idx < 0 or idx >= len(chapter_list):
            raise ValueError
    except ValueError:
        bot.reply_to(message, "Invalid.")
        return
    chapter = chapter_list[idx]
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    markup.add("40", "60", "80", "100")
    msg = bot.send_message(uid, "How many questions? (min 40)",
                           reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, concept_capture_count, subj, chapter)


def concept_capture_count(message, subj, chapter):
    uid = message.chat.id
    try:
        n = int((message.text or "").strip())
        if n < 40 or n > 100:
            raise ValueError
    except ValueError:
        bot.reply_to(message, "Send 40-100.")
        return
    p = load_profile(uid)
    ttype = p.get("_concept_type", "general")
    sess = exam_engine.start_conceptual_test(uid, subj, chapter, n, test_type=ttype)
    if not sess:
        bot.reply_to(message, "Could not start.")
        return
    sess["exam"] = p.get("priority") or health.exam_of(p) or "JEE_MAIN"
    PRELOAD_QUEUE[uid] = []
    safe_send(uid, "🧠 Conceptual Test (" + ttype + ") started\n"
              "Subject: " + subj + "\nChapter: " + chapter + "\nQuestions: " + str(n),
              parse_mode="Markdown")
    time.sleep(0.5)
    bot.send_message(uid, "🚀 Go!")
    concept_send_next(uid)


def concept_send_next(uid):
    sess = exam_engine.get_session(uid)
    if not sess or sess.get("mode") != "conceptual":
        return
    plan = sess.get("plan", [])
    idx = sess.get("index", 0)
    if idx >= len(plan):
        concept_finish(uid)
        return
    exam = sess.get("exam")
    subj = sess.get("subject")
    chapter = sess.get("chapter")
    sub = plan[idx]
    ttype = sess.get("test_type", "general")
    queue = PRELOAD_QUEUE.get(uid, [])
    q = queue.pop(0) if queue else None
    if not q:
        timer_manager.start_generating_timer(bot, uid, "question")
        diff = "hard" if ttype == "exception" else "medium"
        q = exam_engine.generate_question(exam, subj, chapter, sub,
                                           q_type="mcq", difficulty=diff)
        timer_manager.stop_generating_timer(bot, uid)
        if not q:
            sess["index"] = idx + 1
            concept_send_next(uid)
            return
        q["_meta"] = {"subject": subj, "chapter": chapter, "subtopic": sub}
    sess["current_q"] = q
    sess["current_started"] = time.time()
    sess["current_meta"] = q["_meta"]
    options = q.get("options", [])[:4]
    if len(options) < 2:
        sess["index"] = idx + 1
        concept_send_next(uid)
        return
    options_skip = options + ["🚪 Skip"]
    total = len(plan)
    header = ("[Conceptual | " + ttype + " | Q" + str(idx + 1) + "/" + str(total) + "]\n"
              "📖 " + subj + " → " + chapter)
    full_q = header + "\n\n" + q["question"]
    try:
        if len(full_q) <= 290:
            bot.send_poll(chat_id=uid, question=full_q[:300],
                          options=options_skip[:10], type="quiz",
                          correct_option_id=int(q.get("correct_index", 0)),
                          explanation="Result in report.",
                          is_anonymous=False)
        else:
            safe_send(uid, "📝 " + full_q)
            time.sleep(0.3)
            bot.send_poll(chat_id=uid, question="👆 Tap your answer:",
                          options=options_skip[:10], type="quiz",
                          correct_option_id=int(q.get("correct_index", 0)),
                          explanation="Result in report.",
                          is_anonymous=False)
    except Exception as e:
        safe_send(uid, "Retry... " + str(e))
        time.sleep(1)
        concept_send_next(uid)


def concept_handle_poll(uid, sess, ans):
    q = sess.get("current_q")
    if not q:
        return
    selected = ans.option_ids[0] if ans.option_ids else -1
    options = q.get("options", [])
    time_taken = time.time() - sess.get("current_started", time.time())
    meta = sess.get("current_meta", {})
    subtopic = meta.get("subtopic", "Unknown")
    if selected == len(options):
        correct = False
        sess["skipped"] = sess.get("skipped", 0) + 1
    else:
        correct = (int(selected) == int(q.get("correct_index", -1)))
        if correct:
            sess["correct"] = sess.get("correct", 0) + 1
        else:
            sess["wrong"] = sess.get("wrong", 0) + 1
    sess["questions_done"] = sess.get("questions_done", 0) + 1
    sess["total_time"] = sess.get("total_time", 0) + time_taken
    sess["index"] = sess.get("index", 0) + 1
    try:
        exam_engine.record_conceptual_attempt(uid, subtopic, correct)
    except Exception:
        pass
    try:
        health.record_attempt(uid, meta.get("subject", ""), meta.get("chapter", ""),
                              subtopic, "", correct, int(time_taken),
                              int(q.get("ideal_time_sec", 60)),
                              difficulty=q.get("difficulty", "medium"))
    except Exception:
        pass
    sess["current_q"] = None
    concept_send_next(uid)


def concept_finish(uid):
    sess = exam_engine.get_session(uid)
    if not sess:
        return
    safe_send(uid, exam_engine.conceptual_report(uid), parse_mode="Markdown")
    exam_engine.end_session(uid)
    PRELOAD_QUEUE.pop(uid, None)


@bot.callback_query_handler(func=lambda c: c.data == "concept_stop")
def cb_concept_stop(call):
    uid = call.message.chat.id
    try:
        bot.edit_message_reply_markup(uid, call.message.message_id, reply_markup=None)
    except Exception:
        pass
    concept_finish(uid)


