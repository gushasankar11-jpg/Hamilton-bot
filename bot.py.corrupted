@bot.message_handler(commands=['graph'])
def cmd_graph(message):
    uid = message.chat.id
    ready, reason = _profile_ready(uid)
    if not ready:
        _send_setup_prompt(uid, reason)
        return
    p = load_profile(uid)
    r = health.overall_health(p)
    if r["overall"] is None:
        bot.reply_to(message, "📭 No data yet. Try /exam first.")
        return

    subj_data = {s: d["health"] for s, d in r["subjects"].items()}
    svg = svg_templates.combined_progress(r["overall"], subj_data)
    path = svg_renderer.render_svg(svg, name=f"graph_{uid}")
    if path:
        safe_send_photo(uid, path, caption=f"Overall: {r['overall']}/100")
        svg_renderer.cleanup_file(path)
    else:
        safe_send(uid, f"📊 Overall: {r['overall']}/100")


# ==========================================================
# /notes
# ==========================================================
@bot.message_handler(commands=['notes'])
def cmd_notes(message):
    uid = message.chat.id
    ready, reason = _profile_ready(uid)
    if not ready:
        _send_setup_prompt(uid, reason)
        return
    p = load_profile(uid)
    sel = p.get("selected_chapters", {})
    subjects = [s for s in ["Maths", "Physics", "Chemistry"] if sel.get(s)]
    if not subjects:
        bot.send_message(uid, "⚠️ No chapters selected. Use /select first.")
        return
    if len(subjects) == 1:
        _notes_ask_chapter(uid, subjects[0])
        return
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    for s in subjects:
        markup.add(s)
    msg = bot.send_message(uid, "📝 Which subject?", reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, _notes_pick_subject)


def _notes_pick_subject(message):
    uid = message.chat.id
    p = load_profile(uid)
    subj = (message.text or "").strip().capitalize()
    if not p.get("selected_chapters", {}).get(subj):
        bot.reply_to(message, "❌ Invalid.")
        return
    _notes_ask_chapter(uid, subj)


def _notes_ask_chapter(uid, subj):
    p = load_profile(uid)
    ch_list = p.get("selected_chapters", {}).get(subj, [])
    numbered = "\n".join(f"{i+1}. {c}" for i, c in enumerate(ch_list))
    msg = bot.send_message(uid,
        f"📝 {subj} — pick chapter:\n\n{numbered}\n\nReply with number.",
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, _notes_capture_chapter, subj, ch_list)


def _notes_capture_chapter(message, subj, ch_list):
    uid = message.chat.id
    try:
        idx = int((message.text or "").strip()) - 1
        if idx < 0 or idx >= len(ch_list):
            raise ValueError
    except ValueError:
        bot.reply_to(message, "❌ Invalid.")
        return
    _generate_notes(uid, subj, ch_list[idx])


def _generate_notes(uid, subject, chapter):
    p = load_profile(uid)
    exam = health.exam_of(p) or "JEE_MAIN"
    data = health.load_subject_data(subject, exam)
    if not data or chapter not in data:
        safe_send(uid, "❌ No data for chapter.")
        return
    subs = data[chapter]
    concepts = []
    for sub, val in subs.items():
        cl = val.get("adv", []) if isinstance(val, dict) else val
        for c in cl:
            concepts.append(f"{sub} → {c}")

    timer_manager.start_generating_timer(bot, uid, "short notes")
    prompt = (
        f"Create COMPLETE short notes for chapter '{chapter}' in {subject} ({exam}).\n\n"
        "Cover ALL these topics:\n" +
        "\n".join(f"• {c}" for c in concepts[:50]) +
        "\n\nFormat:\n"
        "1. One-line concept per topic\n"
        "2. Key formula where relevant (Unicode, no LaTeX)\n"
        "3. 1-2 common traps per major topic\n"
        "4. Group related topics\n"
        "5. Where a diagram helps (ray diagrams, structures, graphs), "
        "include an SVG block fenced with ```svg ... ```\n\n"
        "Keep it thorough. Bold key terms. Friendly senior voice."
    )
    notes = ai_client.ask_hamilton(exam, prompt)
    timer_manager.stop_generating_timer(bot, uid)
    if not notes:
        safe_send(uid, "⚠️ Could not generate notes right now.")
        return

    # Extract SVG from notes if present
    svg, notes_clean = svg_renderer.detect_svg_in_text(notes)

    if svg:
        path = svg_renderer.render_svg(svg, name=f"notes_{uid}")
        if path:
            safe_send_photo(uid, path, caption=f"📝 Notes — {chapter}")
            svg_renderer.cleanup_file(path)

    header = f"📝 Notes — {chapter}\n_{subject} · {exam}_\n\n"
    footer = _countdown_footer(uid)
    safe_send(uid, header + notes_clean + footer, parse_mode="Markdown")


