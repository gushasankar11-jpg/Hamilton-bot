# ==========================================================
# /exam
# ==========================================================
@bot.message_handler(commands=['exam'])
def cmd_exam(message):
    uid = message.chat.id
    ready, reason = _profile_ready(uid)
    if not ready:
        _send_setup_prompt(uid, reason)
        return
    p = load_profile(uid)
    if not p.get("selected_chapters"):
        bot.reply_to(message,
            "⚠️ No chapters selected yet.\n\nType /select first.",
            parse_mode="Markdown")
        return

    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    markup.add("Practice", "Test", "Conceptual")
    msg = bot.send_message(uid,
        "🎯 Choose exam mode:\n\n"
        "📚 Practice — one question at a time, instant feedback\n"
        "📝 Test — full paper with timer, results at end\n"
        "🧠 Conceptual — chapter coverage test (min 40 Q)",
        reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, _exam_mode)


def _exam_mode(message):
    uid = message.chat.id
    t = (message.text or "").strip().lower()
    if t == "practice":
        _pick_exam_for_mode(uid, "practice")
    elif t == "test":
        _pick_exam_for_mode(uid, "test")
    elif t == "conceptual":
        _pick_exam_for_mode(uid, "conceptual")
    else:
        bot.reply_to(message, "Tap Practice / Test / Conceptual.")


def _pick_exam_for_mode(uid, mode):
    p = load_profile(uid)
    p["_exam_mode_chosen"] = mode
    p["_exam_chosen"] = None
    save_profile(uid, p)

    if len(p["exams"]) == 1:
        p["_exam_chosen"] = p["exams"][0]
        save_profile(uid, p)
        _exam_after_pick(uid)
        return

    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    for e in p["exams"]:
        markup.add(EXAM_NAMES[e])
    msg = bot.send_message(uid, "📚 Which exam?", reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, _exam_pick_exam)


def _exam_pick_exam(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip()
    chosen = next((e for e in p["exams"] if EXAM_NAMES[e].lower() == t.lower()), None)
    if not chosen:
        bot.reply_to(message, "❌ Pick one shown.")
        return
    p["_exam_chosen"] = chosen
    save_profile(uid, p)
    _exam_after_pick(uid)


def _exam_after_pick(uid):
    p = load_profile(uid)
    mode = p.get("_exam_mode_chosen")
    if mode == "practice":
        _ask_difficulty(uid)
    elif mode == "test":
        _test_ask_subjects(uid)
    elif mode == "conceptual":
        _concept_pick_type(uid)


# ==========================================================
# PRACTICE MODE
# ==========================================================
def _ask_difficulty(uid):
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    markup.add("Level 1", "Level 2", "Level 3")
    msg = bot.send_message(uid,
        "🎯 Difficulty level?\n\n"
        "• Level 1 — Basic concepts\n"
        "• Level 2 — Standard exam level\n"
        "• Level 3 — Real IIT depth",
        reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, _capture_difficulty)


def _capture_difficulty(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip().lower()
    if "1" in t: p["_practice_level"] = "easy"
    elif "2" in t: p["_practice_level"] = "medium"
    elif "3" in t: p["_practice_level"] = "hard"
    else:
        bot.reply_to(message, "Tap Level 1 / 2 / 3.")
        return
    save_profile(uid, p)
    _start_practice(uid)


def _pick_subject_for_practice(profile):
    selected = profile.get("selected_chapters", {})
    for s, chs in selected.items():
        if chs and s in health.available_subjects():
            return s
    subjects = health.available_subjects()
    return subjects[0] if subjects else None


def _start_practice(uid):
    p = load_profile(uid)
    exam = p.get("_exam_chosen") or p.get("priority") or health.exam_of(p)
    p["_practice_active"] = True
    p["_practice_exam"] = exam
    save_profile(uid, p)

    exam_engine.new_practice_session(uid)
    sess = exam_engine.get_session(uid)
    if sess:
        sess["exam"] = exam

    PRELOAD_QUEUE[uid] = []

    bot.send_message(uid,
        f"🚀 Practice started ({EXAM_NAMES.get(exam, exam)})\n\n"
        "Tap your answer. Use /next for next question, /stop to end.",
        reply_markup=telebot.types.ReplyKeyboardRemove(),
        parse_mode="Markdown")

    _preload_practice(uid, count=2)
    _send_next_practice(uid)


def _preload_practice(uid, count=2):
def _job():
        try:
            p = load_profile(uid)
            exam = p.get("_practice_exam")
            level = p.get("_practice_level", "medium")
            if not exam:
                return
            queue = PRELOAD_QUEUE.setdefault(uid, [])
            attempts = 0
            while len(queue) < count and attempts < 6:
                attempts += 1
                subj = _pick_subject_for_practice(p)
                if not subj:
                    return
                pick = exam_engine.pick_next_concept(p, subj, exam)
                if not pick:
                    return
                _, ch, sub, concept = pick
                q = exam_engine.generate_question(exam, subj, ch, sub,
                                                   q_type="mcq", difficulty=level)
                if q:
                    q["_meta"] = {"subject": subj, "chapter": ch,
                                  "subtopic": sub, "concept": concept}
                    queue.append(q)
                else:
                    time.sleep(1)
        except Exception:
            pass
    threading.Thread(target=_job, daemon=True).start()


def _send_next_practice(uid):
    p = load_profile(uid)
    exam = p.get("_practice_exam") or health.exam_of(p)
    level = p.get("_practice_level", "medium")
    if not exam:
        safe_send(uid, "❌ Exam not set.")
        return

    queue = PRELOAD_QUEUE.get(uid, [])
    q = queue.pop(0) if queue else None

    if not q:
        timer_manager.start_generating_timer(bot, uid, "question")
        subj = _pick_subject_for_practice(p)
        if not subj:
            timer_manager.stop_generating_timer(bot, uid)
            safe_send(uid, "❌ No chapters available.")
            return
        pick = exam_engine.pick_next_concept(p, subj, exam)
        if not pick:
            timer_manager.stop_generating_timer(bot, uid)
            safe_send(uid, "❌ No concepts available.")
            return
        _, ch, sub, concept = pick
        q_type = "mcq"
        if exam in ("JEE_MAIN", "JEE_ADV") and random.random() < 0.25:
            q_type = "numerical"
        q = exam_engine.generate_question(exam, subj, ch, sub,
                                           q_type=q_type, difficulty=level)
        timer_manager.stop_generating_timer(bot, uid)
        if not q:
            safe_send(uid, "🔄 Regenerating...")
            time.sleep(1)
            _send_next_practice(uid)
            return
        q["_meta"] = {"subject": subj, "chapter": ch,
                      "subtopic": sub, "concept": concept}

    meta = q["_meta"]
    sess = exam_engine.get_session(uid)
    if not sess:
        return
    sess["current_q"] = q
    sess["current_started"] = time.time()
    sess["current_meta"] = meta

    # Build header
    st = q.get("source_type", "AI-Generated")
    sd = q.get("source_detail", "")
    diff = q.get("difficulty", level)
    tag = f"{st}"
    if sd:
        tag += f" · {sd}"
    tag += f" · {difficulty_str(diff)}"

    header = f"[{EXAM_NAMES.get(exam, exam)}]\n📌 {tag}\n📖 {meta['chapter']} → {meta['subtopic']}"
    full_q = f"{header}\n\n{q['question']}"

    # Optional SVG from question
    svg_code = q.get("svg")
    if svg_code and SVG_ENABLED:
        path = svg_renderer.render_svg(svg_code, name=f"q_{uid}")
        if path:
            safe_send_photo(uid, path)
            svg_renderer.cleanup_file(path)

    # Numerical vs MCQ
    if q.get("correct_value") is not None:
        safe_send(uid, f"📝 Numerical Question\n\n{full_q}\n\nType your answer as a number.",
                  parse_mode="Markdown")
        PENDING_NUMERICAL[uid] = {"q": q, "meta": meta, "started": time.time()}
        timer_manager.start_question_timer(bot, uid)
        return

    options = q.get("options", [])[:4]
    if len(options) < 2:
        safe_send(uid, "🔄 Bad format, regenerating...")
        time.sleep(1)
        _send_next_practice(uid)
        return

    options_skip = options + ["🚪 Skip"]

    try:
        if len(full_q) <= 290:
            bot.send_poll(chat_id=uid, question=full_q[:300],
                          options=options_skip[:10], type="quiz",
                          correct_option_id=int(q.get("correct_index", 0)),
                          explanation="See solution below.", is_anonymous=False)
        else:
            safe_send(uid, f"📝 Question\n\n{full_q}")
            time.sleep(0.4)
            bot.send_poll(chat_id=uid, question="👆 Tap your answer:",
                          options=options_skip[:10], type="quiz",
                          correct_option_id=int(q.get("correct_index", 0)),
                          explanation="See below.", is_anonymous=False)
        timer_manager.start_question_timer(bot, uid)
        _preload_practice(uid, count=2)
    except Exception as e:
        safe_send(uid, f"🔄 Retry... {e}")
        time.sleep(1)
        _send_next_practice(uid)


def difficulty_str(d):
    return {"easy": "Easy", "medium": "Medium", "hard": "Hard"}.get(d, d.capitalize() if isinstance(d, str) else str(d))


# ==========================================================
# UNIFIED POLL HANDLER
# ==========================================================
@bot.poll_answer_handler()
def on_poll_answer(poll_answer):
    uid = poll_answer.user.id
    sess = exam_engine.get_session(uid)
    if not sess:
        return
    mode = sess.get("mode", "practice")
    if mode == "practice":
        _handle_practice_poll(uid, sess, poll_answer)
    elif mode == "test":
        _handle_test_poll(uid, sess, poll_answer)
    elif mode == "conceptual":
        _handle_conceptual_poll(uid, sess, poll_answer)


def _record_and_delta(uid, subject, chapter, subtopic, concept,
                       correct, time_taken, ideal_time):
    p = load_profile(uid) or {}
    before = _concept_health_lookup(p, subject, chapter, subtopic, concept)
    health.record_attempt(uid, subject, chapter, subtopic, concept,
                          correct, int(time_taken), ideal_time)
    p2 = load_profile(uid) or {}
    after = _concept_health_lookup(p2, subject, chapter, subtopic, concept)
    return before, after


def _concept_health_lookup(profile, subject, chapter, subtopic, concept):
    key = f"{subject}::{chapter}::{subtopic}"
    stat = profile.get("concept_stats", {}).get(key, {}).get(concept)
    if not stat or stat.get("attempts", 0) == 0:
        return None
    return health.concept_health(stat.get("attempts", 0), stat.get("correct", 0),
                                  stat.get("avg_time", 60), stat.get("ideal_time", 60))


def _health_delta_text(before, after):
    if after is None:
        return ""
    if before is None:
        return f"\n📊 Health: {after}/100 (first attempt)"
    delta = round(after - before, 1)
    sign = "+" if delta >= 0 else ""
    return f"\n📊 Health: {before} → {after} ({sign}{delta})"


def _handle_practice_poll(uid, sess, poll_answer):
    q = sess.get("current_q")
    if not q:
        return

    timer_manager.stop_question_timer(bot, uid)
    selected = poll_answer.option_ids[0] if poll_answer.option_ids else -1
    options = q.get("options", [])
    time_taken = time.time() - sess.get("current_started", time.time())
    sess["total_time"] = sess.get("total_time", 0) + time_taken
    sess["questions_done"] = sess.get("questions_done", 0) + 1

    meta = sess.get("current_meta", {})
    subj = meta.get("subject", "")
    chapter = meta.get("chapter", "")
    subtopic = meta.get("subtopic", "")
    concept = meta.get("concept", "")

    # Skip
    if selected == len(options):
        sess["skipped"] = sess.get("skipped", 0) + 1
        try:
            before, after = _record_and_delta(uid, subj, chapter, subtopic, concept,
                                               correct=False, time_taken=time_taken,
                                               ideal_time=int(q.get("ideal_time_sec", 60)))
            delta_str = _health_delta_text(before, after)
        except Exception:
            delta_str = ""
        msg = (
            f"🚪 Skipped\n\n"
            f"⏱️ Time: {int(time_taken)}s (ideal {q.get('ideal_time_sec', 60)}s)\n\n"
            f"📖 Solution:\n{q.get('explanation','(none)')}\n\n"
            f"⚠️ Traps:\n" + "\n".join(f"• {t}" for t in (q.get("traps") or ["(none)"])) + "\n\n"
            f"⚡ Shortcut: {q.get('shortcut','(none)')}\n"
            + delta_str
            + "\n\n━━━━━━━━━━━━━━━\n/next · /bookmark · /stop"
        )
        safe_send(uid, msg + _countdown_footer(uid))
        sess["last_q"] = q
        sess["last_meta"] = meta
        sess["current_q"] = None
        return

    correct = (int(selected) == int(q.get("correct_index", -1)))

    if correct:
        sess["correct"] = sess.get("correct", 0) + 1
    else:
        sess["wrong"] = sess.get("wrong", 0) + 1

    try:
        before, after = _record_and_delta(uid, subj, chapter, subtopic, concept,
                                           correct=correct, time_taken=time_taken,
                                           ideal_time=int(q.get("ideal_time_sec", 60)))
        delta_str = _health_delta_text(before, after)
        # SVG health delta
        if SVG_ENABLED and before is not None and after is not None:
            svg = svg_templates.health_delta_bar(concept or subtopic, before, after)
            path = svg_renderer.render_svg(svg, name=f"hd_{uid}_{int(time.time())}")
            if path:
                safe_send_photo(uid, path)
                svg_renderer.cleanup_file(path)
    except Exception:
        delta_str = ""

    if correct:
        head = "✅ Correct!"
    else:
        ul = chr(65 + int(selected)) if 0 <= selected <= 25 else "?"
        cl = chr(65 + int(q.get("correct_index", 0)))
        head = f"❌ Wrong — You chose {ul}, correct is {cl}"

    msg = (
        f"{head}\n\n"
        f"⏱️ Time: {int(time_taken)}s (ideal: {q.get('ideal_time_sec', 60)}s)\n\n"
        f"📖 Solution:\n{q.get('explanation','')}\n\n"
        f"⚠️ Traps:\n" + "\n".join(f"• {t}" for t in (q.get("traps") or ["(none)"])) + "\n\n"
        f"⚡ Shortcut: {q.get('shortcut','(none)')}\n"
        + delta_str
        + "\n\n━━━━━━━━━━━━━━━\n/next · /bookmark · /stop"
    )
    safe_send(uid, msg + _countdown_footer(uid))
    sess["last_q"] = q
    sess["last_meta"] = meta
    sess["current_q"] = None


def _handle_numerical_answer(uid, text):
    pending = PENDING_NUMERICAL.pop(uid, None)
    if not pending:
        return
    timer_manager.stop_question_timer(bot, uid)
    q = pending["q"]
    meta = pending["meta"]
    time_taken = time.time() - pending["started"]

    sess = exam_engine.get_session(uid)
    if not sess:
        return
    sess["total_time"] = sess.get("total_time", 0) + time_taken
    sess["questions_done"] = sess.get("questions_done", 0) + 1

    try:
        val = float(text.replace(",", "").replace(" ", "").strip())
    except Exception:
        PENDING_NUMERICAL[uid] = pending
        safe_send(uid, "⚠️ Please send a valid number.")
        return

    correct_val = q.get("correct_value", 0)
    try:
        correct = abs(val - float(correct_val)) < 1e-6
    except Exception:
        correct = False

    subj = meta.get("subject", "")
    chapter = meta.get("chapter", "")
    subtopic = meta.get("subtopic", "")
    concept = meta.get("concept", "")

    if correct:
        sess["correct"] = sess.get("correct", 0) + 1
    else:
        sess["wrong"] = sess.get("wrong", 0) + 1

    try:
        before, after = _record_and_delta(uid, subj, chapter, subtopic, concept,
                                           correct=correct, time_taken=time_taken,
                                           ideal_time=int(q.get("ideal_time_sec", 90)))
        delta_str = _health_delta_text(before, after)
    except Exception:
        delta_str = ""

    if correct:
        head = "✅ Correct!"
    else:
        head = f"❌ Wrong — correct value: {correct_val}"

    msg = (
        f"{head}\n\n"
        f"⏱️ Time: {int(time_taken)}s (ideal {q.get('ideal_time_sec', 90)}s)\n"
        f"Your answer: {text}\n\n"
        f"📖 Solution:\n{q.get('explanation','')}\n\n"
        f"⚠️ Traps:\n" + "\n".join(f"• {t}" for t in (q.get("traps") or ["(none)"])) + "\n\n"
        f"⚡ Shortcut: {q.get('shortcut','(none)')}\n"
        + delta_str
        + "\n\n━━━━━━━━━━━━━━━\n/next · /bookmark · /stop"
    )
    safe_send(uid, msg + _countdown_footer(uid))
    sess["last_q"] = q
    sess["last_meta"] = meta
    sess["current_q"] = None


@bot.message_handler(commands=['next'])
def cmd_next(message):
    uid = message.chat.id
    PENDING_NUMERICAL.pop(uid, None)
    timer_manager.stop_question_timer(bot, uid)
    if not exam_engine.get_session(uid):
        bot.reply_to(message, "Start with /exam first.")
        return
    _send_next_practice(uid)


@bot.message_handler(commands=['bookmark'])
def cmd_bookmark(message):
    uid = message.chat.id
    sess = exam_engine.get_session(uid)
    if not sess or not sess.get("last_q"):
        bot.reply_to(message, "No recent question to bookmark.")
        return
    bpath = os.path.join(BOOKMARK_DIR, f"{uid}.json")
    bm = []
    if os.path.exists(bpath):
        try:
            with open(bpath) as f:
                bm = json.load(f)
        except Exception:
            bm = []
    q = sess["last_q"]
    entry = {
        "timestamp": datetime.now().isoformat(),
        "subject": sess.get("last_meta", {}).get("subject", ""),
        "chapter": sess.get("last_meta", {}).get("chapter", ""),
        "question": q.get("question", ""),
        "options": q.get("options", []),
        "correct_index": q.get("correct_index"),
        "explanation": q.get("explanation", ""),
    }
    if any(b.get("question") == entry["question"] for b in bm):
        bot.reply_to(message, "🔖 Already bookmarked.")
        return
    bm.append(entry)
    with open(bpath, "w") as f:
        json.dump(bm, f, indent=2, ensure_ascii=False)
    bot.reply_to(message, f"🔖 Bookmarked! You now have {len(bm)} saved.", parse_mode="Markdown")


@bot.message_handler(commands=['bookmarks'])
def cmd_bookmarks(message):
    uid = message.chat.id
    bpath = os.path.join(BOOKMARK_DIR, f"{uid}.json")
    if not os.path.exists(bpath):
        bot.reply_to(message, "📭 No bookmarks yet.")
        return
    with open(bpath) as f:
        bm = json.load(f)
    if not bm:
        bot.reply_to(message, "📭 No bookmarks yet.")
        return
    lines = [f"🔖 Bookmarks ({len(bm)})\n"]
    for i, b in enumerate(bm[:15], 1):
        lines.append(f"{i}. [{b.get('subject','?')} · {b.get('chapter','?')[:25]}]")
        lines.append(f"   {b.get('question','')[:70]}...")
    safe_send(uid, "\n".join(lines))


@bot.message_handler(commands=['stop'])
def cmd_stop(message):
    uid = message.chat.id
    p = load_profile(uid)
    timer_manager.stop_all_timers(bot, uid)
    PENDING_NUMERICAL.pop(uid, None)
    sess = exam_engine.get_session(uid)
    if not sess:
        if p and p.get("_practice_active"):
            p["_practice_active"] = False
            save_profile(uid, p)
        bot.reply_to(message, "No active session.")
        return
    if p:
        p["_practice_active"] = False
        save_profile(uid, p)

    mode = sess.get("mode", "practice")
    if mode == "conceptual":
        safe_send(uid, exam_engine.conceptual_report(uid))
    elif mode == "test":
        _test_finish(uid)
        return
    else:
        safe_send(uid, exam_engine.session_report(uid))
    exam_engine.end_session(uid)
    PRELOAD_QUEUE.pop(uid, None)


# ==========================================================
# TEST MODE
# ==========================================================
def _test_ask_subjects(uid):
    p = load_profile(uid)
    sel = p.get("selected_chapters", {})
    available = [s for s in ["Maths", "Physics", "Chemistry"] if sel.get(s)]
    if not available:
        bot.send_message(uid, "⚠️ No chapters selected. Use /select first.")
        return

    p["_test_custom_chapters"] = None
    save_profile(uid, p)

    if len(available) == 1:
        p["_test_subjects"] = available
        save_profile(uid, p)
        _test_ask_chapters(uid)
        return

    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    for s in available:
        markup.add(s)
    markup.add("All subjects")
    msg = bot.send_message(uid,
        "📚 Which subject(s) for this test?",
        reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, _test_capture_subjects)


def _test_capture_subjects(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip().lower()
    sel_ch = p.get("selected_chapters", {})

    if "all" in t:
        subjects = [s for s in ["Maths", "Physics", "Chemistry"] if sel_ch.get(s)]
    elif "math" in t:
        subjects = ["Maths"]
    elif "phys" in t:
        subjects = ["Physics"]
    elif "chem" in t:
        subjects = ["Chemistry"]
    else:
        bot.reply_to(message, "Tap one of the options.")
        return

    subjects = [s for s in subjects if sel_ch.get(s)]
    if not subjects:
        bot.reply_to(message, "❌ No chapters in those subjects.")
        return

    p["_test_subjects"] = subjects
    save_profile(uid, p)
    _test_ask_chapters(uid)


def _test_ask_chapters(uid):
    p = load_profile(uid)
    subjects = p.get("_test_subjects", [])
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    markup.add("Selected chapters", "Full syllabus")
    msg = bot.send_message(uid,
        f"📖 Chapters to include?\n\n"
        f"Subjects: {', '.join(subjects)}\n\n"
        "• Selected chapters — your focus chapters\n"
        "• Full syllabus — pick from entire database",
        reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, _test_capture_chapter_mode)


def _test_capture_chapter_mode(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip().lower()
    if "full" in t:
        p["_test_chapter_mode"] = "full"
    elif "select" in t:
        p["_test_chapter_mode"] = "selected"
    else:
        bot.reply_to(message, "Tap one option.")
        return
    save_profile(uid, p)
    _test_ask_count(uid)


def _test_ask_count(uid):
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    markup.add("10", "25", "40", "75")
    msg = bot.send_message(uid,
        "📝 How many questions?\nReply 10, 25, 40, 75 or type a custom number (5–200).",
        reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, _test_capture_count)


def _test_capture_count(message):
    uid = message.chat.id
    p = load_profile(uid)
    try:
        n = int((message.text or "").strip())
        if n < 5 or n > 200:
            raise ValueError
    except ValueError:
        bot.reply_to(message, "Send a number between 5 and 200.")
        return
    p["_test_count"] = n
    save_profile(uid, p)
    _test_prestart(uid)


def _test_prestart(uid):
    p = load_profile(uid)
    exam = p.get("_exam_chosen") or p.get("priority") or health.exam_of(p)
    subjects = p.get("_test_subjects", [])
    count = p.get("_test_count", 10)
    chapter_mode = p.get("_test_chapter_mode", "selected")

    p["_test_exam"] = exam
    save_profile(uid, p)

    exam_engine.new_practice_session(uid)
    sess = exam_engine.SESSIONS.get(uid)
    if sess:
        sess["mode"] = "test"
        sess["exam"] = exam
        sess["subjects"] = subjects
        sess["target_count"] = count
        sess["chapter_mode"] = chapter_mode
        sess["correct"] = 0
        sess["wrong"] = 0
        sess["skipped"] = 0
        sess["questions_done"] = 0
        sess["total_time"] = 0
        sess["answers_log"] = []

    PRELOAD_QUEUE[uid] = []

    safe_send(uid,
        f"📝 Test starting\n\n"
        f"Exam: {EXAM_NAMES.get(exam, exam)}\n"
        f"Subjects: {', '.join(subjects)}\n"
        f"Questions: {count}\n"
        f"Chapters: {chapter_mode}\n\n"
        "⚠️ Timer runs silently. /stop to submit early.",
        parse_mode="Markdown")

    for i in [5, 4, 3, 2, 1]:
        try:
            m = bot.send_message(uid, f"⏱️ Starting in {i}...", parse_mode="Markdown")
            time.sleep(1)
            try:
                bot.delete_message(uid, m.message_id)
            except Exception:
                pass
        except Exception:
            break

    bot.send_message(uid, "🚀 Go!")

    total_min = max(10, count * 2)
    timer_manager.start_test_timer(bot, uid, total_min, on_time_up=_test_finish)

    _send_next_test_q(uid)

def _send_next_test_q(uid):
    p = load_profile(uid)
    sess = exam_engine.get_session(uid)
    if not sess or sess.get("mode") != "test":
        return
    if sess["questions_done"] >= sess.get("target_count", 10):
        _test_finish(uid)
        return

    subjects = sess.get("subjects", [])
    exam = sess.get("exam")
    level = p.get("_practice_level", "medium")
    subj = random.choice(subjects) if subjects else "Maths"

    q = PRELOAD_QUEUE.get(uid, []).pop(0) if PRELOAD_QUEUE.get(uid) else None

    if not q:
        timer_manager.start_generating_timer(bot, uid, "question")
        pick = exam_engine.pick_next_concept(p, subj, exam)
        if not pick:
            timer_manager.stop_generating_timer(bot, uid)
            _test_finish(uid)
            return
        _, ch, sub, concept = pick
        q = exam_engine.generate_question(exam, subj, ch, sub,
                                           q_type="mcq", difficulty=level)
        timer_manager.stop_generating_timer(bot, uid)

    if not q:
        tries = _bump_retry(uid)
        if tries >= 3:
            _reset_retry(uid)
            safe_send(uid, "⚠️ Could not generate question. Try /exam again.")
            _test_finish(uid)
            return
        safe_send(uid, f"🔄 Regenerating... ({tries}/3)")
        time.sleep(2)
        _send_next_test_q(uid)
        return
    _reset_retry(uid)

    q["_meta"] = {"subject": subj, "chapter": ch, "subtopic": sub, "concept": concept}
    meta = q["_meta"]

    sess["current_q"] = q
    sess["current_started"] = time.time()
    sess["current_meta"] = meta

    options = q.get("options", [])[:4]
    options_skip = options + ["🚪 Skip"]

    n_done = sess["questions_done"]
    n_total = sess["target_count"]
    header = f"[{EXAM_NAMES.get(exam, exam)} | Test | Q{n_done+1}/{n_total}]"
    full_q = f"{header}\n\n{q['question']}"

    try:
        if len(full_q) <= 290:
            bot.send_poll(chat_id=uid, question=full_q[:300],
                          options=options_skip[:10], type="quiz",
                          correct_option_id=int(q.get("correct_index", 0)),
                          explanation="Result in final report.",
                          is_anonymous=False)
        else:
            safe_send(uid, f"📝 {full_q}")
            time.sleep(0.4)
            bot.send_poll(chat_id=uid, question="👆 Tap your answer:",
                          options=options_skip[:10], type="quiz",
                          correct_option_id=int(q.get("correct_index", 0)),
                          explanation="Result in final report.",
                          is_anonymous=False)
    except Exception as e:
        safe_send(uid, f"🔄 Retry... {e}")
        time.sleep(1)
        _send_next_test_q(uid)

def _handle_test_poll(uid, sess, poll_answer):
    q = sess.get("current_q")
    if not q:
        return
    selected = poll_answer.option_ids[0] if poll_answer.option_ids else -1
    options = q.get("options", [])
    time_taken = time.time() - sess.get("current_started", time.time())
    meta = sess.get("current_meta", {})

    if selected == len(options):
        sess["skipped"] = sess.get("skipped", 0) + 1
        correct = False
    else:
        correct = (int(selected) == int(q.get("correct_index", -1)))
        if correct:
            sess["correct"] = sess.get("correct", 0) + 1
        else:
            sess["wrong"] = sess.get("wrong", 0) + 1

    sess["questions_done"] = sess.get("questions_done", 0) + 1
    sess["total_time"] = sess.get("total_time", 0) + time_taken
    sess.setdefault("answers_log", []).append({
        "q": q, "meta": meta, "correct": correct, "time": time_taken,
    })

    try:
        health.record_attempt(uid, meta.get("subject", ""), meta.get("chapter", ""),
                              meta.get("subtopic", ""), meta.get("concept", ""),
                              correct, int(time_taken), int(q.get("ideal_time_sec", 60)))
    except Exception:
        pass

    sess["current_q"] = None
    _send_next_test_q(uid)


def _test_finish(uid):
    sess = exam_engine.get_session(uid)
    if not sess or sess.get("mode") != "test":
        return
    timer_manager.stop_test_timer(uid)

    exam = sess.get("exam", "")
    total = sess.get("questions_done", 0)
    correct = sess.get("correct", 0)
    wrong = sess.get("wrong", 0)
    skipped = sess.get("skipped", 0)
    time_min = sess.get("total_time", 0) / 60
    total_q = sess.get("target_count", 10)

    lines = [
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━",
        "   🏁 TEST COMPLETE",
        "━━━━━━━━━━━━━━━━━━━━━━━━━━━", "",
        f"📘 Exam: {EXAM_NAMES.get(exam, exam)}",
        f"📝 Attempted: {total} / {total_q}",
        f"⏱️ Time: {round(time_min, 1)} min", "",
        f"✅ Correct: {correct}",
        f"❌ Wrong: {wrong}",
        f"🚪 Skipped: {skipped}",
    ]
    if total:
        lines.append(f"🎯 Accuracy: {round(100*correct/total, 1)}%")
    lines.append("")
    lines.append("Reply /health to see updated health.")
    safe_send(uid, "\n".join(lines))

    exam_engine.end_session(uid)
    PRELOAD_QUEUE.pop(uid, None)


# ==========================================================
# CONCEPTUAL MODE
# ==========================================================
def _concept_pick_type(uid):
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    markup.add("General Conceptual", "Exception Test")
    msg = bot.send_message(uid,
        "🧠 Which type?\n\n"
        "• General — full chapter theory + concepts\n"
        "• Exception — edge cases & anomalies",
        reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, _concept_capture_type)


def _concept_capture_type(message):
    uid = message.chat.id
    p = load_profile(uid)
    t = (message.text or "").strip().lower()
    if "except" in t:
        p["_concept_type"] = "exception"
    else:
        p["_concept_type"] = "general"
    save_profile(uid, p)

    # Which subject?
    sel = p.get("selected_chapters", {})
    subjects = [s for s in ["Maths", "Physics", "Chemistry"] if sel.get(s)]
    if not subjects:
        bot.send_message(uid, "⚠️ No chapters selected. Use /select first.")
        return
    if len(subjects) == 1:
        _concept_ask_chapter(uid, subjects[0])
        return
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    for s in subjects:
        markup.add(s)
    msg = bot.send_message(uid, "Which subject?", reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, _concept_capture_subject)


def _concept_capture_subject(message):
    uid = message.chat.id
    p = load_profile(uid)
    subj = (message.text or "").strip().capitalize()
    if not p.get("selected_chapters", {}).get(subj):
        bot.reply_to(message, "❌ No chapters in that subject.")
        return
    _concept_ask_chapter(uid, subj)


def _concept_ask_chapter(uid, subj):
    p = load_profile(uid)
    chapter_list = p.get("selected_chapters", {}).get(subj, [])
    if not chapter_list:
        bot.send_message(uid, f"⚠️ No chapters in {subj}.")
        return
    numbered = "\n".join(f"{i+1}. {c}" for i, c in enumerate(chapter_list))
    msg = bot.send_message(uid,
        f"🧠 {subj} — pick a chapter:\n\n{numbered}\n\nReply with the number.",
        parse_mode="Markdown")
    bot.register_next_step_handler(msg, _concept_capture_chapter, subj, chapter_list)


def _concept_capture_chapter(message, subj, chapter_list):
    uid = message.chat.id
    try:
        idx = int((message.text or "").strip()) - 1
        if idx < 0 or idx >= len(chapter_list):
            raise ValueError
    except ValueError:
        bot.reply_to(message, "❌ Invalid number.")
        return
    chapter = chapter_list[idx]
    markup = telebot.types.ReplyKeyboardMarkup(one_time_keyboard=True, resize_keyboard=True)
    markup.add("40", "60", "80", "100")
    msg = bot.send_message(uid,
        f"🧠 {chapter}\nHow many questions? (min 40)\nReply 40, 60, 80, or 100",
        reply_markup=markup, parse_mode="Markdown")
    bot.register_next_step_handler(msg, _concept_capture_count, subj, chapter)


def _concept_capture_count(message, subj, chapter):
    uid = message.chat.id
    try:
        n = int((message.text or "").strip())
        if n < 40 or n > 100:
            raise ValueError
    except ValueError:
        bot.reply_to(message, "Send a number between 40 and 100.")
        return
    p = load_profile(uid)
    ttype = p.get("_concept_type", "general")
    sess = exam_engine.start_conceptual_test(uid, subj, chapter, n, test_type=ttype)
    if not sess:
        bot.reply_to(message, "❌ Could not start.")
        return
    sess["exam"] = p.get("priority") or health.exam_of(p) or "JEE_MAIN"

    PRELOAD_QUEUE[uid] = []

    safe_send(uid,
        f"🧠 Conceptual Test ({ttype}) started\n\n"
        f"Subject: {subj}\nChapter: {chapter}\nQuestions: {n}\n\n"
        "⚠️ No feedback until end. /stop to submit early.",
        parse_mode="Markdown")
    bot.send_message(uid, "🚀 Go!")
    _send_next_concept_q(uid)


def _send_next_concept_q(uid):
    sess = exam_engine.get_session(uid)
    if not sess or sess.get("mode") != "conceptual":
        return
    if sess.get("index", 0) >= len(sess.get("plan", [])):
        _concept_finish(uid)
        return

    p = load_profile(uid)
    exam = sess.get("exam")
    subj = sess.get("subject")
    chapter = sess.get("chapter")
    plan = sess.get("plan", [])
    idx = sess.get("index", 0)

    q = PRELOAD_QUEUE.get(uid, []).pop(0) if PRELOAD_QUEUE.get(uid) else None
    if not q:
        sub, concept = plan[idx]
        timer_manager.start_generating_timer(bot, uid, "question")
        q = exam_engine.generate_question(exam, subj, chapter, sub,
                                           q_type="mcq", difficulty="medium")
        timer_manager.stop_generating_timer(bot, uid)
if not q:
    tries = _bump_retry(uid)
    if tries >= 3:
        _reset_retry(uid)
        safe_send(uid, "⚠️ Could not generate question. Try /exam again.")
        _concept_finish(uid)
        return
    safe_send(uid, f"🔄 Regenerating... ({tries}/3)")
    time.sleep(2)
    _send_next_concept_q(uid)
    return
_reset_retry(uid)

        q["_meta"] = {"subject": subj, "chapter": chapter, "subtopic": sub, "concept": concept}

    meta = q["_meta"]
    sess["current_q"] = q
    sess["current_started"] = time.time()
    sess["current_meta"] = meta

    options = q.get("options", [])[:4]
    options_skip = options + ["🚪 Skip"]

    total = len(plan)
    header = f"[Conceptual | Q{idx+1}/{total}]"
    full_q = f"{header}\n\n{q['question']}"

    try:
        if len(full_q) <= 290:
            bot.send_poll(chat_id=uid, question=full_q[:300],
                          options=options_skip[:10], type="quiz",
                          correct_option_id=int(q.get("correct_index", 0)),
                          explanation="Revealed in report.", is_anonymous=False)
        else:
            safe_send(uid, f"📝 {full_q}")
            time.sleep(0.4)
            bot.send_poll(chat_id=uid, question="👆 Tap your answer:",
                          options=options_skip[:10], type="quiz",
                          correct_option_id=int(q.get("correct_index", 0)),
                          explanation="Revealed in report.", is_anonymous=False)
    except Exception as e:
        safe_send(uid, f"🔄 Retry... {e}")
        time.sleep(1)
        _send_next_concept_q(uid)


def _handle_conceptual_poll(uid, sess, poll_answer):
    q = sess.get("current_q")
    if not q:
        return
    selected = poll_answer.option_ids[0] if poll_answer.option_ids else -1
    options = q.get("options", [])
    time_taken = time.time() - sess.get("current_started", time.time())
    meta = sess.get("current_meta", {})
    subtopic = meta.get("subtopic", "Unknown")

    if selected == len(options):
        correct = False
        sess["skipped"] = sess.get("skipped", 0) + 1
    else:
        correct = (int(selected) == int(q.get("correct_index", -1)))
        if correct:
            sess["correct"] = sess.get("correct", 0) + 1
        else:
            sess["wrong"] = sess.get("wrong", 0) + 1

    sess["questions_done"] = sess.get("questions_done", 0) + 1
    sess["total_time"] = sess.get("total_time", 0) + time_taken
    sess["index"] = sess.get("index", 0) + 1

    try:
        exam_engine.record_conceptual_attempt(uid, subtopic, correct)
    except Exception:
        pass
    try:
        health.record_attempt(uid, meta.get("subject", ""), meta.get("chapter", ""),
                              subtopic, meta.get("concept", ""),
                              correct, int(time_taken), int(q.get("ideal_time_sec", 60)))
    except Exception:
        pass

    sess["current_q"] = None
    _send_next_concept_q(uid)


def _concept_finish(uid):
    sess = exam_engine.get_session(uid)
    if not sess:
        return
    safe_send(uid, exam_engine.conceptual_report(uid))
    exam_engine.end_session(uid)
    PRELOAD_QUEUE.pop(uid, None)


