import matplotlib
matplotlib.use("Agg")   # no display, Termux-safe
import matplotlib.pyplot as plt
import numpy as np


def _md_to_pdf(md_path, pdf_path):
    """Convert markdown to PDF using pandoc. Returns True on success."""
    import subprocess
    try:
        r = subprocess.run(
            ["pandoc", md_path, "-o", pdf_path,
             "--pdf-engine=xelatex" if _has_xelatex() else None],
            capture_output=True, text=True, timeout=60,
        )
        if r.returncode == 0:
            return True
    except Exception as e:
        print(f"[PDF-pandoc] {e}")

    # Fallback: md2pdf python
    try:
        from md2pdf.core import md2pdf as _m
        with open(md_path) as f:
            content = f.read()
        _m(pdf_file_path=pdf_path, md_content=content)
        return True
    except Exception as e:
        print(f"[PDF-md2pdf] {e}")
    return False


def _has_xelatex():
    import shutil
    return shutil.which("xelatex") is not None


