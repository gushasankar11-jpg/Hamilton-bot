def get_session(uid): return SESSIONS.get(uid)
def end_session(uid): return SESSIONS.pop(uid, None)

def preload_for_user(uid, profile, exam, count=2):
    import threading
    def _job():
        queue = PRELOAD_QUEUE.setdefault(uid, [])
        while len(queue) < count:
            try:
                subj = "Maths"
                pick = pick_next_concept(profile, subj, exam)
                if not pick: return
                _, ch, sub, concept = pick
                q = generate_question(exam, subj, ch, sub, q_type="practice", uid=uid)
                if q:
                    q["_meta"] = {"subject": subj, "chapter": ch, "subtopic": sub, "concept": concept}
                    queue.append(q)
            except Exception:
                return
    threading.Thread(target=_job, daemon=True).start()

def pop_preloaded(uid):
    queue = PRELOAD_QUEUE.get(uid, [])
    return queue.pop(0) if queue else None
